SAB_DOMAIN=example.com
SAB_PHP_IMAGE=registry.example.com/sab-php@sha256:REPLACE
SAB_NGINX_IMAGE=registry.example.com/sab-nginx@sha256:REPLACE
SAB_REDIS_IMAGE=redis@sha256:REPLACE
SAB_BCV_IMAGE=registry.example.com/api-bcv@sha256:REPLACE
SAB_CENTRIFUGO_IMAGE=centrifugo/centrifugo@sha256:REPLACE
SAB_CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:REPLACE
SAB_RUNTIME_ENV_FILE=/etc/sab/runtime.env
SAB_DB_ADMIN_ENV_FILE=/etc/sab/db-admin.env
SAB_BCV_ENV_FILE=/etc/sab/bcv.env
SAB_REDIS_ENV_FILE=/etc/sab/redis.env
SAB_CENTRIFUGO_ENV_FILE=/etc/sab/centrifugo.env
SAB_SUPABASE_CA_FILE=/etc/sab/supabase-ca.crt
SAB_TUNNEL_TOKEN_FILE=/etc/sab/tunnel.token
SAB_ADMIN_PASSWORD_FILE=/etc/sab/admin-password
