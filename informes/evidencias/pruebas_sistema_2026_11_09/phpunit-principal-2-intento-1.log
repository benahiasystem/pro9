                                    >\n
                                    <b>{{ total_points_by_sale }}</b>\n
                                </p>\n
                            </div>\n
                        </div>\n
                    </template>\n
\n
                    <template #customer_address_id>\n
                        <div v-if="customer_addresses.length > 0 && itinerant_option_id == 1" class="form-group mb-0">\n
