                    Puntos por la compra: <span>{{ total_points_by_sale }}</span>\n
                </p>\n
            </div>\n
            <!-- sistema por puntos -->\n
        </div>\n
\n
        <div class="pos-checkout__items">\n
            <div v-for="(item, index) in form.items"\n
                 :key="index"\n
                 class="pos-checkout__item">\n
\n
                <span class="pos-checkout__item-qty">{{ item.quantity }}</span>\n
\n
                <div class="pos-checkout__item-body">\n
                    <p class="pos-checkout__item-name">{{ item.item.description }}</p>\n
\n
                    <!-- sistema por puntos -->\n
                    <el-checkbox v-if="isAvailablePointSystem(item)"\n
                                 v-model="item.item.exchanged_for_points"\n
                                 class="pos-checkout__item-flag"\n
                                 @change="changeRowExchangePoints(item, index)">\n
                        <b>{{ getExchangePointDescription(item) }}</b>\n
                    </el-checkbox>\n
                    <!-- sistema por puntos -->\n
\n
                    <!-- restriccion venta productos -->\n
                    <span v-if="isRestrictedForSale(item.item)"\n
                          class="pos-checkout__item-alert">\n
                        Restringido para venta en CPE\n
                    </span>\n
                    <!-- restriccion venta productos -->\n
                </div>\n
\n
                <span class="pos-checkout__item-total">\n
                    {{ currencyTypeActive.symbol }} {{ money(item.total) }}\n
                </span>\n
            </div>\n
        </div>\n
\n
        <footer class="pos-checkout__summary-footer">\n
            <div class="pos-checkout__totals">\n
                <div class="pos-checkout__total-row">\n
                    <span>Subtotal</span>\n
                    <span>{{ currencyTypeActive.symbol }} {{ money(form.total_taxed) }}</span>\n
                </div>\n
                <div class="pos-checkout__total-row" v-if="!isNrus">\n
                    <!-- ########## INICIO CAMBIO IGV A IVA -->\n
                    <span>IVA</span>\n
                    <!-- ######### FIN CAMBIO IGV A IVA -->\n
                    <span>{{ currencyTypeActive.symbol }} {{ money(form.total_igv) }}</span>\n
                </div>\n
                <!-- ########## INICIO SIN DETRACCIONES E ISC -->\n
                <!-- ######### FIN SIN DETRACCIONES E ISC -->\n
                <div class="pos-checkout__total-row" v-if="form.total_discount > 0">\n
                    <span>Descuento</span>\n
                    <span>- {{ currencyTypeActive.symbol }} {{ money(form.total_discount) }}</span>\n
                </div>\n
\n
\n
            </div>\n
\n
            <div class="pos-checkout__grand-total">\n
                <span>{{ fiscalPaymentsApplicable ? 'TOTAL VENTA (SIN IGTF)' : 'TOTAL' }}</span>\n
                <span>{{ currencyTypeActive.symbol }} {{ money(getTotal()) }}</span>\n
            </div>\n
\n
            <button :disabled="singleAmountInvalid || button_payment"\n
                    class="pos-checkout__confirm"\n
                    type="button"\n
                    @click="clickPayment">\n
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 8v-3a1 1 0 0 0 -1 -1h-10a2 2 0 0 0 0 4h12a1 1 0 0 1 1 1v3m0 4v3a1 1 0 0 1 -1 1h-12a2 2 0 0 1 -2 -2v-12" /><path d="M20 12v4h-4a2 2 0 0 1 0 -4h4" /></svg>\n
                <span>CONFIRMAR PAGO</span>\n
            </button>\n
\n
            <p v-if="button_payment"\n
               class="pos-checkout__confirm-hint">\n
                Falta cubrir {{ currencyTypeActive.symbol }} {{ differenceText }} para completar el pago.\n
            </p>\n
\n
            <button class="pos-checkout__cancel"\n
                    type="button"\n
                    @click="clickCancel">Cancelar compra\n
            </button>\n
        </footer>\n
    </aside>\n
\n
    <!-- ============ Formulario de cobro ============ -->\n
    <div class="col-lg-8 col-md-6 pos-checkout__main">\n
        <div class="pos-checkout__form">\n
\n
            <!-- Comprobante -->\n
            <section class="pos-card pos-card--voucher">\n
                <button class="pos-checkout__back"\n
                        type="button"\n
                        @click="back">\n
                    <i class="fas fa-angle-left"></i> Volver al carrito\n
                </button>\n
\n
                <div class="pos-card__voucher-fields">\n
                    <div class="pos-field">\n
                        <el-radio-group v-model="form.document_type_id"\n
                                        class="pos-doctype"\n
                                        size="small"\n
                                        @change="filterSeries">\n
                            <el-radio-button v-if="!isNrus" label="01">FACTURA</el-radio-button>\n
                            <!-- ########## INICIO CAMBIO SOLO FACTURAS Y NOTAS DE VENTA -->\n
                            <el-radio-button label="80">N. VENTA</el-radio-button>\n
                            <!-- ######### FIN CAMBIO SOLO FACTURAS Y NOTAS DE VENTA -->\n
                        </el-radio-group>\n
                    </div>\n
\n
                    <div class="pos-field pos-field--series">\n
                        <el-select v-model="form.series_id" placeholder="Serie">\n
                            <el-option v-for="option in series"\n
                                       :key="option.id"\n
                                       :label="option.number || '\u00a0'"\n
                                       :value="option.id">\n
                            </el-option>\n
                        </el-select>\n
                    </div>\n
                </div>\n
            </section>\n
\n
            <!-- Monto a cobrar -->\n
            <section class="pos-card pos-card--amount">\n
                <div class="pos-amount">\n
                    <span class="pos-amount__label">Monto a cobrar</span>\n
                    <span class="pos-amount__value">\n
                        {{ currencyTypeActive.symbol }} {{ money(getTotal()) }}\n
                    </span>\n
                </div>\n
\n
                <div class="pos-amount__grid">\n
                    <div class="pos-field">\n
                        <label class="pos-field__label">Con cuánto paga el cliente</label>\n
                        <div class="pos-money-input">\n
                            <span class="pos-money-input__symbol">{{ currencyTypeActive.symbol }}</span>\n
                            <el-input ref="enter_amount"\n
                                      inputmode="decimal"\n
                                      v-model="enter_amount"\n
                                      :disabled="singleAmountLocked"\n
                                      @input="enterAmount()"\n
                                      @focus="valueInputSelect"\n
                                      @click.native="valueInputSelect"\n
                                      @keyup.enter.native="keyupEnterAmount()">\n
                            </el-input>\n
                        </div>\n
\n
                        <div v-if="form.payments && form.payments.length === 1 && payment_method_types.some(method => String(method.id) === String(form.payments[0].payment_method_type_id) && method.collection_kind === 'cash')"\n
                             class="pos-quick-cash">\n
                            <button type="button"\n
                                    class="pos-quick-cash__btn pos-quick-cash__btn--exact"\n
                                    :disabled="singleAmountLocked"\n
                                    @click="setExactAmount()">Importe exacto\n
                            </button>\n
                            <!-- ########## INICIO CAMBIO QUITAR SELECCIÓN DE BILLETES -->\n
                            <!-- El importe se captura manualmente; no se muestran denominaciones rápidas. -->\n
                            <!-- ######### FIN CAMBIO QUITAR SELECCIÓN DE BILLETES -->\n
                        </div>\n
                        <small v-if="singleAmountLocked">Modifique los importes en Agregar pagos.</small>\n
                        <small v-if="singleAmountInvalid" class="text-danger">Indique un monto válido.</small>\n
                    </div>\n
\n
                    <div class="pos-change"\n
                         :class="isMissingAmount ? 'is-missing' : 'is-change'">\n
                        <span class="pos-change__label"\n
                              v-text="settlementDifferenceLabel"></span>\n
                        <span class="pos-change__value">\n
                            {{ settlementDifferenceDisplay }}\n
                        </span>\n
                    </div>\n
                </div>\n
            </section>\n
\n
            <!-- Descuento y propina -->\n
            <div class="pos-card-row"\n
                 v-if="(!disabledDiscountForSeller && enableGlobalDiscount) || enabledTipsPos">\n
\n
                <!-- Descuento -->\n
                <section class="pos-card pos-card--compact" v-if="!disabledDiscountForSeller && enableGlobalDiscount">\n
                    <div class="pos-card__head">\n
                        <h5 class="pos-card__title">Descuento</h5>\n
                        <el-switch v-model="enabled_discount"\n
                                   @change="changeEnabledDiscount"></el-switch>\n
                    </div>\n
\n
                    <div v-if="enabled_discount" class="pos-card__body">\n
                        <div class="pos-money-input pos-money-input--sm">\n
                            <span class="pos-money-input__symbol">\n
                                {{ is_discount_amount ? currencyTypeActive.symbol : '%' }}\n
                            </span>\n
                            <el-input v-model="discount_amount"\n
                                      inputmode="decimal"\n
                                      :disabled="!enabled_discount"\n
                                      @focus="valueInputSelect"\n
                                      @click.native="valueInputSelect"\n
                                      @change="inputDiscountAmount()">\n
                            </el-input>\n
                        </div>\n
\n
                        <div class="pos-card__foot">\n
                            <el-checkbox v-model="is_discount_amount"\n
                                         @change="changeTypeDiscount">\n
                                Aplicar como monto\n
                            </el-checkbox>\n
                            <el-tooltip class="item"\n
                                        v-if="global_discount_type && global_discount_type.description"\n
                                        :content="global_discount_type.description"\n
                                        effect="dark"\n
                                        placement="top">\n
                                <i class="fa fa-info-circle"></i>\n
                            </el-tooltip>\n
                        </div>\n
                    </div>\n
                    <p v-else class="pos-card__hint">Descuento global sobre el total.</p>\n
                </section>\n
\n
                <!-- Propinas -->\n
                <section class="pos-card pos-card--compact" v-if="enabledTipsPos">\n
                    <div class="pos-card__head">\n
                        <h5 class="pos-card__title">\n
                            Propina\n
                            <el-tooltip class="item"\n
                                        content="No se incluye en el comprobante ni en el importe a cobrar: sólo queda registrada para el reporte de propinas del empleado. Debe indicar el empleado y un monto mayor a 0."\n
                                        effect="dark"\n
                                        placement="top">\n
                                <i class="fa fa-info-circle"></i>\n
                            </el-tooltip>\n
                        </h5>\n
                    </div>\n
\n
                    <div class="pos-card__body pos-tip">\n
                        <el-input v-model="form.worker_full_name_tips"\n
                                  placeholder="Empleado"></el-input>\n
                        <div class="pos-money-input pos-money-input--sm pos-tip__amount">\n
                            <span class="pos-money-input__symbol">{{ currencyTypeActive.symbol }}</span>\n
                            <el-input v-model="form.total_tips"\n
                                      inputmode="decimal"\n
                                      @focus="valueInputSelect"\n
                                      @click.native="valueInputSelect"\n
                                      @input="sanitizeTipAmount"></el-input>\n
                        </div>\n
                    </div>\n
                </section>\n
            </div>\n
\n
            <!-- Pagos agregados -->\n
            <section class="pos-card">\n
                <div class="pos-card__head">\n
                    <div>\n
                        <h5 class="pos-card__title">Formas de pago</h5>\n
                        <p class="pos-card__hint">Divide el cobro en uno o varios métodos de pago.</p>\n
                    </div>\n
                    <button type="button"\n
                            class="pos-btn-outline"\n
                            @click="clickAddPayment()">\n
                        <i class="fas fa-plus"></i> Agregar\n
                    </button>\n
                </div>\n
\n
                <ul class="pos-payments">\n
                    <li v-for="(pay, index) in form.payments"\n
                        :key="index"\n
                        class="pos-payments__row">\n
                        <span class="pos-payments__idx">{{ index + 1 }}</span>\n
                        <span class="pos-payments__method">\n
                            {{ getDescriptionPaymentMethodType(pay.payment_method_type_id) }}\n
                        </span>\n
                        <span class="pos-payments__amount">\n
                            {{ currencyTypeActive.symbol }} {{ money(pay.payment) }}\n
                        </span>\n
                    </li>\n
                    <li v-if="form.payments.length === 0" class="pos-payments__empty">\n
                        Aún no se ha registrado ninguna forma de pago.\n
                    </li>\n
                </ul>\n
                <div v-if="fiscalPaymentsApplicable" class="mt-2">\n
                    <igtf-settings-status />\n
                    <igtf-quote-summary v-if="fiscalPaymentsApplicable" :quote="igtfQuote" :loading="igtfQuoteLoading" :error="igtfQuoteError" :currency="fiscalQuoteCurrency" />\n
                    <igtf-payment-fields :payment-methods="payment_method_types" v-for="(row, fiscalIndex) in form.payments" v-if="!isRecordedReceipt(row)" :key="'fiscal-' + fiscalIndex"\n
                        :payment="row" :igtf-enabled="igtfEnabled" :settings-version="igtfSettings.revision" :document-currency="form.currency_type_id"\n
                        :document-rate="form.exchange_rate_sale" :customer-id="form.customer_id" />\n
                </div>\n
                    <receipt-currency-fields v-for="(row, currencyIndex) in form.payments" v-if="form.document_type_id === '80' && !isRecordedReceipt(row)" :key="'currency-' + currencyIndex" :row="row" :methods="payment_method_types" :document-currency="form.currency_type_id" :document-rate="form.exchange_rate_sale" />\n
            </section>\n
\n
            <!-- Datos adicionales -->\n
            <section class="pos-card">\n
                <div class="pos-card__head">\n
                    <div>\n
                        <h5 class="pos-card__title">Datos adicionales</h5>\n
                        <p class="pos-card__hint">Información opcional que se imprime en el comprobante.</p>\n
                    </div>\n
                </div>\n
\n
                <div class="pos-card__body">\n
                    <div class="pos-field mb-2" v-if="configuration.enabled_sales_agents">\n
                        <search-agent @changeAgent="changeAgent"></search-agent>\n
                    </div>\n
\n
                    <div :class="{ 'pos-card__body--grid': businessTurns.active }">\n
                        <div class="pos-field">\n
                            <label class="pos-field__label">Datos de referencia</label>\n
                            <el-input v-model="form.reference_data" type="textarea"></el-input>\n
                        </div>\n
\n
                        <div class="pos-field pos-field--narrow" v-if="businessTurns.active">\n
                            <label class="pos-field__label">N° Placa</label>\n
                            <el-input v-model="form.plate_number" type="text"></el-input>\n
                        </div>\n
                    </div>\n
                </div>\n
            </section>\n
\n
        </div>\n
    </div>\n
\n
    <options-form\n
        :recordId="documentNewId"\n
        :resource="resource_options"\n
        :showDialog.sync="showDialogOptions"\n
        :statusDocument="statusDocument"\n
        :fromPos="true"\n
        :isPrint="isPrint"\n
    ></options-form>\n
\n
    <div v-if="form.document_type_id === '01'"><label>Condición de pago</label><el-select :value="form.payment_condition_id || '01'" @change="changeFiscalPaymentCondition"><el-option value="01" label="Contado"/><el-option value="02" label="Crédito (registrar sólo abonos reales)"/></el-select></div>\n
        <multiple-payment-form\n
        :payments="payments"\n
        :currency-type-id="form.currency_type_id" :exchange-rate-sale="form.exchange_rate_sale" :customer-id="form.customer_id" :payment-condition-id="form.payment_condition_id" :document-type-id="form.document_type_id"\n
        :showDialog.sync="showDialogMultiplePayment"\n
        :total="getTotal()"\n
        @add="addRow"\n
        @setPaymentMethod="setPaymentMethod"\n
\n
    ></multiple-payment-form>\n
\n
    <discount-permission-form\n
                :showDialog.sync="showDialogDiscountPermission"\n
                :totalDiscountPercentage ="totalDiscountPercentage"\n
                :sellers-discount-limit="configuration.sellers_discount_limit"\n
                @tokenValidated="tokenValidated"></discount-permission-form>\n
</div>\n
</template>\n
\n
<script>\n
import IgtfPaymentFields from "../../documents/partials/igtf_fields.vue"\n
import ReceiptCurrencyFields from "@components/ReceiptCurrencyFields.vue"\n
import {defaultCashForCurrency, checkoutValidationMessage} from '@helpers/payment-classification'\n
import fiscalPaymentSettings from "@mixins/fiscal-payment-settings"\n
// ######## INICIO MONEDA DEL MEDIO DE COBRO ########\n
import paymentSettlementSummary from "@mixins/payment-settlement-summary"\n
// ######## FIN MONEDA DEL MEDIO DE COBRO ########\n
import {withoutDraftRetentions, suggestRemainingPayment} from "@helpers/document-creation"\n
import {checkoutTotals} from '../../../../helpers/exact-commercial'\n
\n
import {documentTotals} from "../../../../helpers/exact-document"\n
import {exactAmount, exactSum} from "../../../../helpers/exchange-rate-math"\n
\n
import documentCreationMixin from "@mixins/document-creation"\n
import Keypress from 'vue-keypress'\n
\n
import SaleNotesOptions from '../../sale_notes/partials/options.vue'\n
import OptionsForm from './options.vue'\n
import MultiplePaymentForm from './multiple_payment.vue'\n
import {pointSystemFunctions} from '@mixins/functions'\n
import { buhoprinter } from '@mixins/buhoprinter'\n
import {calculateRowItem} from "@helpers/functions"\n
import DiscountPermissionForm from './discount_permission.vue'\n
import SearchAgent from '@components/SearchAgent.vue'\n
\n
\n
export default {\n
    components: {IgtfPaymentFields,ReceiptCurrencyFields,OptionsForm, SaleNotesOptions, MultiplePaymentForm, Keypress, DiscountPermissionForm, SearchAgent},\n
    mixins: [paymentSettlementSummary, fiscalPaymentSettings, documentCreationMixin,pointSystemFunctions, buhoprinter],\n
\n
    props: [\n
        'form',\n
        'customer',\n
        'currencyTypeActive',\n
        'exchangeRateSale',\n
        'is_payment',\n
        'companyEnvironment',\n
        'businessTurns',\n
        'isPrint',\n
        'globalDiscountTypeId',\n
        'enabledTipsPos',\n
        'hidePdfViewDocuments',\n
        'enabledPointSystem',\n
        'affectationIgvTypes',\n
        'percentageIgv',\n
        'configuration',\n
        'typeUser',\n
        'authUser',\n
        'customer_email',\n
        'config'\n
    ],\n
\n
    data() {\n
        return {\n
            enabled_discount: false,\n
            discount_amount: 0,\n
            loading_submit: false,\n
            showDialogOptions: false,\n
            showDialogMultiplePayment: false,\n
            showDialogSaleNote: false,\n
            documentNewId: null,\n
            saleNotesNewId: null,\n
            resource_options: null,\n
            resource: 'pos',\n
            resource_documents: 'documents',\n
            resource_payments: 'document_payments',\n
            amount: 0,\n
            enter_amount: 0,\n
            difference: 0,\n
            button_payment: false,\n
            input_item: '',\n
            form_payment: {},\n
            responseForm: {},\n
            series: [],\n
            all_series: [],\n
            cancel: false,\n
            form_cash_document: {},\n
            statusDocument: {},\n
            payment_method_types: [],\n
            payments: [],\n
            locked_submit: false,\n
            global_discount_types: [],\n
            global_discount_type: {},\n
            error_global_discount: false,\n
            is_discount_amount: false,\n
            payment_method_type_id: null,\n
            showDialogDiscountPermission: false,\n
            totalDiscountPercentage: 0,\n
        }\n
    },\n
    async created() {\n
\n
        await this.initLStoPayment()\n
        await this.getTables()\n
        this.initFormPayment()\n
        this.inputAmount()\n
        if (!Array.isArray(this.form.payments)) this.$set(this.form,'payments',[])\n
\n
\n
        this.$eventHub.$on('localSPayments', (payments) => {\n
            this.payments = payments\n
\n
        })\n
\n
        await this.setInitialAmount()\n
\n
        // La conexión directa con BuhoPrinter ya no es necesaria desde el frontend.\n
        // La impresión se centraliza vía PrintOrder → Redis → BuhoPrinter agent.\n
        // if (!this.isBuhoActive && this.isPrint) {\n
        //     this.startConnectionBuho();\n
        // }\n
\n
        if(this.enabledPointSystem)\n
        {\n
            await this.setCustomerAccumulatedPoints(this.form.customer_id, true)\n
            this.setTotalExchangePoints()\n
            this.checkUsedPointsByItem()\n
        }\n
        await this.getFormPosLocalStorage()\n
\n
\n
        this.setTotalPointsBySale(this.configuration)\n
\n
\n
    },\n
    mounted() {\n
        // console.log(this.currencyTypeActive)\n
    },\n
    computed: {\n
        isNrus: function () {\n
            return !!(this.config && this.config.is_nrus)\n
        },\n
        isGlobalDiscountBase: function () {\n
            return (this.globalDiscountTypeId === '02')\n
        },\n
        isInvoiceDocument()\n
        {\n
            return ['01', '03'].includes(this.form.document_type_id)\n
        },\n
        applyRestrictSaleItemsCpe()\n
        {\n
            if (this.configuration) return this.configuration.restrict_sale_items_cpe\n
\n
            return false\n
        },\n
        // ########### INICIO CAMBIO TURNOS POS VENEZUELA\n
        isBusinessTurnActive()\n
        {\n
            return Boolean(this.businessTurns && this.businessTurns.active)\n
        },\n
        // ########### FIN CAMBIO TURNOS POS VENEZUELA\n
        disabledDiscountForSeller()\n
        {\n
            return this.configuration.restrict_seller_discount && this.typeUser === 'seller';\n
        },\n
        enableGlobalDiscount()\n
        {\n
            return !!(this.configuration && this.configuration.enable_global_discount);\n
        },\n
        /**\n
         * El resumen muestra el bloque de retención (importe total + retención).\n
         */\n
\n
        /**\n
         * true cuando lo entregado por el cliente no cubre el total.\n
         */\n
        isMissingAmount()\n
        {\n
            return this.difference !== '-' && exactAmount(this.difference || '0').compare(0) < 0\n
        },\n
        /**\n
         * Vuelto/faltante siempre en positivo y con 2 decimales: la etiqueta\n
         * indica el signo.\n
         */\n
        differenceText()\n
        {\n
            if (this.difference === '-') return '0.00';\n
            const value=exactAmount(this.difference || '0');\n
            return (value.compare(0) < 0 ? exactAmount(0).minus(value) : value).final(2);\n
        },\n
    },\n
    methods:\n
    {\n
        changeFiscalPaymentCondition(value) {\n
            this.$set(this.form, 'payment_condition_id', value)\n
            if (value === '02') {\n
                this.form.payments = []\n
                this.payments = []\n
                this.amount = 0\n
                this.enter_amount = 0\n
            }\n
            this.setDifference(this.amount - this.getTotal())\n
            this.$eventHub.$emit('eventSetFormPosLocalStorage', this.form)\n
        },\n
        setDefaultDocumentType(from_function) {\n
            this.default_series_type = this.authUser.serie;\n
            this.default_document_type = this.authUser.document_id;\n
            // if (this.default_document_type === undefined) this.default_document_type = null;\n
            // if (this.default_series_type === undefined) this.default_series_type = null;\n
\n
            if (this.default_document_type !== null) {\n
                this.form.document_type_id = this.default_document_type;\n
                // ########## INICIO CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
                if (this.isNrus && this.form.document_type_id === '01') {\n
                    this.form.document_type_id = '80';\n
                }\n
                // ######### FIN CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
                this.filterSeries()\n
                let alt = _.find(this.all_series, { id: this.default_series_type });\n
\n
                if (this.default_series_type !== null && alt !== undefined) {\n
                    this.form.series_id = this.default_series_type;\n
                }\n
            }\n
        },\n
        isRestrictedForSale(item)\n
        {\n
            return this.applyRestrictSaleItemsCpe && this.isInvoiceDocument && (item != undefined && item.restrict_sale_cpe)\n
        },\n
        changeAgent(agent_id)\n
        {\n
            this.form.agent_id = agent_id\n
        },\n
        // ########### INICIO CAMBIO DOCUMENTOS POS VENEZUELA\n
        selectDocumentType(documentTypeId)\n
        {\n
            this.form.document_type_id = documentTypeId\n
            this.filterSeries()\n
        },\n
        // ########### FIN CAMBIO DOCUMENTOS POS VENEZUELA\n
