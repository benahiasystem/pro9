                            :class="{ shift: isVisible }"\n
                            @click="toggleInformation"\n
                            :title="isVisible ? 'Cerrar Información Adicional' : 'Abrir Información Adicional'"\n
                            v-if="isVisible"\n
                        >\n
                            <span class="toggle-button-text">\n
                                {{\n
                                    isVisible\n
                                        ? "Cerrar Información Adicional"\n
                                        : "Abrir Información Adicional"\n
                                }}\n
                            </span>\n
                        </span> -->\n
\n
                        <div\n
                            class="additional-information px-4"\n
                            :class="{ show: isVisible }"\n
                        >\n
                            <h3 class="text-center">\n
                                Información Adicional\n
                            </h3>\n
\n
                            <div class="close-container">\n
                                <i class="el-icon el-icon-close"\n
                                    @click="toggleInformation">\n
                                </i>\n
                            </div>\n
                            <div class="w-100">\n
                                <div\n
                                    v-if="relocatedFields.length"\n
                                    class="mt-5 no-gutters w-100"\n
                                >\n
                                    <div\n
                                        v-for="rf in relocatedFields"\n
                                        :key="rf.key"\n
                                        class="col-12 field-pinnable"\n
                                    >\n
                                        <button v-if="editingLayout" type="button" class="pin-from-form-btn" @click.prevent="pinFromForm(rf.key)"><i class="el-icon-top"></i> Fijar</button>\n
                                        <remote-slot\n
                                            :source="pinnedBarInstance"\n
                                            :slot-name="rf.key"\n
                                            :slot-scope-data="{ field: rf.field, width: 12 }"\n
                                        />\n
                                    </div>\n
                                </div>\n
\n
                                <div class="mt-5 w-100">\n
                                    <div v-if="specialTaxRegimeAvailable || savedSpecialTaxRegime" class="col-12 py-2 switch-container">\n
                                        <div class="row no-gutters">\n
                                            <div class="col-10">Régimen especial de tributación</div>\n
                                            <div class="col-2 text-end">\n
                                                <el-switch v-model="specialTaxRegimeMode" :disabled="!specialTaxRegimeAvailable" @change="changeSpecialTaxRegimeMode" />\n
                                            </div>\n
                                        </div>\n
                                    </div>\n
                                    <div v-if="thirdPartyAvailable || originalThirdPartyInvoice" class="col-12 py-2 switch-container">\n
                                        <div class="row no-gutters">\n
                                            <div class="col-10">Factura por cuenta de terceros</div>\n
                                            <div class="col-2 text-end">\n
                                                <el-switch v-model="thirdPartyMode" :disabled="isUpdateDocument" @change="changeThirdPartyMode" />\n
                                            </div>\n
                                        </div>\n
                                    </div>\n
                                    <div class="col-12 switch-container">\n
                                        <div class="row no-gutters">\n
                                            <div class="col-10">\n
                                                ¿Es comprobante de\n
                                                contingencia?\n
                                            </div>\n
                                            <div class="col-2 text-end">\n
                                                <el-switch\n
                                                    v-model="is_contingency"\n
                                                    @change="\n
                                                        changeEstablishment\n
                                                    "\n
                                                ></el-switch>\n
                                            </div>\n
                                        </div>\n
                                    </div>\n
                                    <template v-if="!is_client">\n
                                        <div v-if="!prepayment_deduction" class="col-12 py-2 switch-container">\n
                                            <div class="row no-gutters">\n
                                                <div class="col-10">\n
                                                    ¿Es un pago anticipado?\n
                                                </div>\n
                                                <div\n
                                                    class="col-2 text-end"\n
                                                >\n
                                                    <el-switch\n
                                                        v-model="\n
                                                            form.has_prepayment\n
                                                        "\n
                                                        @change="\n
                                                            changeHasPrepayment\n
                                                        "\n
                                                    ></el-switch>\n
                                                </div>\n
                                            </div>\n
                                            <div v-if="form.has_prepayment || prepayment_deduction" class="mt-3">\n
                                                <el-select\n
                                                    v-model="\n
                                                        form.affectation_type_prepayment\n
                                                    "\n
                                                    class="mb-2"\n
                                                    @change="\n
                                                        changeAffectationTypePrepayment\n
                                                    "\n
                                                >\n
                                                    <el-option\n
                                                        :key="10"\n
                                                        :value="10"\n
                                                        label="Gravado"\n
                                                    ></el-option>\n
                                                    <el-option\n
                                                        :key="20"\n
                                                        :value="20"\n
                                                        label="Exonerado"\n
                                                    ></el-option>\n
                                                    <el-option\n
                                                        :key="30"\n
                                                        :value="30"\n
                                                        label="Inafecto"\n
                                                    ></el-option>\n
                                                </el-select>\n
                                            </div>\n
