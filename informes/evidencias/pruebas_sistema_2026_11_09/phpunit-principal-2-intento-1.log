import ConsignedForm from './partials/consigned.vue';\n
import CustomFieldsRenderer from '@viewsModuleCustomField/custom_fields/custom_field_renderer.vue'\n
import DocumentFormPinnedBar from './_document_pinned_bar.vue';\n
