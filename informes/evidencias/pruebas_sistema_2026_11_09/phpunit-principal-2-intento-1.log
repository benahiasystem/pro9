                        ? this.document_types[0].id\n
                        : null;\n
                this.form.operation_type_id =\n
                    this.operation_types.length > 0\n
                        ? this.operation_types[0].id\n
                        : null;\n
                this.form.seller_id = this.sellers.length > 0 ? this.idUser : null;\n
                this.affectation_igv_types = response.data.affectation_igv_types;\n
                // this.prepayment_documents = response.data.prepayment_documents;\n
                this.is_client = response.data.is_client;\n
                this.payment_destinations = response.data.payment_destinations\n
                this.paymentMethodsLoaded = true;\n
                restoreDeferredInvoiceCash(this);;\n
                this.payment_conditions = response.data.payment_conditions;\n
\n
                this.seller_class =\n
                    this.user == "admin" ? "col-lg-4 pb-2" : "col-lg-6 pb-2";\n
                this.global_discount_types = response.data.global_discount_types;\n
\n
                // this.default_document_type = response.data.document_id;\n
                // this.default_series_type = response.data.series_id;\n
                this.selectDocumentType();\n
                this.changeEstablishment();\n
                this.changeDateOfIssue();\n
                this.changeDocumentType();\n
                this.changeDestinationSale();\n
                this.setDefaultDocumentType();\n
                this.setConfigGlobalDiscountType();\n
                this.startConnectionQzTray();\n
                this.verifySelectedSeller();\n
            });\n
        },\n
\n
        searchNumber(data) {\n
            this.form.itinerant = {\n
                id: this.itinerant_option_id,\n
                description: this.option_address_itinerant.find(\n
                    item => item.id === this.itinerant_option_id\n
                ).description,\n
                address: {\n
                    address: data.address,\n
                    department_id: data.location_id[0],\n
                    province_id: data.location_id[1],\n
                    district_id: data.location_id[2],\n
                    country_id: "VE",\n
                    telephone: data.telephone\n
                }\n
            }\n
\n
            this.$message.success(\n
                'Se agrego la dirección del RIF: ' + this.ruc_itinerant\n
                );\n
\n
\n
        },\n
        changeItineratOption()\n
        {\n
            if (this.form.is_itinerant) {\n
                if (this.itinerant_option_id == 1) {\n
                    this.form.itinerant = {\n
                        id: this.itinerant_option_id,\n
                        description: this.option_address_itinerant.find(\n
                            item => item.id === this.itinerant_option_id\n
                        ).description,\n
                    }\n
                } else if (this.itinerant_option_id == 2) {\n
                    this.form.customer_address_id = null;\n
                }\n
\n
            } else {\n
                this.form.itinerant = null;\n
            }\n
        },\n
        toggleInformation() {\n
            this.isVisible = !this.isVisible;\n
        },\n
        handlePanelToggle(panelIndex) {\n
            if (this.activePanel === panelIndex) {\n
                this.activePanel = null; // Cierra el panel si ya está activo\n
            } else {\n
                this.activePanel = panelIndex; // Abre el panel seleccionado\n
            }\n
        },\n
        valueInputSelect(event) {\n
            event.target.select();\n
        },\n
        clickShowItemDetail(id) {\n
            // this.itemDetailId = id\n
            // this.showDialogItemDetail = true\n
            window.open(`/items/show-item-detail/${id}`);\n
        },\n
        changeDataTip(tip) {\n
            if (tip) {\n
                this.form.worker_full_name_tips = tip.worker_full_name_tips;\n
                this.form.total_tips = tip.total_tips;\n
            }\n
        },\n
        onSuccessUploadVoucher(response, file, fileList, index) {\n
            if (response.success) {\n
                this.form.payments[index].filename = response.data.filename;\n
                this.form.payments[index].temp_path = response.data.temp_path;\n
                this.form.payments[index].file_list = fileList;\n
            } else {\n
                this.cleanFileListUploadVoucher(index);\n
                this.$message.error(response.message || 'No se pudo cargar el archivo.');\n
            }\n
        },\n
        onUploadErrorVoucher(error, file, fileList, index) {\n
            this.cleanFileListUploadVoucher(index);\n
            this.$message.error(this.getPaymentFileErrorMessage(error));\n
        },\n
        getPaymentFileErrorMessage(error) {\n
            const data = error && error.response ? error.response.data : null;\n
\n
            if (typeof data === 'string' && data.trim()) {\n
                return data;\n
            }\n
\n
            if (data && data.message) {\n
                return data.message;\n
            }\n
\n
            if (error && error.message) {\n
                return error.message;\n
            }\n
\n
            return 'Ocurrió un error al procesar la solicitud.';\n
        },\n
        cleanFileListUploadVoucher(index) {\n
            this.form.payments[index].file_list = [];\n
        },\n
        handleRemoveUploadVoucher(file, fileList, index) {\n
            this.form.payments[index].filename = null;\n
            this.form.payments[index].temp_path = null;\n
            this.cleanFileListUploadVoucher(index);\n
        },\n
        ...mapActions(["loadConfiguration"]),\n
        /**\n
         * Cargar opciones de precio desde la API de price_labels activos\n
         */\n
        async loadPriceOptions() {\n
            try {\n
                const response = await this.$http.get('/price-labels/active');\n
                const labels = response.data.data || [];\n
\n
\n
                const mainLabel = (this.config && this.config.price1_label) ? this.config.price1_label : 'Precio principal';\n
                this.price_options = [\n
                    {\n
                        id: 1,\n
                        description: mainLabel,\n
                        price_label_id: null\n
                    }\n
                ];\n
\n
                // Agregar las etiquetas de precio desde la API\n
                labels.forEach(label => {\n
                    this.price_options.push({\n
                        id: `price_label_${label.id}`,\n
                        description: label.label,\n
                        price_label_id: label.id\n
                    });\n
                });\n
\n
                // Seleccionar el label marcado como default, o el primero como fallback\n
                const defaultLabel = labels.find(l => l.is_default);\n
                if (defaultLabel) {\n
                    this.selected_option_price = `price_label_${defaultLabel.id}`;\n
                } else if (this.price_options.length > 0) {\n
                    this.selected_option_price = this.price_options[0].id;\n
                }\n
            } catch (error) {\n
                console.error('Error al cargar price_options:', error);\n
                // Fallback a precio principal si falla la carga\n
                this.price_options = [\n
                    {\n
                        id: 1,\n
                        description: "Precio principal",\n
                        price_label_id: null\n
                    }\n
                ];\n
                this.selected_option_price = 1;\n
            }\n
        },\n
        initForm() {\n
            this.specialTaxRegimeMode = false;\n
            this.thirdPartySearchTerm = '';\n
            this.thirdPartyCreateInput = '';\n
            this.thirdPartyRecordId = null;\n
