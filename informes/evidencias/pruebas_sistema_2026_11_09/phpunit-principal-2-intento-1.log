        {\n
            this.form.items.forEach(row => {\n
                this.recalculateUsedPointsForExchange(row)\n
            })\n
        },\n
        isAvailablePointSystem(row)\n
        {\n
            return (this.enabledPointSystem && this.hasAccumulatedPoints() && row.item.exchange_points)\n
        },\n
        changeRowExchangePoints(row, index)\n
        {\n
            row.item.used_points_for_exchange = row.item.exchanged_for_points ? this.getUsedPoints(row) : null\n
            this.setTotalExchangePoints()\n
            this.changeRowFreeAffectationIgv(row, index)\n
        },\n
        async changeRowFreeAffectationIgv(row, index)\n
        {\n
            this.form.items[index].affectation_igv_type_id = (row.item.exchanged_for_points) ? '15' : this.form.items[index].item.original_affectation_igv_type_id\n
            this.form.items[index].affectation_igv_type = await _.find(this.affectationIgvTypes, {id: this.form.items[index].affectation_igv_type_id})\n
\n
            let new_row = await calculateRowItem(row, this.form.currency_type_id, this.form.exchange_rate_sale, this.percentageIgv)\n
            new_row['unit_type_id'] = row.unit_type_id\n
\n
            this.form.items[index] = new_row\n
            await this.reCalculateTotal()\n
        },\n
        handleFn113() {\n
            const code = this.form.document_type_id\n
            // ########## INICIO CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
            if (this.isNrus) {\n
                this.form.document_type_id = '80'\n
                this.filterSeries()\n
                return\n
            }\n
            this.form.document_type_id = code == '01' ? '80' : '01'\n
            // ######### FIN CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
\n
            this.filterSeries()\n
        },\n
        keyupEnterAmount() {\n
\n
            if (this.button_payment) {\n
                return this.$message.warning("El monto a pagar es menor al total")\n
            }\n
\n
            if (this.locked_submit) return;\n
\n
            this.clickPayment()\n
\n
        },\n
        /**\n
         * Formatea un importe para mostrarlo siempre con 2 decimales.\n
         */\n
        money(value) {\n
            try { return exactAmount(value || '0').final(2); } catch (_) { return '0.00'; }\n
        },\n
        /**\n
         * La propina sólo admite un importe numérico.\n
         */\n
        sanitizeTipAmount() {\n
            const raw = (this.form.total_tips === null || this.form.total_tips === undefined)\n
                ? ''\n
                : String(this.form.total_tips)\n
\n
            let clean = raw.replace(/[^\d.]/g, '')\n
            const parts = clean.split('.')\n
\n
            if (parts.length > 2) {\n
                clean = parts.shift() + '.' + parts.join('')\n
            }\n
\n
            if (clean !== raw) this.form.total_tips = clean\n
        },\n
        /**\n
         * Coloca en el campo de cobro el importe exacto de la venta.\n
         */\n
        setExactAmount() {\n
            if (this.singleAmountLocked) return\n
            this.enter_amount = this.getTotal()\n
            this.enterAmount()\n
        },\n
        async setInitialAmount() {\n
            const rows = this.form.payments || []\n
            this.enter_amount = rows.length ? exactSum(rows.map(row=>row.payment || '0')).decimal() : this.getTotal()\n
            if (rows.length) this.amount = this.enter_amount\n
            // this.form.payments = this.payments\n
            // this.$eventHub.$emit('eventSetFormPosLocalStorage', this.form)\n
            await this.$refs.enter_amount.$el.getElementsByTagName('input')[0].focus()\n
            await this.$refs.enter_amount.$el.getElementsByTagName('input')[0].select()\n
            // console.log(this.$refs.enter_amount.$el.getElementsByTagName('input')[0])\n
        },\n
        valueInputSelect(event) {\n
            const target = event && event.target\n
            if (!target) return\n
            const input = (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')\n
                ? target\n
                : (target.querySelector && target.querySelector('input'))\n
            if (!input || typeof input.select !== 'function') return\n
            this.$nextTick(() => input.select())\n
        },\n
        changeEnabledDiscount() {\n
\n
            if (!this.enabled_discount) {\n
\n
                this.discount_amount = 0\n
                this.deleteDiscountGlobal()\n
                this.reCalculateTotal()\n
\n
            }\n
\n
        },\n
        changeTypeDiscount() {\n
            this.inputDiscountAmount()\n
        },\n
        inputDiscountAmount() {\n
\n
            if (this.enabled_discount) {\n
\n
                if (this.discount_amount && !isNaN(this.discount_amount) && parseFloat(this.discount_amount) > 0) {\n
\n
                    if(this.is_discount_amount)\n
                    {\n
                        if (this.discount_amount >= this.form.total)\n
                            return this.$message.error("El monto de descuento debe ser menor al total de venta")\n
                    }\n
\n
                    this.deleteDiscountGlobal()\n
                    this.reCalculateTotal()\n
\n
                } else {\n
\n
                    // this.discount_amount = 0\n
                    // this.deleteDiscountGlobal()\n
                    this.reCalculateTotal()\n
\n
                }\n
\n
                // console.log(this.discount_amount)\n
            }\n
        },\n
        isExonerated() {\n
\n
            let not_exonerated = this.form.items.find((item) => {\n
                return item.affectation_igv_type_id != '20'\n
            })\n
\n
            return (not_exonerated) ? false : true\n
        },\n
        setConfigGlobalDiscountType()\n
        {\n
            this.global_discount_type = _.find(this.global_discount_types, { id : this.globalDiscountTypeId})\n
        },\n
