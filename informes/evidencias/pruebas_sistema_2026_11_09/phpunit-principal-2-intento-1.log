    <aside class="col-lg-4 col-md-6 pos-checkout__summary">\n
\n
        <header class="pos-checkout__summary-header">\n
            <span class="pos-checkout__summary-title">Resumen de la venta</span>\n
            <span class="pos-checkout__summary-count">\n
                {{ form.items.length }} {{ form.items.length === 1 ? 'producto' : 'productos' }}\n
            </span>\n
        </header>\n
\n
        <div class="pos-checkout__customer">\n
            <span class="pos-checkout__label">Cliente</span>\n
            <b class="pos-checkout__customer-name">{{ customer.description }}</b>\n
\n
            <!-- sistema por puntos -->\n
            <div v-if="enabledPointSystem" class="pos-checkout__points">\n
                <p class="pos-checkout__point-row">\n
                    Puntos acumulados: <span>{{ customer_accumulated_points }}</span>\n
                    <template v-if="hasExchangePoints()">\n
                        - <b class="text-danger">{{ total_exchange_points }}</b>\n
                        = <b>{{ calculate_customer_accumulated_points }}</b>\n
                    </template>\n
                </p>\n
                <p class="pos-checkout__point-row pos-checkout__point-row--success">\n
                    Puntos por la compra: <span>{{ total_points_by_sale }}</span>\n
                </p>\n
            </div>\n
            <!-- sistema por puntos -->\n
        </div>\n
\n
        <div class="pos-checkout__items">\n
            <div v-for="(item, index) in form.items"\n
                 :key="index"\n
                 class="pos-checkout__item">\n
\n
                <span class="pos-checkout__item-qty">{{ item.quantity }}</span>\n
\n
                <div class="pos-checkout__item-body">\n
                    <p class="pos-checkout__item-name">{{ item.item.description }}</p>\n
\n
                    <!-- sistema por puntos -->\n
                    <el-checkbox v-if="isAvailablePointSystem(item)"\n
                                 v-model="item.item.exchanged_for_points"\n
                                 class="pos-checkout__item-flag"\n
                                 @change="changeRowExchangePoints(item, index)">\n
                        <b>{{ getExchangePointDescription(item) }}</b>\n
                    </el-checkbox>\n
                    <!-- sistema por puntos -->\n
\n
                    <!-- restriccion venta productos -->\n
                    <span v-if="isRestrictedForSale(item.item)"\n
                          class="pos-checkout__item-alert">\n
                        Restringido para venta en CPE\n
                    </span>\n
                    <!-- restriccion venta productos -->\n
                </div>\n
\n
                <span class="pos-checkout__item-total">\n
                    {{ currencyTypeActive.symbol }} {{ money(item.total) }}\n
                </span>\n
            </div>\n
        </div>\n
\n
        <footer class="pos-checkout__summary-footer">\n
            <div class="pos-checkout__totals">\n
                <div class="pos-checkout__total-row">\n
                    <span>Subtotal</span>\n
                    <span>{{ currencyTypeActive.symbol }} {{ money(form.total_taxed) }}</span>\n
                </div>\n
                <div class="pos-checkout__total-row" v-if="!isNrus">\n
                    <!-- ########## INICIO CAMBIO IGV A IVA -->\n
                    <span>IVA</span>\n
                    <!-- ######### FIN CAMBIO IGV A IVA -->\n
                    <span>{{ currencyTypeActive.symbol }} {{ money(form.total_igv) }}</span>\n
                </div>\n
                <!-- ########## INICIO SIN DETRACCIONES E ISC -->\n
                <!-- ######### FIN SIN DETRACCIONES E ISC -->\n
                <div class="pos-checkout__total-row" v-if="form.total_discount > 0">\n
                    <span>Descuento</span>\n
                    <span>- {{ currencyTypeActive.symbol }} {{ money(form.total_discount) }}</span>\n
                </div>\n
\n
\n
            </div>\n
\n
            <div class="pos-checkout__grand-total">\n
                <span>{{ fiscalPaymentsApplicable ? 'TOTAL VENTA (SIN IGTF)' : 'TOTAL' }}</span>\n
                <span>{{ currencyTypeActive.symbol }} {{ money(getTotal()) }}</span>\n
            </div>\n
\n
            <button :disabled="singleAmountInvalid || button_payment"\n
                    class="pos-checkout__confirm"\n
                    type="button"\n
                    @click="clickPayment">\n
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 8v-3a1 1 0 0 0 -1 -1h-10a2 2 0 0 0 0 4h12a1 1 0 0 1 1 1v3m0 4v3a1 1 0 0 1 -1 1h-12a2 2 0 0 1 -2 -2v-12" /><path d="M20 12v4h-4a2 2 0 0 1 0 -4h4" /></svg>\n
                <span>CONFIRMAR PAGO</span>\n
            </button>\n
\n
            <p v-if="button_payment"\n
               class="pos-checkout__confirm-hint">\n
                Falta cubrir {{ currencyTypeActive.symbol }} {{ differenceText }} para completar el pago.\n
            </p>\n
\n
            <button class="pos-checkout__cancel"\n
                    type="button"\n
                    @click="clickCancel">Cancelar compra\n
            </button>\n
        </footer>\n
    </aside>\n
\n
    <!-- ============ Formulario de cobro ============ -->\n
    <div class="col-lg-8 col-md-6 pos-checkout__main">\n
        <div class="pos-checkout__form">\n
\n
            <!-- Comprobante -->\n
            <section class="pos-card pos-card--voucher">\n
                <button class="pos-checkout__back"\n
                        type="button"\n
                        @click="back">\n
                    <i class="fas fa-angle-left"></i> Volver al carrito\n
                </button>\n
\n
                <div class="pos-card__voucher-fields">\n
                    <div class="pos-field">\n
                        <el-radio-group v-model="form.document_type_id"\n
                                        class="pos-doctype"\n
                                        size="small"\n
                                        @change="filterSeries">\n
                            <el-radio-button v-if="!isNrus" label="01">FACTURA</el-radio-button>\n
                            <!-- ########## INICIO CAMBIO SOLO FACTURAS Y NOTAS DE VENTA -->\n
                            <el-radio-button label="80">N. VENTA</el-radio-button>\n
                            <!-- ######### FIN CAMBIO SOLO FACTURAS Y NOTAS DE VENTA -->\n
                        </el-radio-group>\n
                    </div>\n
\n
                    <div class="pos-field pos-field--series">\n
                        <el-select v-model="form.series_id" placeholder="Serie">\n
                            <el-option v-for="option in series"\n
                                       :key="option.id"\n
                                       :label="option.number || '\u00a0'"\n
                                       :value="option.id">\n
                            </el-option>\n
                        </el-select>\n
                    </div>\n
                </div>\n
            </section>\n
\n
            <!-- Monto a cobrar -->\n
            <section class="pos-card pos-card--amount">\n
                <div class="pos-amount">\n
                    <span class="pos-amount__label">Monto a cobrar</span>\n
                    <span class="pos-amount__value">\n
                        {{ currencyTypeActive.symbol }} {{ money(getTotal()) }}\n
                    </span>\n
                </div>\n
\n
                <div class="pos-amount__grid">\n
                    <div class="pos-field">\n
                        <label class="pos-field__label">Con cuánto paga el cliente</label>\n
                        <div class="pos-money-input">\n
                            <span class="pos-money-input__symbol">{{ currencyTypeActive.symbol }}</span>\n
                            <el-input ref="enter_amount"\n
                                      inputmode="decimal"\n
                                      v-model="enter_amount"\n
                                      :disabled="singleAmountLocked"\n
                                      @input="enterAmount()"\n
                                      @focus="valueInputSelect"\n
                                      @click.native="valueInputSelect"\n
                                      @keyup.enter.native="keyupEnterAmount()">\n
                            </el-input>\n
                        </div>\n
\n
                        <div v-if="form.payments && form.payments.length === 1 && payment_method_types.some(method => String(method.id) === String(form.payments[0].payment_method_type_id) && method.collection_kind === 'cash')"\n
                             class="pos-quick-cash">\n
                            <button type="button"\n
                                    class="pos-quick-cash__btn pos-quick-cash__btn--exact"\n
                                    :disabled="singleAmountLocked"\n
                                    @click="setExactAmount()">Importe exacto\n
                            </button>\n
                            <!-- ########## INICIO CAMBIO QUITAR SELECCIÓN DE BILLETES -->\n
                            <!-- El importe se captura manualmente; no se muestran denominaciones rápidas. -->\n
                            <!-- ######### FIN CAMBIO QUITAR SELECCIÓN DE BILLETES -->\n
                        </div>\n
                        <small v-if="singleAmountLocked">Modifique los importes en Agregar pagos.</small>\n
                        <small v-if="singleAmountInvalid" class="text-danger">Indique un monto válido.</small>\n
                    </div>\n
\n
                    <div class="pos-change"\n
                         :class="isMissingAmount ? 'is-missing' : 'is-change'">\n
                        <span class="pos-change__label"\n
                              v-text="settlementDifferenceLabel"></span>\n
                        <span class="pos-change__value">\n
                            {{ settlementDifferenceDisplay }}\n
                        </span>\n
                    </div>\n
                </div>\n
            </section>\n
\n
            <!-- Descuento y propina -->\n
            <div class="pos-card-row"\n
                 v-if="(!disabledDiscountForSeller && enableGlobalDiscount) || enabledTipsPos">\n
\n
                <!-- Descuento -->\n
                <section class="pos-card pos-card--compact" v-if="!disabledDiscountForSeller && enableGlobalDiscount">\n
                    <div class="pos-card__head">\n
                        <h5 class="pos-card__title">Descuento</h5>\n
                        <el-switch v-model="enabled_discount"\n
                                   @change="changeEnabledDiscount"></el-switch>\n
                    </div>\n
\n
                    <div v-if="enabled_discount" class="pos-card__body">\n
                        <div class="pos-money-input pos-money-input--sm">\n
                            <span class="pos-money-input__symbol">\n
                                {{ is_discount_amount ? currencyTypeActive.symbol : '%' }}\n
                            </span>\n
                            <el-input v-model="discount_amount"\n
                                      inputmode="decimal"\n
                                      :disabled="!enabled_discount"\n
                                      @focus="valueInputSelect"\n
                                      @click.native="valueInputSelect"\n
                                      @change="inputDiscountAmount()">\n
                            </el-input>\n
                        </div>\n
\n
                        <div class="pos-card__foot">\n
                            <el-checkbox v-model="is_discount_amount"\n
                                         @change="changeTypeDiscount">\n
                                Aplicar como monto\n
                            </el-checkbox>\n
                            <el-tooltip class="item"\n
                                        v-if="global_discount_type && global_discount_type.description"\n
                                        :content="global_discount_type.description"\n
                                        effect="dark"\n
                                        placement="top">\n
                                <i class="fa fa-info-circle"></i>\n
                            </el-tooltip>\n
                        </div>\n
                    </div>\n
                    <p v-else class="pos-card__hint">Descuento global sobre el total.</p>\n
                </section>\n
\n
                <!-- Propinas -->\n
                <section class="pos-card pos-card--compact" v-if="enabledTipsPos">\n
                    <div class="pos-card__head">\n
                        <h5 class="pos-card__title">\n
                            Propina\n
                            <el-tooltip class="item"\n
                                        content="No se incluye en el comprobante ni en el importe a cobrar: sólo queda registrada para el reporte de propinas del empleado. Debe indicar el empleado y un monto mayor a 0."\n
                                        effect="dark"\n
                                        placement="top">\n
                                <i class="fa fa-info-circle"></i>\n
                            </el-tooltip>\n
                        </h5>\n
                    </div>\n
\n
                    <div class="pos-card__body pos-tip">\n
                        <el-input v-model="form.worker_full_name_tips"\n
                                  placeholder="Empleado"></el-input>\n
                        <div class="pos-money-input pos-money-input--sm pos-tip__amount">\n
                            <span class="pos-money-input__symbol">{{ currencyTypeActive.symbol }}</span>\n
                            <el-input v-model="form.total_tips"\n
                                      inputmode="decimal"\n
                                      @focus="valueInputSelect"\n
                                      @click.native="valueInputSelect"\n
                                      @input="sanitizeTipAmount"></el-input>\n
                        </div>\n
                    </div>\n
                </section>\n
            </div>\n
\n
            <!-- Pagos agregados -->\n
            <section class="pos-card">\n
                <div class="pos-card__head">\n
                    <div>\n
                        <h5 class="pos-card__title">Formas de pago</h5>\n
                        <p class="pos-card__hint">Divide el cobro en uno o varios métodos de pago.</p>\n
                    </div>\n
                    <button type="button"\n
                            class="pos-btn-outline"\n
                            @click="clickAddPayment()">\n
                        <i class="fas fa-plus"></i> Agregar\n
                    </button>\n
                </div>\n
\n
                <ul class="pos-payments">\n
                    <li v-for="(pay, index) in form.payments"\n
                        :key="index"\n
                        class="pos-payments__row">\n
                        <span class="pos-payments__idx">{{ index + 1 }}</span>\n
                        <span class="pos-payments__method">\n
                            {{ getDescriptionPaymentMethodType(pay.payment_method_type_id) }}\n
                        </span>\n
                        <span class="pos-payments__amount">\n
                            {{ currencyTypeActive.symbol }} {{ money(pay.payment) }}\n
                        </span>\n
                    </li>\n
                    <li v-if="form.payments.length === 0" class="pos-payments__empty">\n
                        Aún no se ha registrado ninguna forma de pago.\n
                    </li>\n
                </ul>\n
                <div v-if="fiscalPaymentsApplicable" class="mt-2">\n
                    <igtf-settings-status />\n
                    <igtf-quote-summary v-if="fiscalPaymentsApplicable" :quote="igtfQuote" :loading="igtfQuoteLoading" :error="igtfQuoteError" :currency="fiscalQuoteCurrency" />\n
                    <igtf-payment-fields :payment-methods="payment_method_types" v-for="(row, fiscalIndex) in form.payments" v-if="!isRecordedReceipt(row)" :key="'fiscal-' + fiscalIndex"\n
                        :payment="row" :igtf-enabled="igtfEnabled" :settings-version="igtfSettings.revision" :document-currency="form.currency_type_id"\n
                        :document-rate="form.exchange_rate_sale" :customer-id="form.customer_id" />\n
                </div>\n
                    <receipt-currency-fields v-for="(row, currencyIndex) in form.payments" v-if="form.document_type_id === '80' && !isRecordedReceipt(row)" :key="'currency-' + currencyIndex" :row="row" :methods="payment_method_types" :document-currency="form.currency_type_id" :document-rate="form.exchange_rate_sale" />\n
            </section>\n
\n
            <!-- Datos adicionales -->\n
            <section class="pos-card">\n
                <div class="pos-card__head">\n
                    <div>\n
                        <h5 class="pos-card__title">Datos adicionales</h5>\n
                        <p class="pos-card__hint">Información opcional que se imprime en el comprobante.</p>\n
                    </div>\n
                </div>\n
\n
                <div class="pos-card__body">\n
                    <div class="pos-field mb-2" v-if="configuration.enabled_sales_agents">\n
                        <search-agent @changeAgent="changeAgent"></search-agent>\n
                    </div>\n
\n
                    <div :class="{ 'pos-card__body--grid': businessTurns.active }">\n
                        <div class="pos-field">\n
                            <label class="pos-field__label">Datos de referencia</label>\n
                            <el-input v-model="form.reference_data" type="textarea"></el-input>\n
                        </div>\n
\n
                        <div class="pos-field pos-field--narrow" v-if="businessTurns.active">\n
                            <label class="pos-field__label">N° Placa</label>\n
                            <el-input v-model="form.plate_number" type="text"></el-input>\n
                        </div>\n
                    </div>\n
                </div>\n
            </section>\n
\n
        </div>\n
    </div>\n
\n
    <options-form\n
        :recordId="documentNewId"\n
        :resource="resource_options"\n
        :showDialog.sync="showDialogOptions"\n
        :statusDocument="statusDocument"\n
        :fromPos="true"\n
        :isPrint="isPrint"\n
    ></options-form>\n
\n
    <div v-if="form.document_type_id === '01'"><label>Condición de pago</label><el-select :value="form.payment_condition_id || '01'" @change="changeFiscalPaymentCondition"><el-option value="01" label="Contado"/><el-option value="02" label="Crédito (registrar sólo abonos reales)"/></el-select></div>\n
        <multiple-payment-form\n
        :payments="payments"\n
        :currency-type-id="form.currency_type_id" :exchange-rate-sale="form.exchange_rate_sale" :customer-id="form.customer_id" :payment-condition-id="form.payment_condition_id" :document-type-id="form.document_type_id"\n
        :showDialog.sync="showDialogMultiplePayment"\n
        :total="getTotal()"\n
        @add="addRow"\n
        @setPaymentMethod="setPaymentMethod"\n
\n
    ></multiple-payment-form>\n
\n
    <discount-permission-form\n
                :showDialog.sync="showDialogDiscountPermission"\n
                :totalDiscountPercentage ="totalDiscountPercentage"\n
                :sellers-discount-limit="configuration.sellers_discount_limit"\n
                @tokenValidated="tokenValidated"></discount-permission-form>\n
</div>\n
</template>\n
\n
<script>\n
import IgtfPaymentFields from "../../documents/partials/igtf_fields.vue"\n
import ReceiptCurrencyFields from "@components/ReceiptCurrencyFields.vue"\n
import {defaultCashForCurrency, checkoutValidationMessage} from '@helpers/payment-classification'\n
import fiscalPaymentSettings from "@mixins/fiscal-payment-settings"\n
// ######## INICIO MONEDA DEL MEDIO DE COBRO ########\n
import paymentSettlementSummary from "@mixins/payment-settlement-summary"\n
// ######## FIN MONEDA DEL MEDIO DE COBRO ########\n
import {withoutDraftRetentions, suggestRemainingPayment} from "@helpers/document-creation"\n
import {checkoutTotals} from '../../../../helpers/exact-commercial'\n
\n
import {documentTotals} from "../../../../helpers/exact-document"\n
import {exactAmount, exactSum} from "../../../../helpers/exchange-rate-math"\n
\n
import documentCreationMixin from "@mixins/document-creation"\n
import Keypress from 'vue-keypress'\n
\n
import SaleNotesOptions from '../../sale_notes/partials/options.vue'\n
import OptionsForm from './options.vue'\n
import MultiplePaymentForm from './multiple_payment.vue'\n
import {pointSystemFunctions} from '@mixins/functions'\n
import { buhoprinter } from '@mixins/buhoprinter'\n
import {calculateRowItem} from "@helpers/functions"\n
import DiscountPermissionForm from './discount_permission.vue'\n
import SearchAgent from '@components/SearchAgent.vue'\n
\n
\n
export default {\n
    components: {IgtfPaymentFields,ReceiptCurrencyFields,OptionsForm, SaleNotesOptions, MultiplePaymentForm, Keypress, DiscountPermissionForm, SearchAgent},\n
    mixins: [paymentSettlementSummary, fiscalPaymentSettings, documentCreationMixin,pointSystemFunctions, buhoprinter],\n
\n
    props: [\n
        'form',\n
        'customer',\n
        'currencyTypeActive',\n
        'exchangeRateSale',\n
        'is_payment',\n
        'companyEnvironment',\n
        'businessTurns',\n
        'isPrint',\n
        'globalDiscountTypeId',\n
        'enabledTipsPos',\n
        'hidePdfViewDocuments',\n
        'enabledPointSystem',\n
        'affectationIgvTypes',\n
        'percentageIgv',\n
        'configuration',\n
        'typeUser',\n
        'authUser',\n
        'customer_email',\n
        'config'\n
    ],\n
\n
    data() {\n
        return {\n
            enabled_discount: false,\n
            discount_amount: 0,\n
            loading_submit: false,\n
            showDialogOptions: false,\n
            showDialogMultiplePayment: false,\n
            showDialogSaleNote: false,\n
            documentNewId: null,\n
            saleNotesNewId: null,\n
            resource_options: null,\n
            resource: 'pos',\n
            resource_documents: 'documents',\n
            resource_payments: 'document_payments',\n
            amount: 0,\n
            enter_amount: 0,\n
            difference: 0,\n
            button_payment: false,\n
            input_item: '',\n
            form_payment: {},\n
            responseForm: {},\n
            series: [],\n
            all_series: [],\n
            cancel: false,\n
            form_cash_document: {},\n
            statusDocument: {},\n
            payment_method_types: [],\n
            payments: [],\n
            locked_submit: false,\n
            global_discount_types: [],\n
            global_discount_type: {},\n
            error_global_discount: false,\n
            is_discount_amount: false,\n
            payment_method_type_id: null,\n
            showDialogDiscountPermission: false,\n
            totalDiscountPercentage: 0,\n
        }\n
    },\n
    async created() {\n
\n
        await this.initLStoPayment()\n
        await this.getTables()\n
        this.initFormPayment()\n
        this.inputAmount()\n
        if (!Array.isArray(this.form.payments)) this.$set(this.form,'payments',[])\n
\n
\n
        this.$eventHub.$on('localSPayments', (payments) => {\n
            this.payments = payments\n
\n
        })\n
\n
        await this.setInitialAmount()\n
\n
        // La conexión directa con BuhoPrinter ya no es necesaria desde el frontend.\n
        // La impresión se centraliza vía PrintOrder → Redis → BuhoPrinter agent.\n
        // if (!this.isBuhoActive && this.isPrint) {\n
        //     this.startConnectionBuho();\n
        // }\n
\n
        if(this.enabledPointSystem)\n
        {\n
            await this.setCustomerAccumulatedPoints(this.form.customer_id, true)\n
            this.setTotalExchangePoints()\n
            this.checkUsedPointsByItem()\n
        }\n
        await this.getFormPosLocalStorage()\n
\n
\n
        this.setTotalPointsBySale(this.configuration)\n
\n
\n
    },\n
    mounted() {\n
        // console.log(this.currencyTypeActive)\n
    },\n
    computed: {\n
        isNrus: function () {\n
            return !!(this.config && this.config.is_nrus)\n
        },\n
        isGlobalDiscountBase: function () {\n
            return (this.globalDiscountTypeId === '02')\n
        },\n
        isInvoiceDocument()\n
        {\n
            return ['01', '03'].includes(this.form.document_type_id)\n
        },\n
        applyRestrictSaleItemsCpe()\n
        {\n
            if (this.configuration) return this.configuration.restrict_sale_items_cpe\n
\n
            return false\n
        },\n
        // ########### INICIO CAMBIO TURNOS POS VENEZUELA\n
        isBusinessTurnActive()\n
        {\n
            return Boolean(this.businessTurns && this.businessTurns.active)\n
        },\n
        // ########### FIN CAMBIO TURNOS POS VENEZUELA\n
        disabledDiscountForSeller()\n
        {\n
            return this.configuration.restrict_seller_discount && this.typeUser === 'seller';\n
        },\n
        enableGlobalDiscount()\n
        {\n
            return !!(this.configuration && this.configuration.enable_global_discount);\n
        },\n
        /**\n
         * El resumen muestra el bloque de retención (importe total + retención).\n
         */\n
\n
        /**\n
         * true cuando lo entregado por el cliente no cubre el total.\n
         */\n
        isMissingAmount()\n
        {\n
            return this.difference !== '-' && exactAmount(this.difference || '0').compare(0) < 0\n
        },\n
        /**\n
         * Vuelto/faltante siempre en positivo y con 2 decimales: la etiqueta\n
         * indica el signo.\n
         */\n
        differenceText()\n
        {\n
            if (this.difference === '-') return '0.00';\n
            const value=exactAmount(this.difference || '0');\n
            return (value.compare(0) < 0 ? exactAmount(0).minus(value) : value).final(2);\n
        },\n
    },\n
    methods:\n
    {\n
        changeFiscalPaymentCondition(value) {\n
            this.$set(this.form, 'payment_condition_id', value)\n
            if (value === '02') {\n
                this.form.payments = []\n
                this.payments = []\n
                this.amount = 0\n
                this.enter_amount = 0\n
            }\n
            this.setDifference(this.amount - this.getTotal())\n
            this.$eventHub.$emit('eventSetFormPosLocalStorage', this.form)\n
        },\n
        setDefaultDocumentType(from_function) {\n
            this.default_series_type = this.authUser.serie;\n
            this.default_document_type = this.authUser.document_id;\n
            // if (this.default_document_type === undefined) this.default_document_type = null;\n
            // if (this.default_series_type === undefined) this.default_series_type = null;\n
\n
            if (this.default_document_type !== null) {\n
                this.form.document_type_id = this.default_document_type;\n
                // ########## INICIO CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
                if (this.isNrus && this.form.document_type_id === '01') {\n
                    this.form.document_type_id = '80';\n
                }\n
                // ######### FIN CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
                this.filterSeries()\n
                let alt = _.find(this.all_series, { id: this.default_series_type });\n
\n
                if (this.default_series_type !== null && alt !== undefined) {\n
                    this.form.series_id = this.default_series_type;\n
                }\n
            }\n
        },\n
        isRestrictedForSale(item)\n
        {\n
            return this.applyRestrictSaleItemsCpe && this.isInvoiceDocument && (item != undefined && item.restrict_sale_cpe)\n
        },\n
        changeAgent(agent_id)\n
        {\n
            this.form.agent_id = agent_id\n
        },\n
        // ########### INICIO CAMBIO DOCUMENTOS POS VENEZUELA\n
        selectDocumentType(documentTypeId)\n
        {\n
            this.form.document_type_id = documentTypeId\n
            this.filterSeries()\n
        },\n
        // ########### FIN CAMBIO DOCUMENTOS POS VENEZUELA\n
        checkUsedPointsByItem()\n
        {\n
            this.form.items.forEach(row => {\n
                this.recalculateUsedPointsForExchange(row)\n
            })\n
        },\n
        isAvailablePointSystem(row)\n
        {\n
            return (this.enabledPointSystem && this.hasAccumulatedPoints() && row.item.exchange_points)\n
        },\n
        changeRowExchangePoints(row, index)\n
        {\n
            row.item.used_points_for_exchange = row.item.exchanged_for_points ? this.getUsedPoints(row) : null\n
            this.setTotalExchangePoints()\n
            this.changeRowFreeAffectationIgv(row, index)\n
        },\n
        async changeRowFreeAffectationIgv(row, index)\n
        {\n
            this.form.items[index].affectation_igv_type_id = (row.item.exchanged_for_points) ? '15' : this.form.items[index].item.original_affectation_igv_type_id\n
            this.form.items[index].affectation_igv_type = await _.find(this.affectationIgvTypes, {id: this.form.items[index].affectation_igv_type_id})\n
\n
            let new_row = await calculateRowItem(row, this.form.currency_type_id, this.form.exchange_rate_sale, this.percentageIgv)\n
            new_row['unit_type_id'] = row.unit_type_id\n
\n
            this.form.items[index] = new_row\n
            await this.reCalculateTotal()\n
        },\n
        handleFn113() {\n
            const code = this.form.document_type_id\n
            // ########## INICIO CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
            if (this.isNrus) {\n
                this.form.document_type_id = '80'\n
                this.filterSeries()\n
                return\n
            }\n
            this.form.document_type_id = code == '01' ? '80' : '01'\n
            // ######### FIN CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
\n
            this.filterSeries()\n
        },\n
        keyupEnterAmount() {\n
\n
            if (this.button_payment) {\n
                return this.$message.warning("El monto a pagar es menor al total")\n
            }\n
\n
            if (this.locked_submit) return;\n
\n
            this.clickPayment()\n
\n
        },\n
        /**\n
         * Formatea un importe para mostrarlo siempre con 2 decimales.\n
         */\n
        money(value) {\n
            try { return exactAmount(value || '0').final(2); } catch (_) { return '0.00'; }\n
        },\n
        /**\n
         * La propina sólo admite un importe numérico.\n
         */\n
        sanitizeTipAmount() {\n
            const raw = (this.form.total_tips === null || this.form.total_tips === undefined)\n
                ? ''\n
                : String(this.form.total_tips)\n
\n
            let clean = raw.replace(/[^\d.]/g, '')\n
            const parts = clean.split('.')\n
\n
            if (parts.length > 2) {\n
                clean = parts.shift() + '.' + parts.join('')\n
            }\n
\n
            if (clean !== raw) this.form.total_tips = clean\n
        },\n
        /**\n
         * Coloca en el campo de cobro el importe exacto de la venta.\n
         */\n
        setExactAmount() {\n
            if (this.singleAmountLocked) return\n
            this.enter_amount = this.getTotal()\n
            this.enterAmount()\n
        },\n
        async setInitialAmount() {\n
            const rows = this.form.payments || []\n
            this.enter_amount = rows.length ? exactSum(rows.map(row=>row.payment || '0')).decimal() : this.getTotal()\n
            if (rows.length) this.amount = this.enter_amount\n
            // this.form.payments = this.payments\n
            // this.$eventHub.$emit('eventSetFormPosLocalStorage', this.form)\n
            await this.$refs.enter_amount.$el.getElementsByTagName('input')[0].focus()\n
            await this.$refs.enter_amount.$el.getElementsByTagName('input')[0].select()\n
            // console.log(this.$refs.enter_amount.$el.getElementsByTagName('input')[0])\n
        },\n
        valueInputSelect(event) {\n
            const target = event && event.target\n
            if (!target) return\n
            const input = (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')\n
                ? target\n
                : (target.querySelector && target.querySelector('input'))\n
            if (!input || typeof input.select !== 'function') return\n
            this.$nextTick(() => input.select())\n
        },\n
        changeEnabledDiscount() {\n
\n
            if (!this.enabled_discount) {\n
\n
                this.discount_amount = 0\n
                this.deleteDiscountGlobal()\n
                this.reCalculateTotal()\n
\n
            }\n
\n
        },\n
        changeTypeDiscount() {\n
            this.inputDiscountAmount()\n
        },\n
        inputDiscountAmount() {\n
\n
            if (this.enabled_discount) {\n
\n
                if (this.discount_amount && !isNaN(this.discount_amount) && parseFloat(this.discount_amount) > 0) {\n
\n
                    if(this.is_discount_amount)\n
                    {\n
                        if (this.discount_amount >= this.form.total)\n
                            return this.$message.error("El monto de descuento debe ser menor al total de venta")\n
                    }\n
\n
                    this.deleteDiscountGlobal()\n
                    this.reCalculateTotal()\n
\n
                } else {\n
\n
                    // this.discount_amount = 0\n
                    // this.deleteDiscountGlobal()\n
                    this.reCalculateTotal()\n
\n
                }\n
\n
                // console.log(this.discount_amount)\n
            }\n
        },\n
        isExonerated() {\n
\n
            let not_exonerated = this.form.items.find((item) => {\n
                return item.affectation_igv_type_id != '20'\n
            })\n
\n
            return (not_exonerated) ? false : true\n
        },\n
        setConfigGlobalDiscountType()\n
        {\n
            this.global_discount_type = _.find(this.global_discount_types, { id : this.globalDiscountTypeId})\n
        },\n
        setGlobalDiscount(factor, amount, base, amount_without_rounded)\n
        {\n
            let discount_text = '';\n
            if(this.global_discount_type && this.global_discount_type.description){\n
                discount_text = this.global_discount_type.description\n
            }\n
            this.form.discounts.push({\n
                discount_type_id: this.global_discount_type.id,\n
                description: discount_text,\n
                factor: factor,\n
                amount: _.round(amount, 2),\n
                base: base,\n
                amount_without_rounded: amount_without_rounded\n
            })\n
        },\n
        async discountGlobal(ctx) {\n
            checkoutTotals(this);\n
\n
        },\n
        // ######## INICIO CALCULOS EXACTOS PRO9 ########\n
        reCalculateTotal() {\n
            checkoutTotals(this);\n
            this.calculatePayments();\n
        },\n
        // ######## FIN CALCULOS EXACTOS PRO9 ########\n
        calculatePayments() {\n
            suggestRemainingPayment(this.form);\n
        },\n
        calculateAmountToPayments() {\n
            // if(this.form.payments.length > 0){\n
            //     // this.form.payments[0].payment = this.form.total_pending_payment\n
            // }\n
            this.calculatePayments();\n
            // this.calculateFee();\n
        },\n
        getTotal() {\n
            let total_pay = this.collectionTarget;\n
            // if (this.form.has_retention && this.form.total > 700) {\n
            //     total_pay -= this.form.retention.amount;\n
            // }\n
\n
            ;\n
\n
            // console.log('2');\n
            return total_pay\n
        },\n
        deleteDiscountGlobal(kkj) {\n
\n
            this.form.discounts = []\n
            this.form.total_discount = 0\n
\n
            // let discount = _.find(this.form.discounts, {'discount_type_id': '03'})\n
            // let index = this.form.discounts.indexOf(discount)\n
            // // let is_exonerated = this.isExonerated()\n
\n
            // if (index > -1) {\n
            //     this.form.discounts.splice(index, 1)\n
            //     this.form.total_discount = 0\n
            //     // this.setDiscountByItem(0, is_exonerated)\n
            // }\n
\n
        },\n
        back() {\n
            this.$emit('update:is_payment', false)\n
        },\n
        async initLStoPayment() {\n
\n
            this.amount = await this.getLocalStoragePayment('amount', 0)\n
            this.enter_amount = await this.getLocalStoragePayment('enter_amount', 0)\n
            this.difference = await this.getLocalStoragePayment('difference', 0)\n
        },\n
        getFormPosLocalStorage() {\n
\n
            let form_pos = localStorage.getItem('form_pos');\n
            form_pos = JSON.parse(form_pos)\n
            if (form_pos) {\n
                if (Array.isArray(form_pos.payments)) this.form.payments = form_pos.payments\n
                if (form_pos.payment_condition_id === '02') {\n
                    this.$set(this.form, 'payment_condition_id', '02')\n
                }\n
                if ((this.form.payments || []).length || this.form.payment_condition_id === '02') {\n
                    this.amount = exactSum((this.form.payments || []).map(row=>row.payment || '0')).decimal()\n
                    this.enter_amount = this.amount\n
                    this.inputAmount()\n
                }\n
            }\n
\n
        },\n
        clickAddPayment() {\n
            this.payments = JSON.parse(JSON.stringify(this.form.payments || []))\n
            this.showDialogMultiplePayment = true\n
        },\n
\n
        getDescriptionPaymentMethodType(id) {\n
            let payment_method_type = _.find(this.payment_method_types, {'id': id})\n
            return (payment_method_type) ? payment_method_type.description : ''\n
\n
        },\n
\n
        addRow(payments) {\n
            this.form.payments=payments;\n
            this.setAmount(exactSum(payments.map(row=>row.payment || '0')).decimal());\n
        },\n
        setPaymentMethod(id){\n
            this.payment_method_type_id = id;\n
        },\n
        setAmount(amount) {\n
            this.amount=exactAmount(amount || '0').decimal();\n
            this.enter_amount=this.amount;\n
            this.inputAmount();\n
        },\n
        setAmountCash(amount) {\n
            const row=_.last(this.payments);\n
            if (!row) return;\n
            row.payment=exactAmount(row.payment || '0').plus(amount).decimal();\n
            this.form.payments=this.payments;\n
            this.setAmount(exactSum(this.payments.map(row=>row.payment || '0')).decimal());\n
        },\n
        // ######## INICIO MONEDA DEL MEDIO DE COBRO ########\n
        async enterAmount() {\n
            const rows = this.form.payments || []\n
            if (rows.length !== 1 || this.singleAmountLocked) return\n
            const text = String(this.enter_amount ?? '').trim()\n
            if (text && !/^\d+(?:\.\d*)?$/.test(text)) return\n
            const entered = exactAmount(!text ? '0' : (text.endsWith('.') ? text.slice(0, -1) : text)).decimal()\n
            rows[0].payment = entered\n
            this.payments = rows\n
            this.amount = entered\n
            this.inputAmount()\n
        },\n
        // ######## FIN MONEDA DEL MEDIO DE COBRO ########\n
        /**\n
         * Actualiza el vuelto/faltante y habilita el botón de cobro sólo si el\n
         * importe entregado cubre el total.\n
         */\n
        setDifference(difference) {\n
\n
            if (isNaN(difference)) {\n
                this.button_payment = true\n
                this.difference = 0\n
                return\n
            }\n
\n
            this.difference = exactAmount(difference).decimal()\n
\n
            this.button_payment = !['02', '03'].includes(this.form.payment_condition_id) && (this.difference < 0)\n
        },\n
        getLocalStoragePayment(key, re_default = null) {\n
\n
            let ls_obj = localStorage.getItem(key);\n
            ls_obj = JSON.parse(ls_obj)\n
\n
            if (ls_obj) {\n
                return ls_obj\n
            }\n
\n
            return re_default\n
        },\n
        setLocalStoragePayment(key, obj) {\n
            localStorage.setItem(key, JSON.stringify(obj));\n
        },\n
        inputAmount() {\n
\n
            this.setDifference(exactAmount(this.amount || '0').minus(this.getTotal()).decimal())\n
\n
            this.$eventHub.$emit('eventSetFormPosLocalStorage', this.form)\n
            this.lStoPayment()\n
\n
        },\n
        lStoPayment() {\n
\n
            this.setLocalStoragePayment('enter_amount', this.enter_amount)\n
            this.setLocalStoragePayment('amount', this.amount)\n
            // console.log(this.amount)\n
            this.setLocalStoragePayment('difference', this.difference)\n
\n
        },\n
        initFormPayment() {\n
\n
            this.difference = exactAmount('0').minus(this.collectionTarget ?? this.form.total_payable ?? this.form.total).decimal()\n
\n
            this.form_payment = {\n
                id: null,\n
                date_of_payment: moment().format('YYYY-MM-DD'),\n
                payment_method_type_id: defaultCashForCurrency(this.payment_method_types, this.form.currency_type_id)?.id || null,\n
                reference: null,\n
                document_id: null,\n
                sale_note_id: null,\n
                payment: this.getTotal(),\n
            }\n
\n
            this.form_cash_document = {\n
                document_id: null,\n
                sale_note_id: null\n
            }\n
\n
            console.log(this.form_payment);\n
\n
            this.is_discount_amount = true\n
\n
        },\n
\n
        filterSeries() {\n
            this.form.series_id = null\n
            this.series = _.filter(this.all_series, {'document_type_id': this.form.document_type_id});\n
            this.form.series_id = (this.series.length > 0) ? this.series[0].id : null\n
\n
            if (!this.form.series_id) {\n
                return this.$message.warning('El sucursal no tiene series disponibles para el comprobante');\n
            }\n
        },\n
        async clickCancel() {\n
\n
            this.loading_submit = true\n
            await this.sleep(800);\n
            this.loading_submit = false\n
            this.cleanLocalStoragePayment()\n
            this.$eventHub.$emit('cancelSale')\n
\n
        },\n
        cleanLocalStoragePayment() {\n
\n
            this.setLocalStoragePayment('amount', null)\n
            this.setLocalStoragePayment('enter_amount', null)\n
            this.setLocalStoragePayment('difference', null)\n
        },\n
        sleep(ms) {\n
            return new Promise(resolve => setTimeout(resolve, ms));\n
        },\n
        async asignPlateNumberToItems() {\n
            if (this.form.plate_number) {\n
\n
                await this.form.items.forEach(item => {\n
\n
                    let at = _.find(item.attributes, {'attribute_type_id': '5010'})\n
\n
                    if (!at) {\n
                        item.attributes.push({\n
                            attribute_type_id: '7000',\n
                            description: "Gastos Art. 37 Renta:  Número de Placa",\n
                            value: this.form.plate_number,\n
                            start_date: null,\n
                            end_date: null,\n
                            duration: null,\n
                        })\n
                    }\n
                });\n
            }\n
        },\n
        getDiscountPercentages()\n
        {\n
            if(this.form.discounts)\n
            {\n
                return _.sumBy(this.form.discounts, (discount)=>{\n
                    return discount.factor * 100\n
                })\n
            }\n
\n
            return 0\n
        },\n
        tokenValidated()\n
        {\n
            this.form.token_validated_for_discount = true\n
        },\n
        validateRestrictSellerDiscount()\n
        {\n
            if(this.configuration.restrict_seller_discount && this.typeUser !== 'admin')\n
            {\n
                const all_percentages = this.getDiscountPercentages()\n
\n
                if(all_percentages > parseFloat(this.configuration.sellers_discount_limit) && !this.form.token_validated_for_discount)\n
                {\n
                    this.totalDiscountPercentage = _.round(all_percentages, 2)\n
                    this.showDialogDiscountPermission = true\n
\n
                    return {\n
                        success: false,\n
                    }\n
                }\n
            }\n
\n
            return {\n
                success: true\n
            }\n
        },\n
        validateRestrictSaleItemsCpe()\n
        {\n
            if(this.applyRestrictSaleItemsCpe)\n
            {\n
                let errors_restricted = 0\n
\n
                this.form.items.forEach(row => {\n
                    if(this.isRestrictedForSale(row.item)) errors_restricted++\n
                })\n
\n
                if(errors_restricted > 0) return this.getObjectResponse(false, 'No puede generar el comprobante, tiene productos restringidos.')\n
            }\n
\n
\n
            return this.getObjectResponse()\n
        },\n
        getObjectResponse(success = true, message = null)\n
        {\n
            return {\n
                success: success,\n
                message: message,\n
            }\n
        },\n
        async autoSendPdfMail(document = {}) {\n
            // Digital invoices send through the shared dialog with an explicit attempt UUID.\n
            if (document.fiscal_emission && document.fiscal_emission.status !== null) return;\n
            if (!(this.config || this.configuration || {}).auto_send_pdf_email) return;\n
\n
            if (!this.customer_email) {\n
                this.$message.warning('El cliente no tiene correo registrado.');\n
                return;\n
            }\n
\n
            this.$http.post(`/${this.resource_documents}/email`, {\n
                customer_email: this.customer_email,\n
                id: this.documentNewId\n
            }).then(response => {\n
                if (response.data.success) {\n
                    this.$message.success('El correo fue enviado satisfactoriamente');\n
                } else {\n
                    this.$message.error('Error al enviar el correo');\n
                }\n
            }).catch(() => {\n
                this.$message.error('Error al enviar el correo');\n
            });\n
        },\n
        async clickPayment()\n
        {\n
            // ######## INICIO MONEDA DEL MEDIO DE COBRO ########\n
            if (this.singleAmountInvalid) return this.$message.warning('Indique un monto válido.')\n
            // ######## FIN MONEDA DEL MEDIO DE COBRO ########\n
            // validacion restriccion de productos\n
            const validate_restrict_sale_items_cpe = this.validateRestrictSaleItemsCpe()\n
            if(!validate_restrict_sale_items_cpe.success) return this.$message.error(validate_restrict_sale_items_cpe.message)\n
\n
            // validacion restriccion de descuento\n
            const validate_restrict_seller_discount = this.validateRestrictSellerDiscount()\n
            if(!validate_restrict_seller_discount.success) return\n
\n
            if (this.form.payments == 0){\n
                this.form.payment_condition_id = "02";\n
            }\n
\n
            // validacion sistema por puntos\n
            if(this.enabledPointSystem)\n
            {\n
                const validate_exchange_points = this.validateExchangePoints()\n
                if(!validate_exchange_points.success) return this.$message.error(validate_exchange_points.message)\n
            }\n
            else\n
            {\n
                if(this.form.total <= 0) return this.$message.error('El total debe ser mayor a 0')\n
            }\n
\n
\n
            if (!moment(moment().format("YYYY-MM-DD")).isSame(this.form.date_of_issue)) {\n
                return this.$message.error('La fecha de emisión no coincide con la del día actual');\n
            }\n
\n
            if (!this.form.series_id) {\n
                return this.$message.warning('El sucursal no tiene series disponibles para el comprobante');\n
            }\n
\n
            this.form.created_from_pos = true;\n
            this.form.show_terms_condition = true;\n
            const cfg = this.config || this.configuration || {};\n
            if (cfg.terms_condition_sale) {\n
                this.form.terms_condition = cfg.terms_condition_sale;\n
            }\n
\n
            if (this.form.document_type_id === "80") {\n
                this.form.prefix = "NV";\n
                this.form.paid = 1;\n
                this.resource_documents = "sale-notes";\n
                this.resource_payments = "sale_note_payments";\n
                this.resource_options = this.resource_documents;\n
            } else {\n
                this.form.prefix = null;\n
                this.resource_documents = "documents";\n
                this.resource_payments = "document_payments";\n
                this.resource_options = this.resource_documents;\n
                await this.asignPlateNumberToItems()\n
            }\n
\n
            ;\n
\n
            if (!await this.ensureFiscalPaymentsReady(this.form.payments)) return\n
\n
            this.loading_submit = true\n
            this.locked_submit = true\n
\n
            await this.$http.post(`/${this.resource_documents}`, withoutDraftRetentions(this.form)).then(async (response) => {\n
                if (response.data.success) {\n
                    let response_sent = null\n
                    this.responseForm = response.data\n
\n
                    if (this.form.document_type_id === "80") {\n
                        // this.form_payment.sale_note_id = response.data.data.id;\n
                        this.form_cash_document.sale_note_id = response.data.data.id;\n
\n
                    } else {\n
                        // ########## INICIO CAMBIO SIN XML CDR SUNAT\n
                        // El alta ya termina registrada localmente; no se ejecuta un segundo envío fiscal.\n
                        // ######### FIN CAMBIO SIN XML CDR SUNAT\n
                        // this.form_payment.document_id = response.data.data.id;\n
                        this.form_cash_document.document_id = response.data.data.id;\n
\n
                    }\n
\n
\n
                    this.documentNewId = response.data.data.id;\n
                    // this.showDialogOptions = true;\n
                    this.autoSendPdfMail(response.data.data);\n
                    this.showOptionsDialog(response_sent)\n
\n
                    // this.savePaymentMethod();\n
                    this.saveCashDocument();\n
\n
                    // this.initFormPayment() ;\n
                    this.cleanLocalStoragePayment()\n
                    // if(this.isPrint){\n
                    //     this.gethtml();\n
                    // migrado a options\n
                    // }\n
                    this.$eventHub.$emit('saleSuccess');\n
                } else {\n
                    this.$message.error(response.data.message);\n
                }\n
            }).catch(error => {\n
                console.log(error);\n
\n
                if (error.response && error.response.status === 422) {\n
                    this.errors = error.response.data?.errors || error.response.data || {};\n
                    this.$message.error(checkoutValidationMessage(error.response.data));\n
                    if (this.errors.quoted_tax_amount) this.refreshFiscalQuote(this.form.payments);\n
                } else {\n
                    this.$message.error(error.response && error.response.data && error.response.data.message || 'No se pudo confirmar el guardado. Consulte el listado antes de crear nuevamente la factura.');\n
                }\n
            }).then(() => {\n
                this.loading_submit = false;\n
                this.locked_submit = false\n
            });\n
        },\n
\n
        showOptionsDialog(response){\n
\n
            if(this.hidePdfViewDocuments)\n
            {\n
\n
                if(this.form.document_type_id === '80')\n
                {\n
                    this.$message.success(`Nota de venta registrada: ${this.responseForm.data.number_full}`)\n
                }\n
                else\n
                {\n
                    if (response) {\n
                        const response_data = response.data\n
                        this.$message.success(response_data.message)\n
                    }\n
                    else\n
                    {\n
                        this.$message.success(`Comprobante registrado: ${this.responseForm.data.number_full}`)\n
                    }\n
                }\n
\n
\n
\n
\n
                if (this.isPrint) {\n
                    this.clickCancel()\n
                    this.autoPrint();\n
                } else {\n
                    this.clickCancel()\n
                }\n
\n
            }\n
            else\n
            {\n
                this.showDialogOptions = true\n
            }\n
\n
        },\n
        async autoPrint() {\n
            if (!this.isPrint) return;\n
            if (!this.responseForm || !this.responseForm.links ) return;\n
\n
            try {\n
                // Centraliza la impresión vía backend → Redis → BuhoPrinter agent\n
                await this.printDocument(this.responseForm.links.print_ticket, this.configuration?.printer_name_documents);\n
            } catch (e) {\n
                console.error('payment autoPrint error', e);\n
            }\n
        },\n
\n
        // ########## INICIO CAMBIO SIN XML CDR SUNAT\n
        // No se expone un método de envío fiscal en el pago local.\n
        // ######### FIN CAMBIO SIN XML CDR SUNAT\n
        gethtml(){\n
            this.form.datahtml="";\n
            var doc='salenote';\n
            var route = `/printticket/document/${this.documentNewId}/ticket`;\n
            if(this.resource_documents!=='documents'){\n
                route = `/sale-notes/ticket/${this.documentNewId}/ticket`;\n
            }\n
\n
            // console.log(route);\n
\n
            this.$http.get(route)\n
            .then(response => {\n
                if (response.data.length>0) {\n
                    this.form.datahtml=response.data;\n
                    this.printticket();\n
                }\n
\n
            })\n
            .catch(error => {\n
                console.log(error);\n
            })\n
        },\n
        async printticket(){\n
            await this.sleep(400);\n
            const configg = this.getUpdatedConfig();\n
            if (!this.form.datahtml) return;\n
            // Reutiliza el print_ticket PDF del último comprobante guardado\n
            const url = this.responseForm?.links?.print_ticket;\n
            if (url) {\n
                // Centraliza la impresión vía backend → Redis → BuhoPrinter agent\n
                await this.printDocument(url, this.configuration?.printer_name_documents);\n
            } else {\n
                console.warn('[BuhoPrinter] print_ticket URL no disponible.');\n
            }\n
        },\n
        saveCashDocument() {\n
            this.$http.post(`/cash/cash_document`, this.form_cash_document)\n
                .then(response => {\n
                    if (response.data.success) {\n
                        // console.log(response)\n
                    } else {\n
                        this.$message.error(response.data.message);\n
                    }\n
                })\n
                .catch(error => {\n
                    console.log(error);\n
                })\n
        },\n
        savePaymentMethod() {\n
            this.$http.post(`/${this.resource_payments}`, this.form_payment)\n
                .then(response => {\n
                    if (response.data.success) {\n
                        // console.log(response)\n
                    } else {\n
                        this.$message.error(response.data.message);\n
                    }\n
                })\n
                .catch(error => {\n
                    if (error.response && error.response.status === 422) {\n
                        this.records[index].errors = error.response.data;\n
                    } else {\n
                        console.log(error);\n
                    }\n
                })\n
        },\n
        async getTables() {\n
            return this.$http.get(`/${this.resource}/payment_tables`)\n
                .then(response => {\n
                    this.all_series = response.data.series\n
                    this.payment_method_types = response.data.payment_method_types\n
                    this.global_discount_types = response.data.global_discount_types\n
                    this.filterSeries()\n
                    this.setConfigGlobalDiscountType()\n
                    this.setDefaultDocumentType()\n
                })\n
\n
        },\n
\n
    }\n
}\n
</script>\n
