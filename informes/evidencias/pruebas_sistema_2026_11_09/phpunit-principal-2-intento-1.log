                        <button type="button" class="btn btn-sm second-buton mt-1" @click="cancelLayoutEditFromHeader">\n
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-x" style="margin-top: -2px;"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M18 6l-12 12" /><path d="M6 6l12 12" /></svg>\n
                            Cancelar\n
                        </button>\n
                        <button type="button" @click="resetLayoutFromHeader" class="btn btn-sm second-buton" title="Restablecer">\n
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-refresh" style="margin-top: -2px;"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" /><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" /></svg>\n
                            Restablecer\n
                        </button>\n
                        <button type="button" :disabled="layout_saving" @click="confirmLayoutFromHeader" class="btn btn-sm btn-primary" title="Guardar">\n
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-device-floppy" style="margin-top: -2px;"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M6 4h10l4 4v10a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2" /><path d="M10 14a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M14 4l0 4l-6 0l0 -4" /></svg>\n
                            Guardar\n
                        </button>\n
                    </div>\n
                </header>\n
                <document-form-pinned-bar\n
                    ref="pinnedBar"\n
                    variant="invoice"\n
                    class="card-body card-body-invoice no-gutters border-0 shadow-none p-0 py-1 py-md-2 px-md-2 mx-1"\n
                    :pinned-fields="pinned_fields"\n
                    :hidden-fields="hiddenLayoutFields"\n
                    @editing-changed="editingLayout = $event"\n
                    @save="onSaveLayout"\n
                >\n
                    <template #customer_id>\n
                        <div :class="{ 'has-danger': errors.customer_id }" class="form-group position-relative">\n
                            <label class="control-label font-weight-bold">\n
                                <el-badge type="success" :value="getCustomer.person_type" class="item">\n
                                    <span>Cliente</span>\n
                                </el-badge>\n
                            </label>\n
                            <el-select\n
                                v-model="form.customer_id"\n
                                :loading="loading_search"\n
                                :remote-method="searchRemoteCustomers"\n
                                class="border-left rounded-left border-info customer-select-clearable"\n
                                dusk="customer_id"\n
                                filterable\n
                                @focus="focus_on_client = true"\n
                                @blur="focus_on_client = false"\n
                                placeholder="Escriba el nombre o número de documento del cliente"\n
                                popper-class="el-select-customers"\n
                                remote\n
                                @change="changeCustomer"\n
                                @keyup.enter.native="keyupCustomer"\n
                            >\n
                                <el-option\n
                                    v-for="option in customers"\n
                                    :key="option.id"\n
                                    :label="option.description"\n
                                    :value="option.id"\n
                                ></el-option>\n
\n
                                <template slot="empty">\n
                                    <p v-if="loading_search" class="el-select-dropdown__empty">\n
                                        Cargando...\n
                                    </p>\n
\n
                                    <p v-else class="el-select-dropdown__empty">\n
                                        No se encontraron resultados\n
                                    </p>\n
\n
                                    <div\n
                                        v-if="!loading_search"\n
                                        class="el-select-dropdown__item new-option"\n
                                        @click.stop="openNewPersonDialog"\n
                                    >\n
                                        <span>{{ customerSearchTerm ? `Crear cliente "${customerSearchTerm}"` : 'Crear cliente' }}</span>\n
                                    </div>\n
                                </template>\n
                            </el-select>\n
                            <template v-if="form.customer_id">\n
                                <span class="btn-add-new btn-edit-person btn-add-new-invoice" @click.prevent="showDialogNewPerson = true; editPerson = true" title="Editar cliente">\n
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user-edit"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h3.5" /><path d="M18.42 15.61a2.1 2.1 0 0 1 2.97 2.97l-3.39 3.42h-3v-3l3.42 -3.39" /></svg>\n
                                </span>\n
                            </template>\n
                            <template>\n
                                <span class="btn-add-new btn-add-new-invoice" @click.prevent="showDialogNewPerson = true; editPerson = false" title="Agregar nuevo cliente">\n
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user-plus"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M16 19h6" /><path d="M19 16v6" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4" /></svg>\n
                                </span>\n
                            </template>\n
                            <small\n
                                v-if="errors.customer_id"\n
                                class="form-control-feedback"\n
                                v-text="errors.customer_id[0]"\n
                            ></small>\n
                        </div>\n
\n
                        <!-- <div v-if="form.operation_type_id === '0101'" class="mt-2">\n
                            <el-checkbox v-model="form.is_itinerant" @change="changeItineratOption">\n
                                ¿Venta itinerante?\n
                            </el-checkbox>\n
                        </div> -->\n
                    <div class="points-system">\n
                            <div\n
                                v-if="config.enabled_point_system && form.customer_id"\n
                                class="d-flex align-items-center justify-content-between content-points"\n
                            >\n
                                <p class="fs-point-system m-0">\n
                                    <label class="font-weight-bold text-info"\n
                                        >Puntos acumulados: </label\n
                                    >\n
                                    <b>{{ customer_accumulated_points }}</b>\n
\n
                                    <template v-if="hasExchangePoints()">\n
                                        -\n
                                        <b class="text-danger">{{ total_exchange_points}}</b>\n
                                        <b>{{ calculate_customer_accumulated_points }}</b>\n
                                    </template>\n
                                </p>\n
                                <span class="mx-1 text-muted">|</span>\n
                                <p class="fs-point-system m-0">\n
                                    <label class="font-weight-bold text-danger"\n
