        if (!$cash) {\n
            if (!$this->userCanAccessCash()) {\n
                return redirect('/documents')->with('toast_warning', 'No tienes permisos para abrir caja. Contacta al administrador para acceder a la configuración de Finanzas.');\n
            }\n
            return redirect()->route('tenant.cash.index', ['redirect_reason' => 'no_cash_document']);\n
        }\n
\n
        $is_contingency = 0;\n
        return view('tenant.documents.form_tensu', compact('is_contingency'));\n
    }\n
\n
    private function userCanAccessCash(): bool\n
    {\n
        // Simula una petición GET a /cash con el usuario actual\n
        $cashRequest = \Illuminate\Http\Request::create('cash', 'GET');\n
        $cashRequest->setUserResolver(fn () => auth()->user());\n
\n
        $passed = false;\n
        $middleware = new \App\Http\Middleware\RedirectModuleLevel();\n
        $middleware->handle($cashRequest, function () use (&$passed) {\n
            $passed = true;            // si llega aquí, el middleware dejó pasar => sí puede entrar a /cash\n
            return response('ok');\n
        });\n
\n
        return $passed;                // false => el middleware redirigiría => sin acceso a caja\n
    }\n
\n
