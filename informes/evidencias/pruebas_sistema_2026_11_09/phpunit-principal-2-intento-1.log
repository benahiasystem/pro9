        onSuccessUploadVoucher(response, file, fileList, index) {\n
            if (response.success) {\n
                this.form.payments[index].filename = response.data.filename;\n
                this.form.payments[index].temp_path = response.data.temp_path;\n
                this.form.payments[index].file_list = fileList;\n
            } else {\n
                this.cleanFileListUploadVoucher(index);\n
                this.$message.error(response.message || 'No se pudo cargar el archivo.');\n
            }\n
        },\n
        onUploadErrorVoucher(error, file, fileList, index) {\n
            this.cleanFileListUploadVoucher(index);\n
            this.$message.error(this.getPaymentFileErrorMessage(error));\n
        },\n
        getPaymentFileErrorMessage(error) {\n
            const data = error && error.response ? error.response.data : null;\n
\n
            if (typeof data === 'string' && data.trim()) {\n
                return data;\n
            }\n
\n
            if (data && data.message) {\n
                return data.message;\n
            }\n
\n
            if (error && error.message) {\n
                return error.message;\n
            }\n
\n
            return 'Ocurrió un error al procesar la solicitud.';\n
        },\n
        cleanFileListUploadVoucher(index) {\n
            this.form.payments[index].file_list = [];\n
        },\n
        handleRemoveUploadVoucher(file, fileList, index) {\n
