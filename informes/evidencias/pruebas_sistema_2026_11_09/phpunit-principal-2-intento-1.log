    computed: {\n
        // ######## INICIO PRESENTACION DEL COBRO DE FACTURAS NUEVAS ########\n
        invoiceCollectionLayout() { return !this.isUpdateDocument && this.form.document_type_id === '01' },\n
        invoiceCollectionQuote() {\n
            return !this.igtfQuoteLoading && !this.igtfQuoteError && this.igtfQuoteKey === this.fiscalQuoteKey ? this.igtfQuote : null;\n
        },\n
        // ######## FIN PRESENTACION DEL COBRO DE FACTURAS NUEVAS ########\n
        // ######## INICIO IMPORTE RECIBIDO JUNTO AL METODO ########\n
        receivedPaymentCurrency() {\n
            if (!this.fiscalPaymentsApplicable) return null;\n
            const payment = this.form.payments.find(row => !isRecordedReceipt(row)\n
                && row.currency_type_id && row.currency_type_id !== this.form.currency_type_id);\n
            return payment ? payment.currency_type_id : null;\n
        },\n
        // ######## FIN IMPORTE RECIBIDO JUNTO AL METODO ########\n
        receiptAppliedAmounts() {\n
            return JSON.stringify((this.form?.payments || []).map(row => row.payment));\n
        },\n
        // La personalización de campos se opera pasando el cursor sobre el\n
        // título, gesto que no existe en celular: allí el botón se oculta\n
        // (mobile.css) y su paso del tutorial se omite para no señalar un\n
        // elemento invisible\n
        miniTourStepsVisible() {\n
            if (!window.matchMedia("(max-width: 767.98px)").matches) {\n
                return this.miniTourSteps;\n
            }\n
            const pasos = this.miniTourSteps.filter(\n
                step => step.target !== ".edit-layout-btn"\n
            );\n
            // Se renumeran: al quitar un paso, el rótulo "Paso 2 de 2"\n
            // quedaría en el único paso que se muestra\n
            return pasos.map((step, i) => ({\n
                ...step,\n
                tag: `Paso ${i + 1} de ${pasos.length}`\n
            }));\n
        },\n
        layoutPinnedKeysSet() {\n
            if (\n
                this.editingLayout &&\n
                this.pinnedBarInstance &&\n
                Array.isArray(this.pinnedBarInstance.draftPins)\n
            ) {\n
                return new Set(this.pinnedBarInstance.draftPins.map(p => p.field_key));\n
            }\n
            return new Set((this.pinned_fields || []).map(p => p.field_key));\n
        },\n
        relocatedFields() {\n
            if (!this.pinnedBarReady) return [];\n
            const hidden = new Set(this.hiddenLayoutFields);\n
            return getDocumentAvailableFields('invoice')\n
                .filter(f => f.group === 'main')\n
                .filter(f => !this.layoutPinnedKeysSet.has(f.key) && !hidden.has(f.key))\n
                .map(f => ({ key: f.key, field: f }));\n
        },\n
        hiddenLayoutFields() {\n
            const hidden = [];\n
            if (!this.showCurrencyExchangeFields) {\n
                hidden.push('currency_type_id', 'exchange_rate_sale');\n
            }\n
            if (!this.showItinerantPointField) {\n
                hidden.push('itinerant_option_id');\n
            }\n
            if (!this.showItinerantRucField) {\n
                hidden.push('ruc_itinerant');\n
            }\n
            if (!(this.configuration && this.configuration.enable_consigned && this.consigneds && this.consigneds.length)) {\n
                hidden.push('consigned_id', 'consigned_address_id');\n
            }\n
            if (!this.showPlateNumberField) {\n
                hidden.push('plate_number');\n
            }\n
            return hidden;\n
        },\n
        operation_type_id_view: {\n
            get() {\n
                if (\n
                    this.form.operation_type_id === "0101" &&\n
                    this.is_itinerant_operation\n
                ) {\n
                    return "0101_itinerant";\n
                }\n
                return this.form.operation_type_id;\n
            },\n
            set(val) {\n
                if ((this.thirdPartyMode || this.form.fiscal_data?.special_tax_regime_id) && val !== '0101') {\n
                    this.$message.error('La factura por terceros o con régimen especial requiere venta interna.');\n
                    return;\n
                }\n
                const nextExport = ['0201', '0202', '0203'].includes(val);\n
                const changedCategory = nextExport !== this.isExportInvoice;\n
                if (changedCategory && (this.isUpdateDocument || this.form.items.length > 0)) {\n
                    this.$message.error('Cambie entre venta interna y exportación antes de agregar productos. Las facturas registradas conservan su categoría.');\n
                    return;\n
                }\n
                if (changedCategory) {\n
                    this.form.customer_id = null;\n
                    this.form.customer_address_id = null;\n
                    this.preloadedCustomerId = null;\n
                    this.preloadedCustomer = null;\n
                }\n
                if (val === "0101_itinerant") {\n
                    this.is_itinerant_operation = true;\n
                    this.form.operation_type_id = "0101";\n
                    this.form.is_itinerant = true;\n
                } else {\n
                    if (this.is_itinerant_operation) {\n
                        this.form.is_itinerant = false;\n
                    }\n
                    this.is_itinerant_operation = false;\n
                    this.form.operation_type_id = val;\n
                }\n
            }\n
        },\n
        operation_types_filter() {\n
            return this.operation_types;\n
        },\n
        showOperationTypeField() {\n
            // Mantener visible el tipo seleccionado, incluso cuando el tenant\n
            // solo tenga una operación disponible.\n
            return this.operation_types_filter.length > 0;\n
        },\n
        isExportInvoice() {\n
            return ['0201', '0202', '0203'].includes(this.form.operation_type_id);\n
        },\n
        specialTaxRegimeAvailable() {\n
            return this.company?.fiscal_emission_mode === 'digital' && this.company?.fiscal_environment === 'demo'\n
                && this.form.document_type_id === '01' && this.form.operation_type_id === '0101' && !this.form.is_itinerant;\n
        },\n
        thirdPartyAvailable() {\n
            return this.company?.fiscal_emission_mode === 'digital' && this.company?.fiscal_environment === 'demo'\n
                && this.form.document_type_id === '01' && this.form.operation_type_id === '0101' && !this.form.is_itinerant;\n
        },\n
        showCurrencyExchangeFields() {\n
            return this.currency_types.length > 1;\n
        },\n
        showItinerantPointField() {\n
            return this.form.operation_type_id === "0101" && this.form.is_itinerant;\n
        },\n
        showItinerantRucField() {\n
            return this.showItinerantPointField && this.itinerant_option_id == 2;\n
        },\n
        currencyColumnClass() {\n
            if (this.showItinerantRucField) {\n
                return "col-lg-3";\n
            }\n
\n
            if (this.showItinerantPointField) {\n
                return "col-lg-4";\n
            }\n
\n
            return "col-lg-6";\n
        },\n
        exchangeRateColumnClass() {\n
            if (this.showItinerantRucField) {\n
                return "col-lg-3";\n
            }\n
\n
            if (this.showItinerantPointField) {\n
                return "col-lg-4";\n
            }\n
\n
            return "col-lg-6";\n
        },\n
        itinerantPointColumnClass() {\n
            if (!this.showCurrencyExchangeFields) {\n
                return this.showItinerantRucField ? "col-lg-8" : "col-lg-12";\n
            }\n
\n
            return "col-lg-4";\n
        },\n
        itinerantRucColumnClass() {\n
            if (!this.showCurrencyExchangeFields) {\n
                return "col-lg-4";\n
            }\n
\n
            return "col-lg-2";\n
        },\n
        showPlateNumberField() {\n
            return Array.isArray(this.business_turns) &&\n
                this.business_turns.some(bt => bt.value === 'tap' && bt.active);\n
        },\n
        getCurrentLogo() {\n
            const isDarkMode = document.documentElement.classList.contains('dark');\n
\n
            if (isDarkMode && this.company.logo_dark) {\n
                return `/storage/uploads/logos/${this.company.logo_dark}`;\n
            }\n
            if (this.company.logo) {\n
                return `/storage/uploads/logos/${this.company.logo}`;\n
            }\n
            return '';\n
        },\n
        isGeneratedFromExternal() {\n
            return (\n
                this.table != undefined &&\n
                this.table &&\n
                (this.tableId != undefined && this.tableId)\n
            );\n
        },\n
        showLoadVoucher() {\n
            return (\n
                this.configuration.show_load_voucher && !this.isUpdateDocument\n
            );\n
        },\n
        isGlobalDiscountBase: function() {\n
            if (this.recordDiscountsGlobal) {\n
               return  this.recordDiscountsGlobal.discount_type_id === "02";\n
            }\n
            return this.configuration.global_discount_type_id === "02" ;\n
        },\n
        ...mapState(["config", "series", "all_series"]),\n
        isNrus() {\n
            return !!(this.config && this.config.is_nrus);\n
        },\n
        documentTypesAvailable() {\n
            // ########## INICIO CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
            if (this.isNrus) {\n
                return [];\n
            }\n
            return this.document_types.filter(dt => dt.id === "01");\n
            // ######### FIN CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
        },\n
        credit_payment_metod: function() {\n
            return this.payment_method_types.filter(method => method.collection_kind === 'credit' && [true, 1, '1'].includes(method.is_active));\n
        },\n
        cash_payment_metod: function() {\n
            return this.payment_method_types.filter(method => ['cash', 'account'].includes(method.collection_kind) && [true, 1, '1'].includes(method.is_active));\n
        },\n
        existDiscountsNoBase: function() {\n
            return this.total_discount_no_base > 0 ? true : false;\n
        },\n
        editBlocked() {\n
            return this.isUpdateDocument && this.form.can_edit === false;\n
        },\n
        isUpdateDocument: function() {\n
            return this.documentId ? true : false;\n
        },\n
        isCreditPaymentCondition: function() {\n
            return ["02", "03"].includes(this.form.payment_condition_id);\n
        },\n
        isAutoPrint: function() {\n
            if (this.configuration) {\n
                return this.configuration.auto_print;\n
            }\n
\n
            return false;\n
        },\n
        hidePreviewPdf: function() {\n
            if (this.configuration) {\n
                return this.configuration.hide_pdf_view_documents;\n
            }\n
\n
            return false;\n
        },\n
        isFromExternalDocument() {\n
            return this.table !== undefined && this.table !== null;\n
        },\n
        canAddDescriptionToDocumentItem() {\n
            if (this.configuration)\n
                return this.configuration.add_description_to_document_item;\n
\n
            return false;\n
        },\n
        filteredSellers() {\n
\n
            if (!this.isUpdateDocument) {\n
                return this.sellers.filter(seller => !seller.name.includes('(SUSPENDIDO)'));\n
            }\n
            return this.sellers;\n
        },\n
        personFormInput() {\n
            const term = (this.customerSearchTerm || '').trim()\n
\n
            if (!term) return ''\n
\n
            if (/^\d+$/.test(term)) {\n
                let identity_document_type_id = null\n
                if (term.length === 8) identity_document_type_id = '1'\n
                if (term.length === 11) identity_document_type_id = '6'\n
\n
                return {\n
                    number: term,\n
                    ...(identity_document_type_id ? { identity_document_type_id } : {})\n
                }\n
            }\n
\n
            return term\n
        },\n
        amountRetentionValidate() {\n
            let amount = 700;\n
            if (this.form.currency_type_id === "USD") {\n
                amount = exactAmount(700).dividedBy(exactAmount(this.form.exchange_rate_sale)).final(2);\n
            }\n
            return this.form.total > amount;\n
        },\n
        getCustomer(){\n
            const customer = this.customers.find(\n
                c => String(c.id) === String(this.form.customer_id)\n
            );\n
            return customer || {};\n
        },\n
        selectedCustomerAddressLabel() {\n
            const customer = this.getCustomer;\n
            if (!customer || !customer.address) {\n
                return '';\n
            }\n
\n
            return customer.address;\n
        },\n
        totalDiscount() {\n
            const lineDiscount = exactSum(this.form.items.map(item => this.itemDiscountDisplayAmount(item)));\n
            const global = exactSum((this.form.discounts || []).map(discount => {\n
                const amount = exactAmount(discount.amount_exact ?? discount.amount_without_rounded ?? discount.amount ?? '0');\n
                return ['02','04'].includes(discount.discount_type_id) ? amount.times(exactAmount(1).plus(this.percentage_igv)) : amount;\n
            }));\n
            return lineDiscount.plus(global).decimal();\n
        },\n
        displaySubtotalBeforeDiscount() {\n
            // Tipo 02: mostrar total con IGV ANTES del dto (UI). form.subtotal = total post-dto (XML).\n
            if (\n
                this.isGlobalDiscountBase &&\n
                this.subtotal_before_global_discount > 0\n
            ) {\n
                return this.subtotal_before_global_discount;\n
            }\n
            return this.form.subtotal;\n
        },\n
        guarantee_fund: function() {\n
\n
            let fund_obj = 0\n
            return fund_obj.guarantee_fund ? fund_obj.guarantee_fund : 0\n
        }\n
    },\n
    mounted() {\n
        this.capturePinnedBar();\n
    },\n
    updated() {\n
        this.capturePinnedBar();\n
    },\n
    async created() {\n
        await this.initComponent();\n
        await this.getPercentageIgv();\n
\n
        this.loading_form = true;\n
        this.$eventHub.$on("reloadDataPersons", customer_id => {\n
            this.reloadDataCustomers(customer_id);\n
            this.customerSearchTerm = ''\n
        });\n
        this.$eventHub.$on("initInputPerson", () => {\n
            this.initInputPerson();\n
        });\n
        this.$eventHub.$on("reloadDataConsigned", () => {\n
            this.getConsigneds();\n
        });\n
        this.$eventHub.$on("establishmentChanged", () => {\n
            this.initComponent();\n
        });\n
        if (this.documentId) {\n
            this.btnText = "Actualizar";\n
            this.loading_submit = true;\n
            await this.$http\n
                .get(`/documents/${this.documentId}/show`)\n
                .then(response => {\n
                    return this.onSetFormData(response.data.data);\n
                })\n
                .finally(() => (this.loading_submit = false));\n
        }\n
\n
        /*\n
         * #830\n
         */\n
        if (this.table) {\n
            await this.$http\n
                .get(`/store/record/${this.table}/${this.tableId}`)\n
                .then(response => {\n
                    return this.onSetFormData(response.data.data);\n
                })\n
                .finally(() => (this.loading_submit = false));\n
        }\n
        /*\n
         * #830\n
         */\n
\n
        const itemsFromDispatches = localStorage.getItem("items");\n
        if (itemsFromDispatches) {\n
            const itemsParsed = JSON.parse(itemsFromDispatches);\n
            const items = itemsParsed.map(i => i.item_id);\n
            const params = {\n
                items_id: items\n
            };\n
            localStorage.removeItem("items");\n
            await this.$http\n
                .get("/documents/search-items", { params })\n
                .then(response => {\n
                    const itemsResponse = response.data.items.map(i => {\n
                        return this.setItemFromResponse(i, itemsParsed, true);\n
                    });\n
                    this.form.items = itemsResponse.map(i => {\n
                        return calculateRowItem(\n
                            i,\n
                            this.form.currency_type_id,\n
                            this.form.exchange_rate_sale,\n
                            this.percentage_igv, this.isExportInvoice\n
                        );\n
                    });\n
                });\n
        }\n
\n
        // ######## INICIO CLASIFICACION DE COBROS Y CAJA ########\n
        try {\n
            restoreSaleNoteContext(this, localStorage);\n
        } catch (error) {\n
            this.$message.error(error.message || 'No se pudo recuperar la selección de notas.');\n
            return;\n
        }\n
        // ######## FIN CLASIFICACION DE COBROS Y CAJA ########\n
        const itemsFromNotes = localStorage.getItem("itemsForNotes");\n
        if (itemsFromNotes) {\n
            const itemsParsed = JSON.parse(itemsFromNotes);\n
            const items = itemsParsed.map(i => i.id);\n
            const params = {\n
                items_id: items\n
            };\n
            localStorage.removeItem("itemsForNotes");\n
            await this.$http\n
                .get("/documents/search-items", { params })\n
                .then(response => {\n
                    const itemsResponse = response.data.items.map(i => {\n
                        return this.setItemFromResponse(i, itemsParsed);\n
                    });\n
                    this.form.items = itemsResponse.map(i => {\n
                        return calculateRowItem(\n
                            i,\n
                            this.form.currency_type_id,\n
                            this.form.exchange_rate_sale,\n
                            this.percentage_igv, this.isExportInvoice\n
                        );\n
                    });\n
                });\n
        }\n
\n
        //parse items from multiple sale notes not group\n
        this.processItemsForNotesNotGroup();\n
\n
        const lotsItems = localStorage.getItem("lotsItems");\n
        if (lotsItems) {\n
            const lotsParsed = JSON.parse(lotsItems);\n
            localStorage.removeItem("lotsItems");\n
            this.form.items = this.form.items.map(row => {\n
                row.item.lots = _.filter(lotsParsed, { item_id: row.item_id });\n
                return row;\n
            });\n
        }\n
\n
        const clientfromDispatchesOrNotes = localStorage.getItem("client");\n
        if (clientfromDispatchesOrNotes) {\n
            const client = JSON.parse(clientfromDispatchesOrNotes);\n
            // ########## INICIO CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
            this.form.document_type_id = this.isNrus ? null : "01";\n
            // ######### FIN CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
            // ########## INICIO FACTURA DESDE MÚLTIPLES NOTAS PARA TODO CLIENTE ##########\n
            this.preloadedCustomerId = client.id;\n
            this.preloadedCustomer = client;\n
            await this.reloadDataCustomers(client.id);\n
            this.preloadedCustomer =\n
                _.find(this.customers, { id: client.id }) || client;\n
            // ######### FIN FACTURA DESDE MÚLTIPLES NOTAS PARA TODO CLIENTE #########\n
            if (client.dispatch_establishment_id) this.form.establishment_id=client.dispatch_establishment_id;\n
            this.changeEstablishment();\n
            this.filterSeries();\n
            this.filterCustomers();\n
            this.changeCurrencyType();\n
            localStorage.removeItem("client");\n
        }\n
        const dispatchesNumbersFromDispatches = localStorage.getItem(\n
            "dispatches"\n
        );\n
        if (dispatchesNumbersFromDispatches) {\n
            this.form.dispatches_relateds = JSON.parse(\n
                dispatchesNumbersFromDispatches\n
            );\n
            localStorage.removeItem("dispatches");\n
        }\n
        const notesNumbersFromNotes = localStorage.getItem("notes");\n
        if (notesNumbersFromNotes) {\n
            this.form.sale_notes_relateds = JSON.parse(notesNumbersFromNotes);\n
            localStorage.removeItem("notes");\n
        }\n
\n
        // if (this.form.currency_type_id === 'USD') { // Si los documentos precargados han sido establecidos y tienen dolar\n
        //     this.changeCurrencyType();\n
        // } else if (this.config.currency_type_id === 'USD' ) { // Si en configuracion tiene como dolar por defecto\n
        //     this.changeCurrencyType();\n
        // }\n
\n
        this.startConnectionQzTray();\n
\n
\n
\n
    },\n
    watch: {\n
        receiptAppliedAmounts() {\n
            if (['02', '03'].includes(this.form?.payment_condition_id) && this.form?.fee?.length) this.calculateFee();\n
        },\n
        'form.customer_id': 'checkCustomerExpiredDebt',\n
        'form.payment_condition_id': 'checkCustomerExpiredDebt',\n
        'form.fee' : {\n
            handler(newValue, oldValue) {\n
                if (this.form.payment_condition_id === '02' ) {\n
                    this.form.date_of_due = newValue[0].date\n
                }\n
            },\n
            deep: true\n
        },\n
        showDialogNewPerson(newVal) {\n
            if (!newVal) {\n
                this.customerSearchTerm = ''\n
            }\n
        }\n
    },\n
    methods: {\n
        // ######## INICIO PRESENTACION DEL COBRO DE FACTURAS NUEVAS ########\n
        invoiceCollectionRowKey,\n
        collectionAdjustmentDetail,\n
        updateInvoiceCollectionState(state) {\n
            if (!this.invoiceCollectionLayout || !this.form.payments.includes(state.payment)) return;\n
            const states = this.invoiceCollectionStates.filter(value => this.form.payments.includes(value.payment) && value.payment !== state.payment);\n
            this.invoiceCollectionStates = [...states, state];\n
        },\n
        // ######## FIN PRESENTACION DEL COBRO DE FACTURAS NUEVAS ########\n
        updatePaymentPrincipal(row, value) {\n
            this.$set(row, 'payment', value);\n
            this.markPaymentEdited(row);\n
        },\n
        markPaymentEdited(row) {\n
            markPaymentEdited(row);\n
            this.calculatePayments();\n
        },\n
        restoreFiscalOptions(data) {\n
            this.form.fiscal_data = {special_tax_regime_id: data.special_tax_regime_id ?? null};\n
            this.savedSpecialTaxRegime = data.special_tax_regime_description || null;\n
            if (data.special_tax_regime_id && !this.specialTaxRegimes.some(row => row.id === data.special_tax_regime_id)) {\n
                this.specialTaxRegimes.push({id: data.special_tax_regime_id, description: data.special_tax_regime_description, inactive: true});\n
            }\n
            this.originalThirdPartyInvoice = Boolean(data.is_third_party_invoice);\n
            this.thirdPartyMode = this.originalThirdPartyInvoice;\n
            this.form.third_party_id = data.third_party_id || null;\n
            this.thirdPartySavedOption = data.third_party ? {id: data.third_party_id, name: data.third_party.name,\n
                third_party_rif: data.third_party.rif, third_party_activity: data.third_party.activity} : null;\n
            this.thirdParties = this.thirdPartySavedOption ? [this.thirdPartySavedOption] : [];\n
            this.specialTaxRegimeMode = data.special_tax_regime_id != null;\n
            this.thirdPartySearchTerm = '';\n
        },\n
        changeSpecialTaxRegimeMode(value) {\n
            if (value && (!this.specialTaxRegimeAvailable || this.form.payment_condition_id !== '01')) {\n
                this.specialTaxRegimeMode = false;\n
                this.$message.error('El régimen especial requiere una Factura interna al contado en Medios digitales DEMO.');\n
                return;\n
            }\n
            if (!value) this.form.fiscal_data.special_tax_regime_id = null;\n
        },\n
        openThirdPartyDialog(edit = false) {\n
            this.thirdPartyRecordId = edit ? this.form.third_party_id : null;\n
            const term = (this.thirdPartySearchTerm || '').trim();\n
            this.thirdPartyCreateInput = /^\d+$/.test(term) ? {number: term}\n
                : /^[VJEGPCR]-?\d/i.test(term) ? '' : term;\n
            this.showDialogThirdParty = true;\n
        },\n
        searchRemoteThirdParties(input) {\n
            this.thirdPartySearchTerm = input;\n
            return this.loadThirdParties(input);\n
        },\n
        changeSpecialTaxRegime(value) {\n
            if (value != null && (!this.specialTaxRegimeAvailable || this.form.payment_condition_id !== '01')) {\n
                this.form.fiscal_data.special_tax_regime_id = null;\n
                this.$message.error('El régimen especial requiere una Factura interna al contado en Medios digitales DEMO.');\n
            }\n
        },\n
        async thirdPartySaved(saved) {\n
            const options = await this.loadThirdParties(saved.rif || '');\n
            if (!options) return;\n
            if (options.some(row => row.id === saved.id)) this.form.third_party_id = saved.id;\n
            else {\n
                if (this.form.third_party_id === saved.id) this.form.third_party_id = null;\n
                this.$message.error('El cliente debe estar habilitado y marcado como tercero para seleccionarlo.');\n
            }\n
        },\n
        changeThirdPartyMode(value) {\n
            if (this.isUpdateDocument || (value && (!this.thirdPartyAvailable || this.form.payment_condition_id !== '01'))) {\n
                this.thirdPartyMode = this.originalThirdPartyInvoice;\n
                this.$message.error('Seleccione una Factura de venta interna al contado para facturar por terceros.');\n
                return;\n
            }\n
            this.form.third_party_id = null;\n
            this.thirdPartySearchSequence += 1;\n
            this.thirdPartySearchTerm = '';\n
            this.loadingThirdParties = false;\n
            if (value) this.loadThirdParties('');\n
        },\n
        async loadThirdParties(input = '') {\n
            if (!this.thirdPartyMode) return;\n
            const sequence = ++this.thirdPartySearchSequence;\n
            this.loadingThirdParties = true;\n
            try {\n
                const response = await this.$http.get('/documents/search/third-parties', {params: {input}});\n
                if (sequence !== this.thirdPartySearchSequence || !this.thirdPartyMode) return;\n
                const eligible = response.data.customers || [];\n
                const options = [...eligible];\n
                if (this.thirdPartySavedOption && !options.some(row => row.id === this.thirdPartySavedOption.id)) options.push(this.thirdPartySavedOption);\n
                this.thirdParties = options;\n
                return eligible;\n
            } catch (_) {\n
                if (sequence === this.thirdPartySearchSequence) this.$message.error('No se pudo cargar la lista de clientes terceros.');\n
            } finally {\n
                if (sequence === this.thirdPartySearchSequence) this.loadingThirdParties = false;\n
            }\n
        },\n
        normalizeAddressText(address) {\n
            return (address || '').trim().toLowerCase();\n
        },\n
        buildCustomerAddresses(customer) {\n
            if (!customer) {\n
                return [];\n
            }\n
\n
            const seen = new Set();\n
            const result = [];\n
\n
            (customer.addresses || [])\n
                .filter(el => !el.has_consigned)\n
                .forEach(addressRow => {\n
                    const normalized = this.normalizeAddressText(addressRow.address);\n
                    if (!normalized || seen.has(normalized)) {\n
                        return;\n
                    }\n
\n
                    seen.add(normalized);\n
                    result.push(addressRow);\n
                });\n
\n
            if (customer.address) {\n
                const normalizedPrincipal = this.normalizeAddressText(customer.address);\n
                if (normalizedPrincipal && !seen.has(normalizedPrincipal)) {\n
                    result.unshift({\n
                        id: null,\n
                        address: customer.address\n
                    });\n
                }\n
            }\n
\n
            return result;\n
        },\n
        selectDefaultCustomerAddress() {\n
            if (this.customer_addresses.length === 0) {\n
                this.form.customer_address_id = null;\n
                return;\n
            }\n
\n
            const mainAddress = _.find(this.customer_addresses, { main: 1 });\n
            const defaultAddress = mainAddress || this.customer_addresses[0];\n
            this.form.customer_address_id = defaultAddress.id;\n
        },\n
        // ───── Datos generales personalizables (DocumentFormLayout) ─────\n
        capturePinnedBar() {\n
            if (this.pinnedBarInstance || !this.$refs.pinnedBar) return;\n
            this.pinnedBarInstance = this.$refs.pinnedBar;\n
            this.pinnedBarReady = true;\n
        },\n
        isLayoutPinned(fieldKey) {\n
            return this.layoutPinnedKeysSet.has(fieldKey);\n
        },\n
        loadFormLayout() {\n
            return this.$http\n
                .get('/document-form-layout/invoice')\n
                .then(({ data }) => {\n
                    const remote = data && data.data && Array.isArray(data.data.pinned_fields)\n
                        ? data.data.pinned_fields\n
                        : [];\n
                    this.pinned_fields = remote.length > 0\n
                        ? remote\n
                        : getDocumentDefaultLayout('invoice');\n
                })\n
                .catch(() => {\n
                    this.pinned_fields = getDocumentDefaultLayout('invoice');\n
                });\n
        },\n
        enterLayoutEditFromHeader() {\n
            if (this.$refs.pinnedBar && typeof this.$refs.pinnedBar.enterEditMode === 'function') {\n
                this.$refs.pinnedBar.enterEditMode();\n
            }\n
        },\n
        resetLayoutFromHeader() {\n
            if (this.$refs.pinnedBar && typeof this.$refs.pinnedBar.resetLayout === 'function') {\n
                this.$refs.pinnedBar.resetLayout();\n
            }\n
        },\n
        confirmLayoutFromHeader() {\n
            if (this.$refs.pinnedBar && typeof this.$refs.pinnedBar.confirmEdit === 'function') {\n
                this.$refs.pinnedBar.confirmEdit();\n
            }\n
        },\n
        cancelLayoutEditFromHeader() {\n
            if (this.$refs.pinnedBar && typeof this.$refs.pinnedBar.cancelEdit === 'function') {\n
                this.$refs.pinnedBar.cancelEdit();\n
            }\n
        },\n
        pinFromForm(fieldKey) {\n
            if (this.$refs.pinnedBar && typeof this.$refs.pinnedBar.pinField === 'function') {\n
                this.$refs.pinnedBar.pinField(fieldKey);\n
            }\n
        },\n
        onSaveLayout(pinned, done) {\n
            this.layout_saving = true;\n
            this.$http\n
                .put('/document-form-layout/invoice', { pinned_fields: pinned })\n
                .then(response => {\n
                    if (response.data && response.data.success) {\n
                        this.pinned_fields = response.data.data.pinned_fields;\n
                        this.$message.success(response.data.message || 'Configuración guardada con éxito');\n
                        if (typeof done === 'function') done();\n
                    } else {\n
                        this.$message.error((response.data && response.data.message) || 'No se pudo guardar la configuración');\n
                    }\n
                })\n
                .catch(() => {\n
                    this.$message.error('No se pudo guardar la configuración');\n
                })\n
                .finally(() => {\n
                    this.layout_saving = false;\n
                });\n
        },\n
        sortOperationTypes(operationTypes) {\n
            const sorted = operationTypes.slice();\n
            const internalSaleIndex = sorted.findIndex(ot => ot.id === "0101");\n
            const itinerantIndex = sorted.findIndex(\n
                ot => ot.id === "0101_itinerant"\n
            );\n
\n
            if (\n
                internalSaleIndex !== -1 &&\n
                itinerantIndex !== -1 &&\n
                itinerantIndex !== internalSaleIndex + 1\n
            ) {\n
                const [itinerantOperation] = sorted.splice(itinerantIndex, 1);\n
                const newInternalSaleIndex = sorted.findIndex(\n
                    ot => ot.id === "0101"\n
                );\n
                sorted.splice(newInternalSaleIndex + 1, 0, itinerantOperation);\n
            }\n
\n
            return sorted;\n
        },\n
        syncSingleOperationTypeSelection() {\n
            if (this.operation_types_filter.length !== 1) return;\n
\n
            const operationType = this.operation_types_filter[0];\n
            const isCurrentItinerantOperation =\n
                operationType.id === "0101_itinerant" &&\n
                this.form.operation_type_id === "0101" &&\n
                this.is_itinerant_operation;\n
\n
            if (\n
                this.operation_type_id_view === operationType.id &&\n
                (operationType.id !== "0101_itinerant" ||\n
                    isCurrentItinerantOperation)\n
            ) return;\n
\n
            this.operation_type_id_view = operationType.id;\n
            this.changeOperationType();\n
        },\n
