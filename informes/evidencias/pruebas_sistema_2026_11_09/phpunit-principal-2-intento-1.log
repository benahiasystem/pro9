    /**\n
     * Devuelve los totales de la busqueda,\n
     *\n
     * Implementado en resources/js/views/tenant/documents/index.vue\n
     * @param Request $request\n
     *\n
     * @return array[]\n
     */\n
    public function recordsTotal(Request $request)\n
    {\n
        // ######## INICIO CAMBIO SOLO FACTURAS Y NOTAS DE VENTA ########\n
        return \App\Support\Exact\ReadSnapshot::run(DB::connection('tenant'), function () use ($request) {\n
            $D=\App\Support\Exact\Decimal::class;\n
            $types=DocumentType::whereIn('id',['01','07','08'])->get()->keyBy('id');\n
            $currencies=[Localization::nationalCurrencyId(),Localization::secondaryCurrencyId()];\n
            $totals=[];\n
            foreach ($types as $type) foreach ($currencies as $currency) $totals[$type->id][$currency]=$D::of(0);\n
            $records=$this->getRecords($request)->withoutEagerLoads()->reorder()->whereIn('document_type_id',$types->keys()->all())\n
                ->whereIn('currency_type_id',$currencies)->whereNotIn('state_type_id',['09','11'])\n
                ->select(['id','document_type_id','currency_type_id','total','calculation_snapshot']);\n
            foreach ($records->lazyById(500) as $document) {\n
                $type=$document->document_type_id; $currency=$document->currency_type_id;\n
                $totals[$type][$currency]=$totals[$type][$currency]->plus($D::readRequired($document,'total'));\n
            }\n
            $result=[];\n
            foreach (['01','07','08'] as $id) if ($types->has($id)) foreach ($currencies as $currency) {\n
                $value=$totals[$id][$currency];\n
                $result[]=['name'=>$types[$id]->description.' ('.$currency.')','document_type_id'=>$id,'currency_type_id'=>$currency,\n
                    'total'=>Localization::currencySymbol($currency).' '.$D::format($value),\n
                    'calculation_snapshot'=>$D::snapshot(['total'=>$value])];\n
            }\n
            return $result;\n
        });\n
        // ######## FIN CAMBIO SOLO FACTURAS Y NOTAS DE VENTA ########\n
    }\n
\n
    /** Indicadores del listado de facturas y cuentas por cobrar. */\n
    public function kpis(Request $request)\n
    {\n
        return \App\Support\Exact\ReadSnapshot::run(DB::connection('tenant'), function () {\n
        $valid_states = ['01', '03', '05', '07', '13'];\n
\n
        $today=Carbon::now()->startOfDay();\n
        $start_current=$today->copy()->startOfMonth()->toDateString();\n
        $end_current=$today->copy()->endOfMonth()->toDateString();\n
        $start_prev=$today->copy()->subMonthNoOverflow()->startOfMonth()->toDateString();\n
\n
        $D = \App\Support\Exact\Decimal::class;\n
        $sales_now=$D::of(0); $sales_prev=$D::of(0);\n
        $documents=Document::withoutEagerLoads()->where(fn ($q) => $q->whereTypeUser())\n
            ->whereIn('state_type_id',$valid_states)->where('document_type_id','01')\n
            ->whereBetween('date_of_issue',[$start_prev,$end_current])\n
            ->select(['id','date_of_issue','currency_type_id','exchange_rate_sale','total','calculation_snapshot']);\n
        foreach ($documents->lazyById(500) as $document) {\n
            $amount=$D::readRequired($document,'total');\n
            if ($document->currency_type_id !== 'VES') $amount=$amount->multipliedBy($D::readRequired($document,'exchange_rate_sale'));\n
            if ($document->date_of_issue->toDateString() >= $start_current) $sales_now=$sales_now->plus($amount);\n
            else $sales_prev=$sales_prev->plus($amount);\n
        }\n
        $variation=$sales_prev->isPositive() ? $sales_now->minus($sales_prev)->dividedBy($sales_prev)->multipliedBy(100)\n
            : $D::of($sales_now->isPositive() ? 100 : 0);\n
\n
        // ######## INICIO MONEDA DEL MEDIO DE COBRO ########\n
        // The receivables dataset reads exact documentary balances in batches\n
        // and applies the same user/seller scope as this indicator.\n
        $totals = ['total'=>$D::of(0), 'current'=>$D::of(0), 'overdue'=>$D::of(0)];\n
        $dueLimit = $today->copy()->addDays(30)->endOfDay();\n
        $receivables = \App\Support\Exact\Receivables::invoiceKpiDataset();\n
        foreach ($receivables as $row) {\n
            $ves = $D::readRequired($row, 'balance_ves_equivalent');\n
            $totals['total'] = $totals['total']->plus($ves);\n
            $due = $row['due_date_iso'];\n
            if ($due && Carbon::parse($due)->lt($today)) $totals['overdue'] = $totals['overdue']->plus($ves);\n
            elseif ($due && Carbon::parse($due)->lte($dueLimit)) $totals['current'] = $totals['current']->plus($ves);\n
        }\n
        // ######## FIN MONEDA DEL MEDIO DE COBRO ########\n
\n
        return [\n
            'sales' => [\n
                'total'        => 'Bs. ' . $D::format($sales_now),\n
                'facturas'     => 'Bs. ' . $D::format($sales_now),\n
                'variation'    => (!$variation->isNegative() ? '+' : '') . $D::format($variation,1) . '% vs mes anterior',\n
                'variation_up' => !$variation->isNegative(),\n
            ],\n
            'receivable' => [\n
                'total'   => 'Bs. ' . \App\Support\Exact\Decimal::format($totals['total']),\n
                'current' => 'Bs. ' . \App\Support\Exact\Decimal::format($totals['current']),\n
                'overdue' => 'Bs. ' . \App\Support\Exact\Decimal::format($totals['overdue']),\n
            ],\n
        ];\n
        });\n
    }\n
\n
    public function searchCustomers(Request $request)\n
    {\n
\n
        //tru de boletas en env esta en true filtra a los con dni   , false a todos\n
        $identity_document_type_id = $this->getIdentityDocumentTypeId($request->document_type_id, $request->operation_type_id);\n
//        $operation_type_id_id = $this->getIdentityDocumentTypeId($request->operation_type_id);\n
\n
        $customers = Person::where(function ($query) use ($request) {\n
            $query->where('number', 'like', "%{$request->input}%")\n
                ->orWhere('name', 'like', "%{$request->input}%");\n
        })\n
            ->whereType('customers')\n
            ->whereSalesIdentityActive(\App\Services\ExportInvoicePolicy::isExport($request->operation_type_id))\n
            ->orderBy('name')\n
            ->whereIn('identity_document_type_id', $identity_document_type_id)\n
            ->whereIsEnabled()\n
            ->whereFilterCustomerBySeller('customers')\n
            ->get()->transform(function ($row) {\n
                /** @var  Person $row */\n
                return $row->getCollectionData(true);\n
                /* Movido al modelo */\n
                return [\n
                    'id' => $row->id,\n
                    'description' => $row->number . ' - ' . $row->name,\n
                    'name' => $row->name,\n
                    'number' => $row->number,\n
                    'identity_document_type_id' => $row->identity_document_type_id,\n
                    'identity_document_type_code' => $row->identity_document_type->code,\n
                    'addresses' => $row->addresses,\n
                    'address' => $row->address\n
                ];\n
            });\n
        // dd($customers);\n
\n
        return compact('customers');\n
    }\n
