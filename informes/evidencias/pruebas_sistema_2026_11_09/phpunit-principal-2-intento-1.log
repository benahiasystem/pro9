    public function destroyDocument($document_id)\n
    {\n
        try {\n
\n
            DB::connection('tenant')->transaction(function () use ($document_id) {\n
\n
                $record = Document::findOrFail($document_id);\n
                $this->deleteAllPayments($record->payments);\n
                $record->delete();\n
\n
            });\n
\n
            return [\n
                'success' => true,\n
                'message' => 'Documento eliminado con éxito'\n
            ];\n
\n
        } catch (Exception $e) {\n
\n
            return ($e->getCode() == '23000') ? ['success' => false, 'message' => 'El Documento esta siendo usada por otros registros, no puede eliminar'] : ['success' => false, 'message' => 'Error inesperado, no se pudo eliminar el Documento'];\n
\n
        }\n
\n
\n
    }\n
