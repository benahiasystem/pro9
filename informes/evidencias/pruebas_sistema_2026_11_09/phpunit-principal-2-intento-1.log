    /**\n
     * @param \App\Http\Requests\Tenant\DocumentUpdateRequest $request\n
     * @param                                                 $id\n
     *\n
     * @return array\n
     * @throws \Throwable\n
     */\n
    public function update(DocumentUpdateRequest $request, $id)\n
    {\n
\n
        DocumentFiscalController::authorizeDocument(Document::findOrFail($id));\n
        $validate = $this->validateDocument($request);\n
        if (!$validate['success']) return $validate;\n
\n
        $fact = DB::connection('tenant')->transaction(function () use ($request, $id) {\n
            $facturalo = (new Facturalo())->forWebDocuments();\n
            $facturalo->update($request->all(), $id);\n
            $facturalo->createPdf();\n
\n
            return $facturalo;\n
        });\n
\n
        $document = $fact->getDocument();\n
        $response = $fact->getResponse();\n
        $edit = \App\Services\Fiscal\DocumentEditPolicy::view($document);\n
\n
        return [\n
            'success' => true,\n
            'message' => 'Factura actualizada. Los cobros registrados se conservaron. El envío HKA se realiza desde Enviar HKA.',\n
            'data' => array_merge($edit, \App\Services\ThirdPartyInvoicePolicy::view($document), \App\Services\SpecialTaxRegimePolicy::view($document), [\n
                'id' => $document->id,\n
                'is_editable' => $edit['can_edit'],\n
                'iva_retention' => \App\Services\Fiscal\IvaRetentionService::view($document),\n
                'islr_retention' => \App\Services\Fiscal\IslrRetentionService::view($document),\n
                    'fiscal_emission' => \App\Services\Fiscal\DocumentEmissionView::forDocument($document),\n
                'response' => $response,\n
            ]),\n
        ];\n
    }\n
