} from './_document_form_fields_catalog';\n
\n
const RemoteSlot = {\n
    name: 'RemoteSlot',\n
    functional: true,\n
    props: {\n
        source: { type: Object, default: null },\n
        slotName: { type: String, required: true },\n
        slotScopeData: { type: Object, default: () => ({}) },\n
    },\n
    render(h, ctx) {\n
        const src = ctx.props.source;\n
        const slot = src && src.$scopedSlots ? src.$scopedSlots[ctx.props.slotName] : null;\n
        const content = typeof slot === 'function' ? slot(ctx.props.slotScopeData) : slot;\n
        return h('div', { class: 'relocated-field-slot' }, content || []);\n
    },\n
};\n
\n
export default {\n
    props: [\n
        "idUser",\n
        "initialContingency",\n
        "typeUser",\n
        "configuration",\n
        "documentId",\n
        "table",\n
        "tableId",\n
        "isUpdate",\n
        "authUser"\n
    ],\n
    components: { IgtfPaymentFields, InvoiceCollectionSection,\n
        StoreItemSeriesIndex,\n
        DocumentFormItem,\n
        PersonForm,\n
        DocumentOptions,\n
        Logo,\n
        DocumentHotelForm,\n
        Keypress,\n
        // ########## INICIO SIN DETRACCIONES E ISC\n
        // ######### FIN SIN DETRACCIONES E ISC\n
        DocumentTransportForm,\n
        DocumentReportCustomer,\n
        SetTip,\n
        LotsForm,\n
        LotsGroup,\n
        ItemSearchQuickSale,\n
        // ItemDetailForm,\n
        PackItemDescription,\n
        DocumentFormPreview,\n
        ConsignedForm,\n
