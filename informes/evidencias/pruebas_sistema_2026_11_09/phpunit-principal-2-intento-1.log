    public function show($documentId)\n
    {\n
        $document = Document::with(['items', 'emission', 'received_retentions', 'guarantee_fund'])->findOrFail($documentId);\n
        DocumentFiscalController::authorizeDocument($document);\n
        foreach ($document->items as &$item) {\n
            $discounts = [];\n
            if($item->discounts) {\n
                foreach ($item->discounts as $discount) {\n
                    $discount_type = ChargeDiscountType::query()->find($discount->discount_type_id);\n
                    $discounts[] = [\n
                        'amount' => $discount->amount,\n
                        'base' => $discount->base,\n
                        'description' => $discount->description,\n
                        'discount_type_id' => $discount->discount_type_id,\n
                        'factor' => $discount->factor,\n
                        'percentage' => $discount->factor * 100,\n
                        'is_amount' => false,\n
                        'discount_type' => $discount_type\n
                    ];\n
                }\n
            }\n
            $item->discounts = $discounts;\n
        }\n
\n
        return response()->json([\n
            'data' => array_merge($document->toArray(), \App\Services\Fiscal\DocumentEditPolicy::view($document), \App\Services\ThirdPartyInvoicePolicy::view($document), \App\Services\SpecialTaxRegimePolicy::view($document), ['iva_retention' => \App\Services\Fiscal\IvaRetentionService::view($document), 'islr_retention'=>\App\Services\Fiscal\IslrRetentionService::view($document),\n
                    'fiscal_emission' => \App\Services\Fiscal\DocumentEmissionView::forDocument($document)]),\n
            'success' => true,\n
        ], 200);\n
    }\n
