            return \App\Support\Exact\ReadSnapshot::run(DB::connection('tenant'), function () use ($request) {\n
                $collection = new DocumentCollection($this->getRecords($request)->paginate(config('tenant.items_per_page')));\n
                $response = $collection->response($request);\n
                $body = $response->getData(true);\n
                $body['totals'] = $this->recordsTotal($request);\n
                return response()->json($body, $response->getStatusCode());\n
            });\n
        }\n
        $auth_id = auth()->user()->id;\n
        $cacheParams = [\n
            'category_id' => $request->category_id,\n
            'page' => $request->page,\n
            'customer_id' => $request->customer_id,\n
            'd_end' => $request->d_end,\n
            'd_start' => $request->d_start,\n
            'date_of_issue' => $request->date_of_issue,\n
            'document_type_id' => $request->document_type_id,\n
            'item_id' => $request->item_id,\n
            'number' => $request->number,\n
            'control_number' => $request->control_number,\n
            'observations' => $request->observations,\n
            'pending_payment' => $request->pending_payment,\n
            'series' => $request->series,\n
            'state_type_id' => $request->state_type_id,\n
            'purchase_order' => $request->purchase_order,\n
            'guides' => $request->guides,\n
            'plate_numbers' => $request->plate_numbers,\n
        ];\n
        $cacheKey = \App\Services\Fiscal\DocumentEmissionView::cacheNamespace() . ':document_list_' . "user-$auth_id" . "_" . md5(json_encode($cacheParams));\n
        if ($this->pingCache()) {\n
            return $this->cacheWithTagKey(\n
                $cacheKey,\n
                ['document_list'], // Etiqueta para el detalle del item\n
                300, // 1 hora (el detalle cambia menos frecuentemente que las listas)\n
                fn () => new DocumentCollection($this->getRecords($request)->paginate(config('tenant.items_per_page'))),\n
                [ 'section' => 'Document List', 'filters' => $cacheParams ] // Contexto adicional para logging\n
            );\n
        } else {\n
            return new DocumentCollection($this->getRecords($request)->paginate(config('tenant.items_per_page')));\n
        }\n
        // $records = $this->getRecords($request);\n
\n
\n
        // return new DocumentCollection($records->paginate(config('tenant.items_per_page')));\n
