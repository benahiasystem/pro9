    public function table($table)\n
    {\n
        if ($table === 'customers') {\n
            $customers = Person::with('addresses')\n
                ->whereType('customers')\n
                ->whereSalesIdentityActive()\n
                ->whereIsEnabled()\n
                ->orderBy('name')\n
                ->take(20)\n
                ->get()->transform(function ($row) {\n
                    /** @var Person $row */\n
                    return $row->getCollectionData();\n
                    /** Se ha movido la salida, al modelo */\n
                    return [\n
                        'id' => $row->id,\n
                        'description' => $row->number . ' - ' . $row->name,\n
                        'name' => $row->name,\n
                        'number' => $row->number,\n
                        'identity_document_type_id' => $row->identity_document_type_id,\n
                        'identity_document_type_code' => $row->identity_document_type->code,\n
                        'addresses' => $row->addresses,\n
                        'address' => $row->address,\n
                        'internal_code' => $row->internal_code,\n
                    ];\n
\n
                });\n
            return $customers;\n
        }\n
\n
        if ($table === 'prepayment_documents') {\n
            $prepayment_documents = Document::whereHasPrepayment()->get()->transform(function ($row) {\n
\n
                $total = round($row->pending_amount_prepayment, 2);\n
                // ########## INICIO CAMBIO AFECTACIÓN IVA\n
                $amount = ($row->affectation_type_prepayment == '10')\n
                    ? round($total / \App\Support\Venezuela\Localization::taxMultiplier(), 2)\n
                    : $total;\n
                // ######### FIN CAMBIO AFECTACIÓN IVA\n
\n
                return [\n
                    'id' => $row->id,\n
                    'description' => $row->number_full,\n
                    'series' => $row->series,\n
                    'number' => $row->number,\n
                    'document_type_id' => ($row->document_type_id == '01') ? '02' : '03',\n
                    // 'amount' => $row->total_value,\n
                    // 'total' => $row->total,\n
                    'amount' => $amount,\n
                    'total' => $total,\n
\n
                ];\n
            });\n
            return $prepayment_documents;\n
        }\n
\n
        if ($table === 'payment_method_types') {\n
            // ######### INICIO CATÁLOGO MÉTODOS DE PAGO VENEZUELA #########\n
            return PaymentMethodType::getPaymentMethodTypes();\n
            // ######### FIN CATÁLOGO MÉTODOS DE PAGO VENEZUELA #########\n
        }\n
\n
        if ($table === 'items') {\n
\n
            return SearchItemController::getItemsToDocuments();\n
\n
            $establishment_id = auth()->user()->establishment_id;\n
            $warehouse = ModuleWarehouse::where('establishment_id', $establishment_id)->first();\n
            // $items_u = Item::whereWarehouse()->whereIsActive()->whereNotIsSet()->orderBy('description')->take(20)->get();\n
            $items_u = Item::with('warehousePrices')\n
                ->whereIsActive()\n
                ->orderBy('description');\n
            $items_s = Item::with('warehousePrices')\n
                ->where('items.unit_type_id', 'SERV')\n
                ->whereIsActive()\n
                ->orderBy('description');\n
            $items_u = $items_u\n
                ->take(20)\n
                ->get();\n
            $items_s = $items_s\n
                ->take(10)\n
                ->get();\n
            $items = $items_u->merge($items_s);\n
\n
            return collect($items)->transform(function ($row) use ($warehouse) {\n
                /** @var Item $row */\n
                return $row->getDataToItemModal($warehouse);\n
                $detail = $this->getFullDescription($row, $warehouse);\n
                return [\n
                    'id' => $row->id,\n
                    'full_description' => $detail['full_description'],\n
                    'model' => $row->model,\n
                    'brand' => $detail['brand'],\n
                    'warehouse_description' => $detail['warehouse_description'],\n
                    'category' => $detail['category'],\n
                    'stock' => $detail['stock'],\n
                    'internal_id' => $row->internal_id,\n
                    'description' => $row->description,\n
                    'currency_type_id' => $row->currency_type_id,\n
                    'currency_type_symbol' => $row->currency_type->symbol,\n
                    'sale_unit_price' => Item::getSaleUnitPriceByWarehouse($row, $warehouse->id),\n
                    'purchase_unit_price' => $row->purchase_unit_price,\n
                    'unit_type_id' => $row->unit_type_id,\n
                    'sale_affectation_igv_type_id' => $row->sale_affectation_igv_type_id,\n
                    'purchase_affectation_igv_type_id' => $row->purchase_affectation_igv_type_id,\n
                    'calculate_quantity' => (bool)$row->calculate_quantity,\n
                    'has_igv' => (bool)$row->has_igv,\n
                    'item_unit_types' => collect($row->item_unit_types)->transform(function ($row) {\n
                        return [\n
                            'id' => $row->id,\n
                            'description' => "{$row->description}",\n
                            'item_id' => $row->item_id,\n
                            'unit_type_id' => $row->unit_type_id,\n
                            'quantity_unit' => $row->quantity_unit,\n
                            'price1' => $row->price1,\n
                            'price2' => $row->price2,\n
                            'price3' => $row->price3,\n
                            'price_default' => $row->price_default,\n
                        ];\n
                    }),\n
                    'warehouses' => collect($row->warehouses)->transform(function ($row) use ($warehouse) {\n
                        return [\n
                            'warehouse_description' => $row->warehouse->description,\n
                            'stock' => $row->stock,\n
                            'warehouse_id' => $row->warehouse_id,\n
                            'checked' => ($row->warehouse_id == $warehouse->id) ? true : false,\n
                        ];\n
                    }),\n
                    'attributes' => $row->attributes ? $row->attributes : [],\n
                    'lots_group' => collect($row->lots_group)->transform(function ($row) {\n
                        return [\n
                            'id' => $row->id,\n
                            'code' => $row->code,\n
                            'quantity' => $row->quantity,\n
                            'date_of_due' => $row->date_of_due,\n
                            'checked' => false\n
                        ];\n
                    }),\n
                    'lots' => [],\n
                    'lots_enabled' => (bool)$row->lots_enabled,\n
                    'series_enabled' => (bool)$row->series_enabled,\n
\n
                ];\n
            });\n
        }\n
\n
        return [];\n
    }\n
\n
    public function getFullDescription($row, $warehouse)\n
    {\n
\n
        $desc = ($row->internal_id) ? $row->internal_id . ' - ' . $row->description : $row->description;\n
        $category = ($row->category) ? "{$row->category->name}" : "";\n
        $brand = ($row->brand) ? "{$row->brand->name}" : "";\n
\n
\n
        if ($row->unit_type_id != 'SERV') {\n
            if (isset($row['stock'])) {\n
                $warehouse_stock = number_format($row['stock'], 2);\n
            } else {\n
                $warehouse_stock = ($row->warehouses && $warehouse) ?\n
                    number_format($row->warehouses->where('warehouse_id', $warehouse->id)->first()->stock, 2) :\n
                    0;\n
            }\n
\n
            $stock = ($row->warehouses && $warehouse) ? "{$warehouse_stock}" : "";\n
        } else {\n
            $stock = '';\n
        }\n
\n
        $desc = "{$desc} - {$brand}";\n
\n
        return [\n
            'full_description' => $desc,\n
            'brand' => $brand,\n
            'category' => $category,\n
            'stock' => $stock,\n
            'warehouse_description' => $warehouse->description,\n
        ];\n
    }\n
\n
