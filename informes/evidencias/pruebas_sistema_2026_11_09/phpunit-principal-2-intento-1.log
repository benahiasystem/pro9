\n
                this.seller_class =\n
                    this.user == "admin" ? "col-lg-4 pb-2" : "col-lg-6 pb-2";\n
                this.global_discount_types = response.data.global_discount_types;\n
\n
                // this.default_document_type = response.data.document_id;\n
                // this.default_series_type = response.data.series_id;\n
                this.selectDocumentType();\n
                this.changeEstablishment();\n
                this.changeDateOfIssue();\n
                this.changeDocumentType();\n
                this.changeDestinationSale();\n
                this.setDefaultDocumentType();\n
                this.setConfigGlobalDiscountType();\n
                this.startConnectionQzTray();\n
                this.verifySelectedSeller();\n
            });\n
        },\n
\n
