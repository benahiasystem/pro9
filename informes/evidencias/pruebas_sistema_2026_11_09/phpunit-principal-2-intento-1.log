    /**\n
     * Guarda los datos del hijo para el proceso de suscripcion. #952\n
     * Toma el valor de nota de venta y lo pasa para la boleta/factura\n
     *\n
     * @param $data\n
     */\n
    public static function setChildrenToData(&$data)\n
    {\n
        $request = request();\n
        if (\n
            $request != null &&\n
            $request->has('sale_note_id') &&\n
            $request->sale_note_id\n
        ) {\n
            $saleNote = SaleNote::find($request->sale_note_id);\n
            if ($saleNote != null && isset($data['customer'])) {\n
                $customer = $data['customer'];\n
                $customerNote = (array)$saleNote->customer;\n
                if (isset($customerNote['children'])) {\n
                    $customer['children'] = (array)$customerNote['children'];\n
                }\n
                $data['customer'] = $customer;\n
                $data['grade'] = $saleNote->getGrade();\n
                $data['section'] = $saleNote->getSection();\n
            }\n
        }\n
    }\n
    private function aplicarItineranciaSiCorresponde(array &$data)\n
    {\n
        $is_itinerant = (int) ($data['is_itinerant'] ?? 0);\n
\n
        if (\n
            ($data['invoice']['operation_type_id'] ?? null) === '0101' &&\n
            $is_itinerant === 1\n
        ) {\n
            $data['legends'][] = [\n
                'code' => '2005',\n
                'value' => 'Venta realizada por emisor itinerante',\n
            ];\n
\n
            // Campos a copiar del cliente al establecimiento\n
            // $fields = ['address', 'department_id', 'province_id', 'district_id', 'department', 'province', 'district'];\n
\n
            // foreach ($fields as $field) {\n
            //     if (isset($data['customer'][$field])) {\n
            //         $data['establishment'][$field] = $data['customer'][$field];\n
            //     }\n
            // }\n
\n
            // // Establecer claves directas\n
            // $data['establishment_address'] = $data['customer']['address'];\n
            // $data['establishment_department_id'] = $data['customer']['department_id'];\n
            // $data['establishment_province_id'] = $data['customer']['province_id'];\n
            // $data['establishment_district_id'] = $data['customer']['district_id'];\n
        }\n
\n
        $data['is_itinerant'] = $is_itinerant === 1;\n
    }\n
\n
    /**\n
     * @param array $data\n
     *\n
     * @return array\n
     * @throws \Throwable\n
     */\n
        public function storeWithData($data, bool $webExportInvoices = false, bool $deferPdfUntilCommit = false)\n
        {\n
            $this->aplicarItineranciaSiCorresponde($data);\n
            self::setChildrenToData($data);\n
            $fact = DB::connection('tenant')->transaction(function () use ($data, $webExportInvoices, $deferPdfUntilCommit) {\n
                $facturalo = new Facturalo();\n
                if ($webExportInvoices) $facturalo->forWebDocuments();\n
                $facturalo->save($data);\n
                if ($deferPdfUntilCommit) {\n
                    DB::connection('tenant')->afterCommit(function () use ($facturalo) {\n
                        try { $facturalo->createPdf(); }\n
                        catch (\Throwable $e) { \Log::warning('No se pudo generar el PDF de la factura de Hotel después del cierre.', ['document_id'=>$facturalo->getDocument()->id, 'error'=>get_class($e)]); }\n
                    });\n
                } else {\n
                    $facturalo->createPdf();\n
                }\n
                return $facturalo;\n
            });\n
\n
            $document = $fact->getDocument();\n
            $response = $fact->getResponse();\n
            return [\n
                'success' => true,\n
                'message' => 'Venta guardada.',\n
                'data' => [\n
                    'id' => $document->id,\n
                    ...\App\Services\ThirdPartyInvoicePolicy::view($document),\n
                    ...\App\Services\SpecialTaxRegimePolicy::view($document),\n
                    'note_refunds' => \App\Services\Fiscal\NoteRefund::view($document),\n
                    'note_adjustments' => \App\Services\Fiscal\NoteAdjustment::view($document),\n
                    'number_full' => $document->number_full,\n
                    'response' => $response,\n
                    'iva_retention' => \App\Services\Fiscal\IvaRetentionService::view($document),\n
                    'islr_retention' => \App\Services\Fiscal\IslrRetentionService::view($document),\n
                    'fiscal_emission' => \App\Services\Fiscal\DocumentEmissionView::forDocument($document),\n
                    'email_delivery' => \App\Services\Fiscal\HkaMail::view($document),\n
                    'pdf_downloads' => \App\Services\Fiscal\HkaPdf::view($document, false),\n
                ],\n
                'links' => [\n
                    'print_ticket' => url('')."/print/document/{$document->external_id}/ticket"\n
                ]\n
            ];\n
        }\n
\n
    private function associateDispatchesToDocument(Request $request, int $documentId)\n
    {\n
        $dispatches_relateds = $request->dispatches_relateds;\n
        if (!$dispatches_relateds) return;\n
        $invoice = Document::findOrFail($documentId);\n
        foreach ($dispatches_relateds as $reference) {\n
            $parts = \App\Services\Fiscal\FiscalIdentity::parseNumberFull((string) $reference);\n
            if ($parts === null) continue;\n
            $dispatch = Dispatch::where('establishment_id', $invoice->establishment_id)\n
                ->where('fiscal_environment', $invoice->fiscal_environment)\n
                ->where('document_type_id', '09')\n
                ->where('series', \App\Services\SeriesNumbering::normalizeCode($parts[0]))\n
                ->where('number', $parts[1])->first();\n
            if ($dispatch) {\n
                $dispatch->update(['reference_document_id' => $documentId]);\n
                (new Facturalo())->createPdf($dispatch, 'dispatch', 'a4');\n
            }\n
        }\n
    }\n
