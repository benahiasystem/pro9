        async processItemsForNotesNotGroup() {\n
            let itemsNotGroupForNotes = localStorage.getItem(\n
                "itemsNotGroupForNotes"\n
            );\n
\n
            if (itemsNotGroupForNotes) {\n
                let itemsParsed = JSON.parse(itemsNotGroupForNotes);\n
\n
                // prepare - validate prop presentation and others\n
                this.form.items = await this.onPrepareItems(itemsParsed).map(\n
                    element => {\n
                        element.item.presentation = element.item.presentation\n
                            ? element.item.presentation\n
                            : [];\n
                        return element;\n
                    }\n
                );\n
\n
                await this.calculateTotal();\n
                localStorage.removeItem("itemsNotGroupForNotes");\n
            }\n
        },\n
        setItemFromResponse(item, itemsParsed, sum_quantity = false) {\n
            /* Obtiene el igv del item, si no existe, coloca el gravado*/\n
            if (item.sale_affectation_igv_type !== undefined) {\n
                item.affectation_igv_type = item.sale_affectation_igv_type;\n
            } else {\n
                item.affectation_igv_type = {\n
                    active: 1,\n
                    description: "Gravado - Operación Onerosa",\n
                    exportation: 0,\n
                    free: 0,\n
                    id: "10"\n
                };\n
            }\n
            item.presentation = {};\n
\n
            item.item = {\n
\n
                attributes: item.attributes,\n
                brand: item.brand,\n
                calculate_quantity: item.calculate_quantity,\n
                category: item.category,\n
                currency_type_id: item.currency_type_id,\n
                currency_type_symbol: item.currency_type_symbol,\n
                description: item.description,\n
                full_description: item.full_description,\n
                has_igv: item.has_igv,\n
\n
                id: item.id,\n
                internal_id: item.internal_id,\n
                item_unit_types: item.item_unit_types,\n
                lots: item.lots,\n
                lots_enabled: item.lots_enabled,\n
                lots_group: item.lots_group,\n
                model: item.model,\n
                presentation: {},\n
                purchase_affectation_igv_type_id:\n
                    item.purchase_affectation_igv_type_id,\n
                purchase_unit_price: item.purchase_unit_price,\n
                sale_affectation_igv_type_id: item.sale_affectation_igv_type_id,\n
                sale_unit_price: item.sale_unit_price,\n
                series_enabled: item.series_enabled,\n
                stock: item.stock,\n
                unit_price: item.sale_unit_price,\n
                unit_type_id: item.unit_type_id,\n
                warehouses: item.warehouses\n
            };\n
            item.IdLoteSelected = null;\n
            if (item.affectation_igv_type_id === undefined) {\n
                item.affectation_igv_type_id = item.affectation_igv_type.id;\n
                // item.affectation_igv_type_id = "10";\n
            }\n
            item.discounts = [];\n
            item.charges = [];\n
            item.item_id = item.id;\n
            item.unit_price_value = item.sale_unit_price;\n
            item.input_unit_price_value = item.sale_unit_price;\n
\n
            item.quantity = 1;\n
\n
            if (sum_quantity) {\n
                const quantity_from_item_response = this.getQuantityFromItemResponse(\n
                    item,\n
                    itemsParsed\n
                );\n
                if (quantity_from_item_response > 0)\n
                    item.quantity = quantity_from_item_response;\n
            } else {\n
                let tempItem = itemsParsed.find(\n
                    ip => ip.item_id == item.id || ip.id == item.id\n
                );\n
                if (tempItem !== undefined) {\n
                    item.quantity = tempItem.quantity;\n
                }\n
            }\n
\n
            // item.quantity = itemsParsed.find(ip => ip.item_id == item.id).quantity;\n
            item.warehouse_id = null;\n
\n
            if (itemsParsed.length) {\n
                let itemParsed = itemsParsed.find(\n
                    element => element.id == item.item.id\n
                );\n
                if (itemParsed) {\n
                    item.item.unit_price = itemParsed.unit_price;\n
                }\n
            }\n
\n
            return item;\n
        },\n
        getQuantityFromItemResponse(item, itemsParsed) {\n
            const group_items = itemsParsed.filter(\n
                ip => ip.item_id == item.id || ip.id == item.id\n
            );\n
\n
            return exactSum(group_items.map(row=>exactValue(row,'quantity'))).decimal();\n
        },\n
        disabledSeries() {\n
            return (\n
                this.configuration.restrict_series_selection_seller &&\n
                this.typeUser !== "admin"\n
            );\n
        },\n
        // #307 Ajuste para seleccionar automaticamente el tipo de comprobante y serie\n
        setDefaultDocumentType(from_function) {\n
            if (this.authUser.multiple_default_document_types) return;\n
            if (this.shouldProtectPreloadedCustomer()) return;\n
\n
            this.default_series_type = this.config.user.serie;\n
            this.default_document_type = this.config.user.document_id;\n
            // if (this.default_document_type === undefined) this.default_document_type = null;\n
            // if (this.default_series_type === undefined) this.default_series_type = null;\n
\n
            let alt = _.find(this.document_types, {\n
                id: this.default_document_type\n
            });\n
            if (this.default_document_type !== null && alt !== undefined) {\n
                this.form.document_type_id = this.default_document_type;\n
                this.changeDocumentType();\n
                alt = _.find(this.series, { id: this.default_series_type });\n
                if (this.default_series_type !== null && alt !== undefined) {\n
                    this.form.series_id = this.default_series_type;\n
                }\n
            }\n
        },\n
        onPrepareDataEstablishment(data) {\n
            if (this.isFromExternalDocument) {\n
                this.form.establishment_id = this.establishment.id;\n
            } else {\n
                this.form.establishment_id = data.establishment_id;\n
            }\n
        },\n
        async onSetFormData(data) {\n
            // carga informacion de un documento previo al formulario\n
            // console.log('onSetFormData')\n
            this.currency_type = await _.find(this.currency_types, {\n
                id: data.currency_type_id\n
            });\n
\n
            /*\n
            this.form.establishment_id = data.establishment_id;\n
            */\n
\n
            this.onPrepareDataEstablishment(data);\n
\n
            this.form.document_type_id = data.document_type_id;\n
\n
            this.customers = this.customers.filter(el => el.id !== data.customer_id)\n
            this.customers.push(data.customer)\n
\n
            if (this.isGeneratedFromExternal && data.customer) {\n
                this.all_customers = this.all_customers.filter(el => el.id !== data.customer_id)\n
                this.all_customers.push(data.customer)\n
            }\n
\n
            this.form.can_edit = data.can_edit;\n
            this.form.edit_block_reason = data.edit_block_reason;\n
            this.existingPayments = JSON.parse(JSON.stringify(data.payments || []));\n
            this.existingRetentions = data.received_retentions || [];\n
            this.existingGuaranteeFund = data.guarantee_fund || null;\n
            this.form.id = data.id;\n
            this.form.custom_fields_data = data.custom_fields_data;\n
            this.form.number = data.number;\n
            this.form.date_of_issue = moment(data.date_of_issue).format(\n
                "YYYY-MM-DD"\n
            );\n
            this.form.date_of_due = moment((data.invoice && data.invoice.date_of_due) || data.date_of_due || data.date_of_issue).format("YYYY-MM-DD");\n
            this.form.time_of_issue = data.time_of_issue;\n
            this.form.customer_id = data.customer_id;\n
\n
            if (this.isGeneratedFromExternal && data.customer_id) {\n
                this.preloadedCustomerId = data.customer_id;\n
                this.preloadedCustomer = data.customer || null;\n
            }\n
\n
            this.form.currency_type_id = data.currency_type_id;\n
            this.form.exchange_rate_sale = data.exchange_rate_sale;\n
            this.form.external_id = data.external_id;\n
            this.form.filename = data.filename;\n
            this.form.group_id = data.group_id;\n
\n
            this.form.note = data.note;\n
            this.restoreFiscalOptions(data);\n
            this.form.plate_number = data.plate_number;\n
            this.form.payments = data.payments || [];\n
            this.form.prepayments = data.prepayments || [];\n
            this.form.legends = [];\n
            this.form.sale_notes_relateds = data.sale_notes_relateds\n
                ? data.sale_notes_relateds\n
                : null;\n
            this.form.affectation_type_prepayment =\n
                data.affectation_type_prepayment;\n
            this.form.purchase_order = data.purchase_order;\n
            this.form.pending_amount_prepayment =\n
                data.pending_amount_prepayment || 0;\n
            this.form.payment_method_type_id = data.payment_method_type_id;\n
            this.form.charges = Object.values(data.charges || []);\n
            // this.form.discounts = this.prepareDataGlobalDiscount(data);\n
            // this.form.discounts = data.discounts || [];\n
            this.form.seller_id = data.seller_id;\n
            this.form.items = this.onPrepareItems(data.items);\n
            // this.series = this.onSetSeries(data.document_type_id, data.series);\n
            this.form.state_type_id = data.state_type_id;\n
            this.form.total_discount = String(data.total_discount ?? "0");\n
            this.form.total_exonerated = String(data.total_exonerated ?? "0");\n
            this.form.total_exportation = String(data.total_exportation ?? "0");\n
\n
            this.form.total_igv = String(data.total_igv ?? "0");\n
\n
\n
            this.form.total_base_other_taxes = String(data.total_base_other_taxes ?? '0');\n
            this.form.total_other_taxes = String(data.total_other_taxes ?? "0");\n
\n
            this.form.total_prepayment = String(data.total_prepayment ?? "0");\n
            this.form.total_taxed = String(data.total_taxed ?? "0");\n
            this.form.total_taxes = String(data.total_taxes ?? "0");\n
\n
            this.form.total_value = String(data.total_value ?? "0");\n
            this.form.total_charge = String(data.total_charge ?? "0");\n
            this.form.total = String(data.total ?? "0");\n
            this.form.subtotal = String(data.subtotal ?? "0");\n
\n
            this.form.operation_type_id = data.invoice\n
                ? data.invoice.operation_type_id\n
                : data.operation_type_id;\n
            if (this.isExportInvoice) {\n
                this.total_global_charge = exactSum(this.form.charges.map(charge => exactAmount(charge.amount_exact ?? charge.amount ?? '0'))).decimal();\n
            }\n
            this.form.terms_condition = data.terms_condition || "";\n
            this.form.guides = data.guides || [];\n
            this.form.show_terms_condition = data.terms_condition\n
                ? true\n
                : false;\n
            this.form.attributes = [];\n
            this.form.customer = data.customer;\n
            this.form.has_prepayment = false;\n
            this.form.actions = {\n
                format_pdf: "a4"\n
            };\n
            this.form.hotel = {};\n
            this.form.transport = {};\n
            this.form.customer_address_id = null;\n
            this.form.type = "invoice";\n
            this.form.invoice = {\n
                operation_type_id: data.invoice\n
                    ? data.invoice.operation_type_id\n
                    : data.operation_type_id,\n
                date_of_due: data.invoice\n
                    ? data.invoice.date_of_due\n
                    : data.date_of_due\n
            };\n
            // this.form.payment_condition_id = '01';\n
\n
            let is_credit_installments = await _.find(data.fee, {\n
                payment_method_type_id: null\n
            });\n
            this.form.payment_condition_id = is_credit_installments\n
                ? "03"\n
                : data.payment_condition_id;\n
            this.form.fee = data.fee;\n
\n
\n
            this.form.quotation_id = data.quotation_id;\n
\n
            if (data.discounts && data.discounts[0]) {\n
                this.recordDiscountsGlobal = data.discounts[0]\n
                let discount_type_id = data.discounts[0].discount_type_id\n
                if (this.isExportInvoice) {\n
                    this.prepareDataGlobalDiscount(data);\n
                } else {\n
                    this.total_global_discount = discount_type_id !== "02" ? data.total_discount :\n
                        exactAmount(data.total_discount).times(exactAmount(1).plus(this.percentage_igv)).decimal();\n
                }\n
            }\n
\n
\n
            this.form.additional_information = this.onPrepareAdditionalInformation(\n
                data.additional_information\n
            );\n
\n
            // if (this.enabled_discount_global) {\n
            //     let discount_global =\n
            //         this.configuration.global_discount_type_id === "02" &&\n
            //         this.configuration.exact_discount\n
            //             ? _.round(\n
            //                   parseFloat(\n
            //                       (data.total_discount * 1.18).toFixed(3)\n
            //                   ),\n
            //                   2\n
            //               )\n
            //             : data.total_discount;\n
            //     this.total_global_discount = discount_global;\n
            // }\n
\n
            // this.form.additional_information = data.additional_information;\n
            // this.form.fee = [];\n
\n
\n
            if (!data.guides) {\n
                this.clickAddInitGuides();\n
            }\n
\n
            if (this.isGeneratedFromExternal) {\n
                this.preparePaymentsFee(data);\n
            }\n
\n
            await this.reloadDataCustomers(this.form.customer_id);\n
\n
            this.establishment = data.establishment;\n
\n
            await this.changeDateOfIssue();\n
            // await this.filterCustomers();\n
            this.updateChangeDestinationSale();\n
\n
            this.prepareDataCustomer();\n
\n
            this.regenerateItems();\n
            this.calculateTotal();\n
            // this.currency_type = _.find(this.currency_types, {'id': this.form.currency_type_id})\n
\n
            if (this.table === "quotations") {\n
                this.changeDocumentType();\n
            } else if (this.isUpdateDocument) {\n
                this.filterSeries(this.onSetSeriesId(data.document_type_id, data.series));\n
            } else {\n
                this.filterSeriesForTable();\n
            }\n
            if (!this.form.custom_fields_data) {\n
                this.$set(this.form, 'custom_fields_data', {});\n
            }\n
        },\n
        filterSeriesForTable() {\n
            if (this.table) {\n
                this.filterSeries();\n
            }\n
        },\n
        regenerateItems(){\n
            let items = [];\n
            this.form.items.forEach(row => {\n
                items.push(\n
                    calculateRowItem(\n
                        row,\n
                        this.form.currency_type_id,\n
                        this.form.exchange_rate_sale,\n
                        this.percentage_igv, this.isExportInvoice\n
                    )\n
                );\n
            });\n
            this.form.items = items;\n
        },\n
        preparePaymentsFee(data) {\n
            if (this.isCreditPaymentCondition) {\n
                // credito\n
                if (this.form.payment_condition_id === "02") {\n
                    this.clickAddFeeNew();\n
                    const index = 0;\n
                    this.readonly_date_of_due = true;\n
\n
                    this.form.fee[index].payment_method_type_id =\n
                        data.document_payment_method_type.id;\n
                    this.changePaymentMethodType(index, true);\n
                }\n
            }\n
        },\n
        prepareDataGlobalDiscount(data) {\n
            const discounts = data.discounts\n
                ? Object.values(data.discounts)\n
                : [];\n
\n
            if (discounts.length === 1) {\n
                if (\n
                    discounts[0].is_amount !== undefined &&\n
                    discounts[0].is_amount !== null\n
                ) {\n
                    this.is_amount = discounts[0].is_amount;\n
                }\n
\n
                this.total_global_discount = this.is_amount\n
                    ? discounts[0].amount\n
                    : discounts[0].factor * 100;\n
            }\n
\n
            return discounts;\n
        },\n
        async prepareDataCustomer() {\n
            const customer = _.find(this.customers, {\n
                id: this.form.customer_id\n
            });\n
\n
            this.customer_addresses = this.buildCustomerAddresses(customer);\n
            this.form.customer_address_id = this.form.customer\n
                ? this.form.customer.address_id\n
                : null;\n
\n
            if (!this.form.customer_address_id && this.customer_addresses.length > 0) {\n
                this.selectDefaultCustomerAddress();\n
            }\n
        },\n
\n
        // ######## INICIO CLASIFICACION DE COBROS Y CAJA ########\n
        updateChangeDestinationSale() {\n
            if (this.form.payment_condition_id === '01') this.changeDestinationSale();\n
        },\n
        // ######## FIN CLASIFICACION DE COBROS Y CAJA ########\n
        onPrepareAdditionalInformation(data) {\n
            let obs = null;\n
            if (Array.isArray(data)) {\n
                if (data.length > 0) {\n
                    if (data[0] == "") {\n
                        return obs;\n
                    }\n
                }\n
                return data.join("|");\n
            }\n
\n
            return data;\n
        },\n
        onPrepareItems(items) {\n
            return items.map(i => {\n
                if (this.table) {\n
                    i.unit_price_value = i.unit_value;\n
                    i.input_unit_price_value = i.item.has_igv\n
                        ? i.item.unit_price\n
                        : i.unit_value;\n
                } else {\n
                    i.unit_price_value = i.unit_value;\n
                    i.input_unit_price_value = i.item.has_igv\n
                        ? i.unit_price\n
                        : i.unit_value;\n
                }\n
\n
                i.discounts = i.discounts ? Object.values(i.discounts) : [];\n
                // i.discounts = i.discounts || [];\n
                i.charges = i.charges || [];\n
                i.attributes = i.attributes || [];\n
                i.item.id = i.item_id;\n
                i.additional_information = this.onPrepareAdditionalInformation(\n
                    i.additional_information\n
                );\n
                i.item = this.onPrepareIndividualItem(i);\n
\n
                // Si la cotización/origen ya trae lote, precargarlo; si no, queda null y se muestra "Asignar Lote"\n
                hydrateItemLots(i);\n
\n
                return i;\n
            });\n
        },\n
        onPrepareIndividualItem(data) {\n
            let new_item = data.item;\n
            let currency_type = _.find(this.currency_types, {\n
                id: this.form.currency_type_id\n
            });\n
\n
            new_item.currency_type_id = currency_type.id;\n
            new_item.currency_type_symbol = currency_type.symbol;\n
\n
            new_item.sale_affectation_igv_type_id =\n
                data.affectation_igv_type_id;\n
\n
            if (this.table) {\n
                new_item.sale_unit_price = new_item.unit_price;\n
                new_item.unit_price = new_item.unit_price;\n
            } else {\n
                new_item.sale_unit_price = data.unit_price;\n
                new_item.unit_price = data.unit_price;\n
            }\n
\n
            return new_item;\n
        },\n
        onSetSeriesId(documentType, serie) {\n
            const find = this.all_series.find(\n
                s => s.document_type_id == documentType && s.number == serie\n
            );\n
            if (find) {\n
                return find.id;\n
            }\n
            return null;\n
        },\n
        onSetSeries(documentType, serie) {\n
            // console.log('onSetSeries')\n
            const find = this.all_series.find(\n
                s => s.document_type_id == documentType && s.number == serie\n
            );\n
            if (find) {\n
                return [find];\n
            }\n
            return [];\n
        },\n
        getPrepayment(index) {\n
            return _.find(this.prepayment_documents, {\n
                id: this.form.prepayments[index].document_id\n
            });\n
        },\n
        inputAmountPrepayment(index) {\n
            let prepayment = this.getPrepayment(index);\n
\n
            if (\n
                exactAmount(this.form.prepayments[index].amount).compare(prepayment.amount) > 0\n
            ) {\n
                this.form.prepayments[index].amount = prepayment.amount;\n
                this.$message.error(\n
                    "El monto debe ser menor o igual al del anticipo"\n
                );\n
            }\n
\n
            this.form.prepayments[index].total = this.form.affectation_type_prepayment == 10\n
                ? exactAmount(this.form.prepayments[index].amount).times(exactAmount(1).plus(this.percentage_igv)).decimal()\n
                : String(this.form.prepayments[index].amount);\n
\n
            this.changeTotalPrepayment();\n
        },\n
        // ######## INICIO CLASIFICACION DE COBROS Y CAJA ########\n
        changeDestinationSale() {\n
            if (!this.config.destination_sale) return;\n
            proposeCashDestination(this.payment_destinations || [], this.payment_method_types || [],\n
                (this.form.payments || [])[0], this.form.currency_type_id);\n
        },\n
        // ######## FIN CLASIFICACION DE COBROS Y CAJA ########\n
        changePaymentDestination(index) {\n
            // if(this.form.payments[index].payment_method_type_id=='01'){\n
            //     this.payment_destinations = this.cash\n
            // }else{\n
            //     this.payment_destinations = this.payment_destinations\n
            // }\n
        },\n
        changeEnabledPayments() {\n
            // this.clickAddPayment()\n
            // this.form.date_of_due = this.form.date_of_issue\n
            // this.readonly_date_of_due = false\n
            // this.form.payment_method_type_id = null\n
        },\n
        changePaymentMethodType(index, isFee = false) {\n
            if (!isFee) return;\n
            const row = (isFee ? this.form.fee : this.form.payments)[index];\n
            const id = row?.payment_method_type_id;\n
            let payment_method_type = _.find(this.payment_method_types, {\n
                id: id\n
            });\n
\n
            if (!payment_method_type) return;\n
            if (payment_method_type.collection_kind === 'credit' && Number(payment_method_type.number_days) > 0) {\n
                this.form.date_of_due = moment(this.form.date_of_issue)\n
                    .add(payment_method_type.number_days, "days")\n
                    .format("YYYY-MM-DD");\n
                // this.form.payments = []\n
                this.enabled_payments = true;\n
                this.readonly_date_of_due = true;\n
                this.form.payment_method_type_id = payment_method_type.id;\n
\n
                let date = moment(this.form.date_of_issue)\n
                    .add(payment_method_type.number_days, "days")\n
                    .format("YYYY-MM-DD");\n
\n
                // let date = moment()\n
                //     .add(payment_method_type.number_days, 'days')\n
                //     .format('YYYY-MM-DD')\n
\n
                row.date = date;\n
            } else if (\n
                payment_method_type.collection_kind === 'credit'\n
            ) {\n
                this.form.payment_method_type_id = payment_method_type.id;\n
                this.form.date_of_due = this.form.date_of_issue;\n
                // this.form.payments = []\n
                this.enabled_payments = true;\n
            } else {\n
                this.form.date_of_due = this.form.date_of_issue;\n
                this.readonly_date_of_due = false;\n
                this.form.payment_method_type_id = null;\n
                this.enabled_payments = true;\n
            }\n
        },\n
        selectDocumentType() {\n
            // ########## INICIO CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
            if (this.isNrus) {\n
                this.form.document_type_id = null;\n
                return;\n
            }\n
            this.form.document_type_id = "01";\n
            // ######### FIN CAMBIO SOLO FACTURAS Y NOTAS DE VENTA\n
        },\n
        keyupCustomer() {\n
            if (this.input_person.number) {\n
                if (!isNaN(parseInt(this.input_person.number))) {\n
                    switch (this.input_person.number.length) {\n
                        case 8:\n
                            this.input_person.identity_document_type_id = "1";\n
                            this.showDialogNewPerson = true;\n
                            break;\n
\n
                        case 11:\n
                            this.input_person.identity_document_type_id = "6";\n
                            this.showDialogNewPerson = true;\n
                            break;\n
                        default:\n
                            this.input_person.identity_document_type_id = "6";\n
                            this.showDialogNewPerson = true;\n
                            break;\n
                    }\n
                }\n
            }\n
        },\n
        clickAddItemInvoice() {\n
            this.recordItem = null;\n
            this.showDialogAddItem = true;\n
        },\n
        // ######## INICIO CALCULOS EXACTOS PRO9 ########\n
        getFormatUnitPriceRow(unit_price, row) {\n
            const price = exactAmount(unit_price || '0');\n
            if (this.form.currency_type_id === row.item.currency_type_id) return price.decimal();\n
            return (this.form.currency_type_id === 'USD' ? price.dividedBy(this.form.exchange_rate_sale) : price.times(this.form.exchange_rate_sale)).decimal();\n
        },\n
        discountGlobalPrepayment() {\n
            const amount = exactSum(this.form.prepayments.map(row => row.amount || '0'));\n
            this.form.total_prepayment = exactSum(this.form.prepayments.map(row => row.total || '0')).decimal();\n
            const taxed = String(this.form.affectation_type_prepayment) === '10';\n
            const type = taxed ? '04' : '05';\n
            this.form.discounts = this.form.discounts.filter(row => !['04','05'].includes(row.discount_type_id));\n
            const base = exactSum(this.form.items.filter(row => row.affectation_igv_type_id === (taxed ? '10' : '20')).map(row => exactValue(row, 'total_base_igv')));\n
            if (amount.compare(0) > 0 && base.compare(0) > 0) this.form.discounts.push({discount_type_id: type,\n
                description: 'Descuento por anticipos', amount: amount.decimal(), amount_exact: amount.fraction(),\n
                base: base.decimal(), factor: amount.dividedBy(base).decimal(), is_amount: true});\n
        },\n
        // ######## FIN CALCULOS EXACTOS PRO9 ########\n
        async changeDocumentPrepayment(index) {\n
            let prepayment = await _.find(this.prepayment_documents, {\n
                id: this.form.prepayments[index].document_id\n
            });\n
\n
            this.form.prepayments[index].number = prepayment.description;\n
            this.form.prepayments[index].document_type_id =\n
                prepayment.document_type_id;\n
            this.form.prepayments[index].amount = prepayment.amount;\n
            this.form.prepayments[index].total = prepayment.total;\n
\n
            await this.changeTotalPrepayment();\n
        },\n
        clickAddPrepayment() {\n
            this.form.prepayments.push({\n
                document_id: null,\n
                number: null,\n
                document_type_id: null,\n
                amount: 0,\n
                total: 0\n
            });\n
\n
            this.changeTotalPrepayment();\n
        },\n
        clickRemovePrepayment(index) {\n
            this.form.prepayments.splice(index, 1);\n
            this.changeTotalPrepayment();\n
            if (this.form.prepayments.length == 0)\n
                this.deletePrepaymentDiscount();\n
        },\n
        async changePrepaymentDeduction() {\n
            this.form.prepayments = [];\n
            this.form.total_prepayment = 0;\n
            await this.deletePrepaymentDiscount();\n
\n
            if (this.prepayment_deduction) {\n
                await this.initialValueATPrepayment();\n
                await this.changeTotalPrepayment();\n
                await this.getDocumentsPrepayment();\n
            } else {\n
                // this.form.total_prepayment = 0\n
                // await this.deletePrepaymentDiscount()\n
                this.cleanValueATPrepayment();\n
            }\n
        },\n
        setPendingAmount() {\n
            this.form.pending_amount_prepayment = this.form.has_prepayment\n
                ? this.form.total\n
                : 0;\n
        },\n
        initialValueATPrepayment() {\n
            this.form.affectation_type_prepayment = !this.form\n
                .affectation_type_prepayment\n
                ? 10\n
                : this.form.affectation_type_prepayment;\n
        },\n
        cleanValueATPrepayment() {\n
            this.form.affectation_type_prepayment = null;\n
        },\n
        changeHasPrepayment() {\n
            if (this.form.has_prepayment) {\n
                this.initialValueATPrepayment();\n
            } else {\n
                this.cleanValueATPrepayment();\n
            }\n
\n
            this.setPendingAmount();\n
        },\n
        async changeAffectationTypePrepayment() {\n
            await this.initialValueATPrepayment();\n
\n
            if (this.prepayment_deduction) {\n
                this.form.total_prepayment = 0;\n
                await this.deletePrepaymentDiscount();\n
                await this.changePrepaymentDeduction();\n
            }\n
        },\n
        async deletePrepaymentDiscount() {\n
            let discount = await _.find(this.form.discounts, {\n
                discount_type_id: "04"\n
            });\n
            let discount_exonerated = await _.find(this.form.discounts, {\n
                discount_type_id: "05"\n
            });\n
            let discount_unaffected = await _.find(this.form.discounts, {\n
                discount_type_id: "06"\n
            });\n
\n
            let pos = this.form.discounts.indexOf(discount);\n
            if (pos > -1) {\n
                this.form.discounts.splice(pos, 1);\n
                this.changeTotalPrepayment();\n
            }\n
\n
            let pos_exonerated = this.form.discounts.indexOf(\n
                discount_exonerated\n
            );\n
            if (pos_exonerated > -1) {\n
                this.form.discounts.splice(pos_exonerated, 1);\n
                this.changeTotalPrepayment();\n
            }\n
\n
            let pos_unaffected = this.form.discounts.indexOf(\n
                discount_unaffected\n
            );\n
            if (pos_unaffected > -1) {\n
                this.form.discounts.splice(pos_unaffected, 1);\n
                this.changeTotalPrepayment();\n
            }\n
        },\n
        getDocumentsPrepayment() {\n
            this.$http\n
                .get(\n
                    `/${this.resource}/prepayments/${\n
                        this.form.affectation_type_prepayment\n
                    }`\n
                )\n
                .then(response => {\n
                    this.prepayment_documents = response.data;\n
                });\n
        },\n
        changeTotalPrepayment() {\n
            this.calculateTotal();\n
        },\n
        isActiveBussinessTurn(value) {\n
            return _.find(this.business_turns, { value: value }) ? true : false;\n
        },\n
        visibleDialogReportCustomer() {\n
            this.report_to_customer_id = this.form.customer_id;\n
            this.showDialogReportCustomer = true;\n
        },\n
        clickAddDocumentHotel() {\n
            this.showDialogFormHotel = true;\n
        },\n
        clickAddDocumentTransport() {\n
            this.showDialogFormTransport = true;\n
        },\n
        addDocumentHotel(hotel) {\n
            this.form.hotel = hotel;\n
        },\n
        addDocumentTransport(transport) {\n
            this.form.transport = transport;\n
        },\n
        changeIsReceivable() {},\n
        clickAddPayment() {\n
            const method = defaultCashForCurrency(this.payment_method_types || [], this.form.currency_type_id);\n
            const id = method?.id || null;\n
            this.form.date_of_due = moment().format("YYYY-MM-DD");\n
\n
            this.form.payments.push({\n
                id: null,\n
                document_id: null,\n
                date_of_payment: moment().format("YYYY-MM-DD"),\n
                payment_method_type_id: id,\n
                reference: null,\n
                payment_destination_id: id && this.getPaymentDestinationId() === 'cash' ? 'cash' : null,\n
                payment: 0,\n
\n
                payment_received: true,\n
                filename: null,\n
                temp_path: null,\n
                file_list: []\n
            });\n
\n
            if (!this.paymentMethodsLoaded) this.pendingDefaultPaymentRows.push(this.form.payments[this.form.payments.length - 1]);\n
            this.calculatePayments();\n
        },\n
        getPaymentDestinationId() {\n
            if (\n
                this.config.destination_sale &&\n
                this.payment_destinations.length > 0\n
            ) {\n
                let cash = _.find(this.payment_destinations, { id: "cash" });\n
\n
                return cash ? cash.id : this.payment_destinations[0].id;\n
            }\n
\n
            return null;\n
        },\n
        clickCancel(index) {\n
            if (isRecordedReceipt(this.form.payments[index])) return;\n
            this.form.payments.splice(index, 1);\n
            this.calculatePayments();\n
        },\n
        async ediItem(row, index) {\n
            row.indexi = index;\n
            this.recordItem = row;\n
            this.showDialogAddItem = true;\n
        },\n
        searchRemoteCustomers(input) {\n
            this.customerSearchTerm = input;\n
\n
            if (input.length > 0) {\n
                this.loading_search = true;\n
                let parameters = `input=${input}&document_type_id=${\n
                    this.form.document_type_id\n
                }&operation_type_id=${this.form.operation_type_id}`;\n
\n
                this.$http\n
                    .get(`/${this.resource}/search/customers?${parameters}`)\n
                    .then(response => {\n
                        this.customers = response.data.customers;\n
                        this.loading_search = false;\n
                        this.input_person.number =\n
                            this.customers.length == 0 ? input : null;\n
\n
                        /* if (this.customers.length == 0) {\n
                            this.filterCustomers()\n
                            this.input_person.number = input\n
                        } */\n
                    });\n
            } else {\n
                if (!this.shouldProtectPreloadedCustomer()) {\n
                    this.form.customer_id = null;\n
                }\n
                this.filterCustomers();\n
                this.input_person.number = null;\n
            }\n
        },\n
\n
\n
\n
        initInputPerson() {\n
            this.input_person = {\n
                number: null,\n
                identity_document_type_id: null\n
            };\n
        },\n
        resetForm() {\n
            this.activePanel = 0;\n
            this.initForm();\n
            // this.form.currency_type_id = (this.currency_types.length > 0)?this.currency_types[0].id:null\n
            this.form.establishment_id =\n
                this.establishments.length > 0\n
                    ? this.establishments[0].id\n
                    : null;\n
            this.form.document_type_id =\n
                this.document_types.length > 0\n
                    ? this.document_types[0].id\n
                    : null;\n
            this.form.operation_type_id =\n
                this.operation_types.length > 0\n
                    ? this.operation_types[0].id\n
                    : null;\n
            this.form.seller_id = this.sellers.length > 0 ? this.idUser : null;\n
            this.selectDocumentType();\n
            this.changeEstablishment();\n
            this.changeDocumentType();\n
            this.changeDateOfIssue();\n
            this.changeCurrencyType();\n
            // this.changeDestinationSale()\n
        },\n
        async changeOperationType() {\n
            await this.filterCustomers();\n
            this.calculateAmountToPayments();\n
            if(this.form.operation_type_id !== "0101") {\n
                this.form.is_itinerant = false;\n
            }\n
        },\n
        // },\n
        calculateAmountToPayments() {\n
            // if(this.form.payments.length > 0){\n
            //     // this.form.payments[0].payment = this.form.total_pending_payment\n
            // }\n
            this.calculatePayments();\n
            this.calculateFee();\n
        },\n
        changeEstablishment() {\n
            this.establishment = _.find(this.establishments, {\n
                id: this.form.establishment_id\n
            });\n
            this.filterSeries();\n
            this.selectDefaultCustomer();\n
        },\n
        async selectDefaultCustomer() {\n
            if (this.shouldProtectPreloadedCustomer()) {\n
                this.ensurePreloadedCustomerInList();\n
                return;\n
            }\n
\n
            if (this.establishment.customer_id) {\n
                let temp_all_customers = this.all_customers;\n
                let temp_customers = this.customers;\n
                await this.$http\n
                    .get(\n
                        `/${this.resource}/search/customer/${\n
                            this.establishment.customer_id\n
                        }`\n
                    )\n
                    .then(response => {\n
                        let data_customer = response.data.customers;\n
                        temp_all_customers = temp_all_customers.push(\n
                            ...data_customer\n
                        );\n
                        temp_customers = temp_customers.push(...data_customer);\n
                    });\n
                temp_all_customers = this.all_customers.filter(\n
                    (item, index, self) =>\n
                        index === self.findIndex(t => t.id === item.id)\n
                );\n
                temp_customers = this.customers.filter(\n
                    (item, index, self) =>\n
                        index === self.findIndex(t => t.id === item.id)\n
                );\n
                this.all_customers = temp_all_customers;\n
                this.customers = temp_customers;\n
                await this.filterCustomers();\n
                // this.form.customer_id = (this.customers.length > 0) ? this.establishment.customer_id : null\n
                let alt = _.find(this.customers, {\n
                    id: this.establishment.customer_id\n
                });\n
                // console.log(alt)\n
\n
                if (alt !== undefined) {\n
                    this.form.customer_id = this.establishment.customer_id;\n
\n
                    let seller = this.sellers.find(\n
                        element => element.id == alt.seller_id\n
                    );\n
                    if (seller !== undefined) {\n
                        this.form.seller_id = seller.id;\n
                    }\n
\n
                    this.setCustomerAccumulatedPoints(\n
                        alt.id,\n
                        this.config.enabled_point_system\n
                    );\n
                }\n
            }\n
        },\n
        changeDocumentType() {\n
            this.validateDateOfIssue();\n
            this.filterSeries();\n
            if (!this.shouldProtectPreloadedCustomer()) {\n
                this.cleanCustomer();\n
            }\n
            this.filterCustomers();\n
            this.setDefaultSerieByDocument();\n
        },\n
        shouldProtectPreloadedCustomer() {\n
            return Boolean(this.preloadedCustomerId);\n
        },\n
        ensurePreloadedCustomerInList() {\n
            if (!this.shouldProtectPreloadedCustomer()) {\n
                return;\n
            }\n
\n
            const customerId = this.preloadedCustomerId;\n
            const existingCustomer =\n
                this.preloadedCustomer ||\n
                _.find(this.customers, { id: customerId }) ||\n
                _.find(this.all_customers, { id: customerId });\n
\n
            if (!existingCustomer) {\n
                return;\n
            }\n
\n
            if (!_.find(this.all_customers, { id: customerId })) {\n
                this.all_customers.push(existingCustomer);\n
            }\n
\n
            if (!_.find(this.customers, { id: customerId })) {\n
                this.customers.push(existingCustomer);\n
            }\n
\n
            this.form.customer_id = customerId;\n
        },\n
        cleanCustomer() {\n
            if (this.shouldProtectPreloadedCustomer()) {\n
                return;\n
            }\n
\n
            this.form.customer_id = null;\n
        },\n
        setDefaultSerieByDocument() {\n
            if (!this.authUser || !this.authUser.multiple_default_document_types)\n
                return;\n
\n
            const default_document_type_serie = _.find(\n
                this.authUser.default_document_types,\n
                { document_type_id: this.form.document_type_id }\n
            );\n
\n
            if (!default_document_type_serie || !Array.isArray(this.series))\n
                return;\n
\n
            const exist_serie = _.find(this.series, {\n
                id: default_document_type_serie.series_id\n
            });\n
\n
            if (exist_serie) {\n
                this.form.series_id = default_document_type_serie.series_id;\n
            }\n
        },\n
        dateValidError() {\n
            this.$message.error(\n
                `No puede seleccionar una fecha menor a ${\n
                    this.configuration.shipping_time_days\n
                } día(s).`\n
            );\n
            // this.$message.error('No puede seleccionar una fecha menor a 6 días.');\n
            this.dateValid = false;\n
        },\n
        validateDateOfIssue() {\n
            let minDate = moment().subtract(\n
                this.configuration.shipping_time_days,\n
                "days"\n
            );\n
            // let minDate = moment().subtract(7, 'days')\n
\n
            // validar fecha de factura sin considerar configuracion\n
            if (\n
                moment(this.form.date_of_issue) < minDate &&\n
                this.form.document_type_id === "01"\n
            ) {\n
                this.dateValidError();\n
            } else if (\n
                moment(this.form.date_of_issue) < minDate &&\n
                this.config.restrict_receipt_date\n
            ) {\n
                this.dateValidError();\n
            } else {\n
                this.dateValid = true;\n
            }\n
        },\n
        async changeDateOfIssue() {\n
            this.validateDateOfIssue();\n
\n
            if (!this.form.quotation_id && !this.isUpdateDocument) {\n
                this.form.date_of_due = this.form.date_of_issue;\n
            }\n
            if (!this.isUpdateDocument) {\n
                // ######## INICIO MONEDA DEL MEDIO DE COBRO ########\n
                const request = documentRateRequest(this);\n
                await this.searchExchangeRateByDate(request.date).then(response => {\n
                    if (mayApplyDocumentRate(this, request) && !this.isUpdateDocument) {\n
                        this.form.exchange_rate_sale = response;\n
                    }\n
                });\n
                // ######## FIN MONEDA DEL MEDIO DE COBRO ########\n
            }\n
            await this.getPercentageIgv();\n
            // this.changeCurrencyType(); //\n
            // }\n
        },\n
        assignmentDateOfPayment() {\n
            this.form.payments.forEach(payment => {\n
                payment.date_of_payment = this.form.date_of_issue;\n
            });\n
        },\n
        filterSeries(preserveSeriesId = null) {\n
            // console.log('filterSeries');\n
            if (!preserveSeriesId) {\n
                this.form.series_id = null;\n
            }\n
            let series = this.all_series.filter(s =>\n
                Number(s.establishment_id) === Number(this.form.establishment_id) &&\n
                String(s.document_type_id) === String(this.form.document_type_id) &&\n
                Boolean(s.contingency) === Boolean(this.is_contingency)\n
            );\n
            if (\n
                this.form.document_type_id === this.config.user.document_id &&\n
                this.typeUser == "seller"\n
            ) {\n
                // Se filtra si el documento es el mismo que el establecido para el usuario.\n
                series = series.filter(s => Number(s.id) === Number(this.config.user.serie));\n
            }\n
\n
            //console.log(series);\n
\n
            this.$store.commit("setSeries", series);\n
            if (preserveSeriesId) {\n
                this.form.series_id = preserveSeriesId;\n
            } else {\n
                this.form.series_id =\n
                    this.series.length > 0 ? this.series[0].id : null;\n
            }\n
        },\n
        async filterCustomers() {\n
            // ######## INICIO POLITICA IDENTIDAD ACTIVA EN VENTAS ########\n
            if (this.isExportInvoice) {\n
                const operation = this.form.operation_type_id;\n
                const response = await this.$http.get(`/${this.resource}/search/customers`, {params: {input: '', document_type_id: '01', operation_type_id: operation}});\n
                if (this.form.operation_type_id !== operation) return;\n
                this.customers = response.data.customers;\n
            } else {\n
                this.customers = this.all_customers.filter(customer => customer.identity_document_type_id !== 'ND');\n
            }\n
            // ######## FIN POLITICA IDENTIDAD ACTIVA EN VENTAS ########\n
\n
            this.ensurePreloadedCustomerInList();\n
        },\n
        clickAddInitGuides() {\n
            this.form.guides.push(\n
                {\n
                    document_type_id: "09",\n
                    number: null\n
                }\n
            );\n
        },\n
        clickAddGuide() {\n
            this.form.guides.push({\n
                document_type_id: null,\n
                number: null\n
            });\n
        },\n
        clickRemoveGuide(index) {\n
            this.form.guides.splice(index, 1);\n
        },\n
        async addRow(row) {\n
            let enable_barcode_quick_sale = false;\n
            if (\n
                this.$refs.item_search_quick_sale &&\n
                this.$refs.item_search_quick_sale.search_item_by_barcode\n
            ) {\n
                enable_barcode_quick_sale = this.$refs.item_search_quick_sale\n
                    .search_item_by_barcode;\n
            }\n
            let enable_search_on_enter = false;\n
            if (\n
                this.$refs.item_search_quick_sale &&\n
                this.$refs.item_search_quick_sale.searchOnEnter\n
            ) {\n
                enable_search_on_enter = this.$refs.item_search_quick_sale\n
                    .searchOnEnter;\n
            }\n
            // console.log('enable_barcode', this.$refs.item_search_quick_sale.search_item_by_barcode);\n
            if (this.recordItem) {\n
                //this.form.items.$set(this.recordItem.indexi, row)\n
                this.form.items[this.recordItem.indexi] = row;\n
                this.recordItem = null;\n
\n
                if (this.config.enabled_point_system) {\n
                    this.setTotalExchangePoints();\n
                    this.recalculateUsedPointsForExchange(row);\n
                }\n
            } else if (this.shouldUnifyAmountItems(row)) {\n
                const index = this.getUnifiedItemIndex(row);\n
\n
                if (index !== -1) {\n
                    const newItem = JSON.parse(\n
                        JSON.stringify(this.form.items[index])\n
                    );\n
\n
                    newItem.quantity =\n
                        exactAmount(newItem.quantity).plus(row.quantity).decimal();\n
\n
                    const unifiedRow = await calculateRowItem(\n
                        newItem,\n
                        this.form.currency_type_id,\n
                        this.form.exchange_rate_sale,\n
                        this.percentage_igv, this.isExportInvoice\n
                    );\n
\n
                    this.form.items[index] = unifiedRow;\n
                } else {\n
                    this.form.items.push(JSON.parse(JSON.stringify(row)));\n
                }\n
            } else if (enable_barcode_quick_sale || enable_search_on_enter) {\n
                let index = canMergeRowQuantity(row) ? this.getUnifiedItemIndex(row) : -1;\n
                if (index !== -1) {\n
                    let newItem = JSON.parse(JSON.stringify(this.form.items[index]));\n
                    newItem.quantity = exactAmount(newItem.quantity).plus(row.quantity).decimal();\n
                    let newRow = await calculateRowItem(\n
                        newItem,\n
                        this.form.currency_type_id,\n
                        this.form.exchange_rate_sale,\n
                        this.percentage_igv, this.isExportInvoice\n
                    );\n
                    this.form.items[index] = newRow;\n
                } else {\n
                    this.form.items.push(JSON.parse(JSON.stringify(row)));\n
                }\n
            } else {\n
                this.form.items.push(JSON.parse(JSON.stringify(row)));\n
            }\n
\n
            await this.calculateTotal();\n
        },\n
        shouldUnifyAmountItems(row) {\n
            return (\n
                this.config &&\n
                this.config.show_unify_amount_items &&\n
                canMergeRowQuantity(row) &&\n
                row.item &&\n
                !row.item.series_enabled &&\n
                !row.item.lots_enabled\n
            );\n
        },\n
        getUnifiedItemIndex(row) {\n
            const presentationId = _.get(row, "item.presentation.id", null);\n
\n
            return this.form.items.findIndex(item => {\n
                const itemPresentationId = _.get(\n
                    item,\n
                    "item.presentation.id",\n
                    null\n
                );\n
\n
                return (\n
                    canMergeRowQuantity(item) &&\n
                    canMergeRowPrice(item, row) &&\n
                    String(item.item_id) === String(row.item_id) &&\n
                    String(itemPresentationId || "") ===\n
                        String(presentationId || "") &&\n
                    String(item.affectation_igv_type_id || "") ===\n
                        String(row.affectation_igv_type_id || "") &&\n
                    String(item.unit_price || "") ===\n
                        String(row.unit_price || "") &&\n
                    String(item.warehouse_id || "") ===\n
                        String(row.warehouse_id || "")\n
                );\n
            });\n
        },\n
        clickRemoveItem(index) {\n
            this.form.items.splice(index, 1);\n
            this.calculateTotal();\n
\n
            if (this.config.enabled_point_system) this.setTotalExchangePoints();\n
        },\n
        changeCurrencyType() {\n
            this.currency_type = _.find(this.currency_types, {\n
                id: this.form.currency_type_id\n
            });\n
            let items = [];\n
            this.form.items.forEach(row => {\n
                items.push(\n
                    calculateRowItem(\n
                        row,\n
                        this.form.currency_type_id,\n
                        this.form.exchange_rate_sale,\n
                        this.percentage_igv, this.isExportInvoice\n
                    )\n
                );\n
            });\n
            this.form.items = items;\n
\n
            if (this.form.currency_type_id === 'VES') {\n
                this.total_global_discount = exactAmount(this.total_global_discount).times(exactAmount(this.form.exchange_rate_sale)).final(2)\n
            } else {\n
                this.total_global_discount = exactAmount(this.total_global_discount).dividedBy(exactAmount(this.form.exchange_rate_sale)).final(2)\n
            }\n
            this.calculateTotal();\n
        },\n
        // ######## INICIO CALCULOS EXACTOS PRO9 ########\n
        calculateTotal() {\n
            if (this.enabled_discount_global) this.clearGlobalDistributionDiscounts();\n
            Object.assign(this.form, documentTotals(this.form.items, this.form.discounts, this.form.charges, this.form.total_prepayment));\n
            this.subtotal_before_global_discount = this.form.total;\n
            this.total_discount_no_base = '0';\n
            if (this.enabled_discount_global || (this.isExportInvoice && this.recordDiscountsGlobal)) this.discountGlobalItems(this.form);\n
            if (this.prepayment_deduction) this.discountGlobalPrepayment();\n
            if (this.isExportInvoice) this.applyExportGlobalCharge();\n
            else this.chargeGlobal();\n
            Object.assign(this.form, documentTotals(this.form.items, this.form.discounts, this.form.charges, this.form.total_prepayment));\n
            this.setTotalDefaultPayment();\n
            this.setPendingAmount();\n
            this.calculateFee();\n
            this.setTotalPointsBySale(this.config);\n
        },\n
        // ######## FIN CALCULOS EXACTOS PRO9 ########\n
        recalculateDecimalTotalTaxed(total, igv) {\n
            return total - igv;\n
        },\n
        verifyRecalculateTotalTaxed() {\n
            const keysToCheck = [\n
\n
\n
                "total_discount",\n
                "total_exportation",\n
                "total_exonerated",\n
\n
\n
\n
            ];\n
            return !keysToCheck.some(key => this.form[key] > 0);\n
        },\n
        sumDiscountsNoBaseByItem(row) {\n
            return exactSum((row.discounts || []).filter(d=>d.discount_type_id === '01').map(d=>d.amount_exact ?? d.amount ?? '0')).decimal();\n
        },\n
        setTotalDefaultPayment() {\n
            // if (this.form.payments.length > 0) {\n
\n
            //     this.form.payments[0].payment = this.form.total\n
            // }\n
            this.calculatePayments();\n
        },\n
        // ######## INICIO CALCULOS EXACTOS PRO9 ########\n
        applyExportGlobalCharge() {\n
            const amount = exactAmount(this.total_global_charge || '0');\n
            const base = exactValue(documentTotals(this.form.items, this.form.discounts), 'total_value');\n
            const charges = this.form.charges.length ? this.form.charges : [{charge_type_id: '50', description: 'Cargos globales', amount: '1'}];\n
            const weights = charges.map(row => exactAmount(row.amount_exact ?? row.amount ?? '0'));\n
            const sum = exactSum(weights);\n
            this.form.charges = amount.compare(0) > 0 ? charges.map((charge, index) => {\n
                const share = amount.times(sum.compare(0) > 0 ? weights[index] : 1).dividedBy(sum.compare(0) > 0 ? sum : charges.length);\n
                return {...charge, amount: share.decimal(), amount_exact: share.fraction(), base: base.decimal(), factor: base.compare(0) > 0 ? share.dividedBy(base).decimal() : '0'};\n
            }) : [];\n
        },\n
        chargeGlobal() {\n
            const others = this.form.charges.filter(row => row.charge_type_id !== '50');\n
            const base = exactValue(documentTotals(this.form.items, this.form.discounts, others, this.form.total_prepayment), 'total');\n
            const amount = this.config.active_allowance_charge ? base.times(this.config.percentage_allowance_charge || '0').dividedBy(100) : exactAmount(this.total_global_charge || '0');\n
            this.total_global_charge = amount.decimal();\n
            this.form.charges = others;\n
            if (amount.compare(0) > 0) this.form.charges.push({charge_type_id: '50', description: 'Cargos globales que no afectan la base imponible del IVA',\n
                base: base.decimal(), amount: amount.decimal(), amount_exact: amount.fraction(), factor: base.compare(0) > 0 ? amount.dividedBy(base).decimal() : '0'});\n
        },\n
        chargeConsumptionSurcharge() {\n
            this.form.charges = this.form.charges.filter(row => row.charge_type_id !== '46');\n
            const base = exactValue(documentTotals(this.form.items, this.form.discounts, this.form.charges, this.form.total_prepayment), 'total');\n
            const amount = this.is_consumption_charge ? base.times(this.restaurant_tip_factor || '0').dividedBy(100) : exactAmount(0);\n
            this.total_consumption_charge = amount.decimal();\n
            if (amount.compare(0) > 0) this.form.charges.push({charge_type_id: '46', description: 'Recargo al consumo y/o propinas',\n
                base: base.decimal(), amount: amount.decimal(), amount_exact: amount.fraction(), factor: exactAmount(this.restaurant_tip_factor).dividedBy(100).decimal()});\n
            this.calculateTotal();\n
        },\n
        // ######## FIN CALCULOS EXACTOS PRO9 ########\n
        deleteChargeGlobal() {\n
            let charge = _.find(this.form.charges, { charge_type_id: "50" });\n
            let index = this.form.charges.indexOf(charge);\n
\n
            if (index > -1) {\n
                this.form.charges.splice(index, 1);\n
                this.form.total_charge = 0;\n
            }\n
        },\n
        changeTypeDiscount() {\n
            this.calculateTotal();\n
        },\n
        changeTotalGlobalDiscount() {\n
            this.calculateTotal();\n
        },\n
        deleteDiscountGlobal() {\n
            let discount = _.find(this.form.discounts, {\n
                discount_type_id: this.isExportInvoice && this.recordDiscountsGlobal ? this.recordDiscountsGlobal.discount_type_id : this.configuration.global_discount_type_id\n
            });\n
            // let discount = _.find(this.form.discounts, {'discount_type_id': '03'})\n
            let index = this.form.discounts.indexOf(discount);\n
\n
            if (index > -1) {\n
                this.form.discounts.splice(index, 1);\n
                if (this.form.total_discount_item > 0 ) {\n
                    this.form.total_discount = this.form.total_discount_item;\n
\n
                } else {\n
                    this.form.total_discount = 0;\n
                }\n
            }\n
        },\n
        setConfigGlobalDiscountType() {\n
            this.global_discount_type = _.find(this.global_discount_types, {\n
                id: this.configuration.global_discount_type_id\n
            });\n
        },\n
        setGlobalDiscount(factor, amount, base, amount_without_rounded) {\n
            this.form.discounts.push({\n
                discount_type_id: this.recordDiscountsGlobal ? this.recordDiscountsGlobal.discount_type_id : this.global_discount_type.id,\n
                description: this.recordDiscountsGlobal ? this.recordDiscountsGlobal.description : this.global_discount_type.description,\n
                factor: factor,\n
                amount: amount,\n
                base: base,\n
                is_amount: this.is_amount,\n
                amount_without_rounded: amount_without_rounded,\n
                amount_exact: exactAmount(amount_without_rounded ?? amount).fraction()\n
            });\n
        },\n
        //Parametro ctx, mantiene los valores sin redondeo\n
        clearGlobalDistributionDiscounts() {\n
            this.form.items.forEach((item, index) => {\n
                if (!item.discounts || item.discounts.length === 0) {\n
                    if (item._original_before_global_discount) {\n
                        this.restoreItemFromGlobalDiscountSnapshot(item);\n
                    }\n
                    return;\n
                }\n
\n
                const beforeLen = item.discounts.length;\n
                item.discounts = item.discounts.filter(\n
                    d => !d.from_global_distribution\n
                );\n
\n
                const removed = beforeLen !== item.discounts.length;\n
                if (!removed && !item._original_before_global_discount) return;\n
\n
                if (item._original_before_global_discount) {\n
                    // El snapshot ya refleja descuentos de ítem previos al global\n
                    this.restoreItemFromGlobalDiscountSnapshot(item);\n
                } else if (removed) {\n
                    this.form.items.splice(\n
                        index,\n
                        1,\n
                        calculateRowItem(\n
                            item,\n
                            this.form.currency_type_id,\n
                            this.form.exchange_rate_sale,\n
                            this.percentage_igv, this.isExportInvoice\n
                        )\n
                    );\n
                }\n
            });\n
        },\n
        restoreItemFromGlobalDiscountSnapshot(item) {\n
            const original = item._original_before_global_discount;\n
            if (!original) return;\n
            Object.assign(item, original);\n
            delete item._original_before_global_discount;\n
        },\n
        /**\n
         * Afectaciones que participan del descuento global.\n
         *\n
         * Quedan fuera las gratuitas (11-16 bonificaciones, 21 exonerada\n
         * gratuita, 37 inafecta gratuita): su valor es referencial, no integra\n
         * el total a pagar y SUNAT no admite descuento sobre ellas. Si se\n
         * incluyeran, absorberian parte del descuento y este se perderia:\n
         * la suma de descuentos por linea no cuadraria con el descuento global.\n
         */\n
        isDiscountableAffectation(item) {\n
            return [\n
                "10", // Gravada - Operacion Onerosa\n
                "20", // Exonerada - Operacion Onerosa\n
                "30", // Inafecta - Operacion Onerosa\n
                "31", // Inafecta - Retiro por Bonificacion\n
                "32", // Inafecta - Retiro\n
                "33", // Inafecta - Retiro por Muestras Medicas\n
                "34", // Inafecta - Retiro por Convenio Colectivo\n
                "35", // Inafecta - Retiro por Premio\n
                "36", // Inafecta - Retiro por Publicidad\n
                "EXP"  // Exportacion\n
            ].includes(item.affectation_igv_type_id);\n
        },\n
        /**\n
         * Valor de la linea sobre el que se calcula un descuento.\n
         */\n
        itemValueForDiscount(item) { return exactValue(item, 'total_value').decimal(); },\n
        itemDiscountDisplayAmount(item, predicate) {\n
            const multiplier = item.affectation_igv_type_id === '10' ? exactAmount(1).plus(this.percentage_igv) : exactAmount(1);\n
            return exactSum((item.discounts || []).filter(discount => !predicate || predicate(discount)).map(discount => {\n
                const amount = exactAmount(discount.amount_exact ?? discount.amount_without_rounded ?? discount.amount ?? '0');\n
                return this.isBaseDiscount(discount) ? amount.times(multiplier) : amount;\n
            })).decimal();\n
        },\n
        isBaseDiscount(discount) {\n
            if (discount.discount_type) return !!discount.discount_type.base;\n
\n
            return discount.discount_type_id === "00";\n
        },\n
        /**\n
         * Reparte `target` entre los descuentos propios de UNA linea: los escala\n
         * a todos por el mismo factor, o crea uno si la linea no tenia ninguno.\n
         *\n
         * El prorrateo del descuento global queda intacto: no entra en la suma\n
         * ni se escala, porque lo regenera calculateTotal en cada recalculo.\n
         */\n
        spreadItemDiscount(item, target) {\n
            item.discounts = item.discounts || [];\n
            target = exactAmount(target);\n
            const own = discount => !discount.from_global_distribution;\n
            const current = exactAmount(this.itemDiscountDisplayAmount(item, own));\n
            if (target.compare(0) <= 0) { item.discounts = item.discounts.filter(discount => !own(discount)); return; }\n
            if (current.compare(0) > 0) {\n
                const factor = target.dividedBy(current);\n
                item.discounts.forEach(discount => {\n
                    if (!own(discount)) return;\n
                    const amount = exactAmount(discount.amount_exact ?? discount.amount_without_rounded ?? discount.amount).times(factor);\n
                    Object.assign(discount, {amount: amount.decimal(), amount_exact: amount.fraction(), amount_without_rounded: amount.decimal(), is_amount: true, use_input_amount: true});\n
                });\n
                return;\n
            }\n
            const base = exactValue(item, 'total_value');\n
            if (base.compare(0) <= 0) return;\n
            const amount = item.affectation_igv_type_id === '10' ? target.dividedBy(exactAmount(1).plus(this.percentage_igv)) : target;\n
            item.discounts.push({discount_type_id: '00', discount_type: _.find(this.discount_types, {id: '00'}), description: 'Descuento',\n
                percentage: '0', factor: '0', amount: amount.decimal(), amount_exact: amount.fraction(), amount_without_rounded: amount.decimal(), base: base.decimal(), is_amount: true, use_input_amount: true});\n
        },\n
        recalculateDiscountedItems(indexes) {\n
            indexes.forEach(index => {\n
                const item = this.form.items[index];\n
                if (!item) return;\n
\n
                const row = calculateRowItem(\n
                    item,\n
                    this.form.currency_type_id,\n
                    this.form.exchange_rate_sale,\n
                    this.percentage_igv, this.isExportInvoice\n
                );\n
\n
                // Object.assign conserva los campos propios de la fila que\n
                this.form.items.splice(index, 1, Object.assign({}, item, row));\n
            });\n
        },\n
        /**\n
         * hasRowAdvancedOption bloquea la fila cuando ya tiene descuentos, asi\n
         * que en la celda de descuento dejaria el input inutilizable apenas se\n
         * pone el primero. Aqui solo bloquean cargos e ISC, que si tienen\n
         * calculo propio y no se llevan con el escalado de descuentos.\n
         */\n
        isRowDiscountLocked(row) {\n
            const has_charges =\n
                row.charges &&\n
                Array.isArray(row.charges) &&\n
                row.charges.length > 0;\n
\n
            return !!(has_charges || (row.item && 0));\n
        },\n
        /**\n
         * Descuento vigente de una fila, redondeado, para pintar el input.\n
         */\n
        rowDiscountValue(row) { return this.itemDiscountDisplayAmount(row); },\n
        applyItemDiscount(index, value) {\n
            let item = this.form.items[index];\n
            if (!item) return;\n
            const global = exactAmount(this.itemDiscountDisplayAmount(item, discount => discount.from_global_distribution));\n
            let target = exactAmount(value || '0').minus(global);\n
            if (target.compare(0) < 0) target = exactAmount(0);\n
            const maximum = exactValue(item, 'total').plus(this.itemDiscountDisplayAmount(item, discount => !discount.from_global_distribution));\n
            if (target.compare(maximum) > 0) { target = maximum; this.$message.warning(`El descuento no puede superar ${maximum.decimal()}`); }\n
            this.clearGlobalDistributionDiscounts();\n
            item = this.form.items[index];\n
            this.spreadItemDiscount(item, target);\n
            this.recalculateDiscountedItems([index]);\n
            this.calculateTotal();\n
        },\n
        // ######## INICIO CALCULOS EXACTOS PRO9 ########\n
        discountGlobalItems(ctx) {\n
            if (this.isExportInvoice) {\n
                this.deleteDiscountGlobal();\n
                const base = this.form.items ? exactSum(this.form.items.filter(item => item.affectation_igv_type_id === 'EXP').map(item => exactValue(item, 'total_value'))) : exactValue(ctx, 'total_exportation');\n
                const amount = this.is_amount ? exactAmount(this.total_global_discount || '0') : base.times(this.total_global_discount || '0').dividedBy(100);\n
                if (amount.compare(0) < 0 || amount.compare(base) > 0) { this.$message.error('El descuento supera el valor exportado.'); return; }\n
                if (amount.compare(0) > 0 && base.compare(0) > 0) this.setGlobalDiscount(amount.dividedBy(base).decimal(), amount.decimal(), base.decimal(), amount.fraction());\n
                const total = base.minus(amount).decimal();\n
                Object.assign(this.form, {total_exportation: total, total_value: total, total, subtotal: total,\n
                    total_discount: exactAmount(this.form.total_discount || '0').plus(amount).decimal()});\n
                return;\n
            }\n
            this.clearGlobalDistributionDiscounts();\n
            if (!this.total_global_discount || exactAmount(this.total_global_discount).compare(0) <= 0) return;\n
            const selected = this.form.items.filter(item => this.isDiscountableAffectation(item));\n
            const base = exactSum(selected.map(item => exactValue(item, 'total_value')));\n
            if (base.compare(0) <= 0) return;\n
            const type = this.recordDiscountsGlobal?.discount_type_id || this.global_discount_type.id;\n
            const taxed = exactSum(selected.filter(item => item.affectation_igv_type_id === '10').map(item => exactValue(item, 'total_value')));\n
            let amount = exactAmount(this.total_global_discount);\n
            if (!this.is_amount) amount = base.times(amount).dividedBy(100);\n
            else if (type === '02' && this.configuration.exact_discount) amount = amount.dividedBy(exactAmount(1).plus(exactAmount(this.percentage_igv).times(taxed).dividedBy(base)));\n
            if (amount.compare(base) > 0) { this.$message.error('El descuento supera su base.'); return; }\n
            this.deleteDiscountGlobal();\n
            selected.forEach(item => {\n
                const share = exactValue(item, 'total_value').times(amount).dividedBy(base);\n
                const snapshot = {...item, discounts: [...(item.discounts || [])]};\n
                item.discounts = [...snapshot.discounts, {discount_type_id: type === '02' ? '00' : '01',\n
                    description: 'Descuento global', is_amount: true, use_input_amount: true,\n
                    from_global_distribution: true, amount: share.decimal(), amount_exact: share.fraction()}];\n
                Object.assign(item, calculateRowItem(item, this.form.currency_type_id, this.form.exchange_rate_sale, this.percentage_igv, this.isExportInvoice));\n
                item._original_before_global_discount = snapshot;\n
            });\n
        },\n
        // ######## FIN CALCULOS EXACTOS PRO9 ########\n
        recalcItemBasesAndIgv(item) {\n
            Object.assign(item, calculateRowItem(item, this.form.currency_type_id, this.form.exchange_rate_sale, this.percentage_igv, this.isExportInvoice));\n
            return item;\n
        },\n
        // Descuento por item (incluye prorrateo del descuento global)\n
        setTextDiscountItem(item) { return this.itemDiscountDisplayAmount(item); },\n
\n
        async deleteInitGuides() {\n
            await _.remove(this.form.guides, { number: null });\n
        },\n
        async asignPlateNumberToItems() {\n
            if (this.form.plate_number) {\n
                await this.form.items.forEach(item => {\n
                    let at = _.find(item.attributes, {\n
                        attribute_type_id: "5010"\n
                    });\n
\n
                    if (!at) {\n
                        item.attributes.push({\n
                            attribute_type_id: "5010",\n
                            description: "Numero de Placa",\n
                            value: this.form.plate_number,\n
                            start_date: null,\n
                            end_date: null,\n
                            duration: null\n
                        });\n
                    } else {\n
                        if (this.isUpdate) {\n
                            at.value = this.form.plate_number;\n
                        }\n
                    }\n
                });\n
            }\n
        },\n
        async validateAffectationTypePrepayment() {\n
            let not_equal_affectation_type = 0;\n
\n
            await this.form.items.forEach(item => {\n
                if (\n
                    item.affectation_igv_type_id !=\n
                    this.form.affectation_type_prepayment\n
                ) {\n
                    not_equal_affectation_type++;\n
                }\n
            });\n
\n
            return {\n
                success: not_equal_affectation_type > 0 ? false : true,\n
                message:\n
                    "Los items deben tener tipo de afectación igual al seleccionado en el anticipo"\n
            };\n
        },\n
        validatePaymentDestination() {\n
            let error_by_item = 0;\n
\n
            this.form.payments.forEach(item => {\n
                // ######## INICIO CLASIFICACION DE COBROS Y CAJA ########\n
                const method = (this.payment_method_types || []).find(value => String(value.id) === String(item.payment_method_type_id));\n
                const credit = method?.collection_kind === 'credit';\n
                if (!item.id && !credit && item.payment_destination_id == null) error_by_item++;\n
                // ######## FIN CLASIFICACION DE COBROS Y CAJA ########\n
            });\n
\n
            return {\n
                error_by_item: error_by_item\n
            };\n
        },\n
        documentSubmission() {\n
            const form = paymentConditionPayload(withoutDraftRetentions(this.form));\n
            return this.isUpdateDocument ? {...form, payments: [], received_retentions: [], guarantee_fund: null} : form;\n
        },\n
        async submit() {\n
            if (this.editBlocked) return this.$message.error(this.form.edit_block_reason);\n
            if (this.form.fiscal_data?.special_tax_regime_id && (!this.specialTaxRegimeAvailable || this.form.payment_condition_id !== '01')) {\n
                return this.$message.error('El régimen especial requiere una Factura de venta interna al contado.');\n
            }\n
            if (this.thirdPartyMode && (!this.form.third_party_id || !this.thirdPartyAvailable || this.form.payment_condition_id !== '01')) {\n
                return this.$message.error('Seleccione el tercero y mantenga una Factura de venta interna al contado.');\n
            }\n
            if (!this.thirdPartyMode) this.form.third_party_id = null;\n
            let customer = _.find(this.customers, {\n
                id: this.form.customer_id\n
            });\n
\n
            if (customer) {\n
\n
            }\n
\n
            // Normalizar IdLoteSelected en cada ítem antes de validar y enviar\n
            this.ensureItemsLotsForSubmit();\n
\n
            // Validando lotes (origen) — misma regla que DocumentRequest / lots_group.vue\n
            const lotsValidation = validateItemsLots(this.form.items);\n
            if (!lotsValidation.valid) {\n
                this.$message.error(lotsValidation.message);\n
                return false;\n
            }\n
\n
            //Validando las series seleccionadas\n
            let errorSeries = false;\n
            _.forEach(this.form.items, row => {\n
                if (row.item.series_enabled) {\n
                    errorSeries =\n
                        parseFloat(row.quantity) !== row.item.lots.length;\n
                    return false;\n
                }\n
            });\n
\n
            // Validar campos personalizados requeridos\n
            if (this.$refs.customFieldsRenderer) {\n
                const customFieldsValidation = this.$refs.customFieldsRenderer.validateRequiredFields()\n
                if (!customFieldsValidation.valid) {\n
                    this.$message.error('Campos personalizados incompletos: ' + customFieldsValidation.errors.join(', '))\n
                    return false\n
                }\n
            }\n
\n
            if(this.form.operation_type_id === '0101' && this.form.is_itinerant) {\n
                if (this.form.guides.length == 0 ) {\n
                    this.errors = { is_itinerant : ['Debe tener una orden de entrega vinculada al documento']}\n
                    return;\n
                }\n
\n
            }\n
            if (errorSeries) {\n
                this.$message.error("No se han seleccionado todas las series");\n
                return false;\n
            }\n
\n
            if (this.form.show_terms_condition) {\n
                this.form.terms_condition = this.config.terms_condition_sale;\n
            }\n
            if (this.form.has_prepayment || this.prepayment_deduction) {\n
                let error_prepayment = await this.validateAffectationTypePrepayment();\n
                if (!error_prepayment.success)\n
                    return this.$message.error(error_prepayment.message);\n
            }\n
\n
            if (this.isUpdateDocument || this.is_receivable) {\n
                this.form.payments = [];\n
            } else {\n
                let validate = await this.validate_payments();\n
                if (\n
                    validate.error_by_item > 0\n
                ) {\n
                    return this.$message.error(\n
                        "Los montos ingresados superan al monto a pagar o son incorrectos"\n
                    );\n
                }\n
\n
                let validate_payment_destination = await this.validatePaymentDestination();\n
\n
                if (validate_payment_destination.error_by_item > 0) {\n
                    return this.$message.error(\n
                        "El destino del pago es obligatorio"\n
                    );\n
                }\n
            }\n
\n
            await this.deleteInitGuides();\n
            await this.asignPlateNumberToItems();\n
\n
\n
\n
            // validacion sistema por puntos\n
            if (this.config.enabled_point_system) {\n
                const validate_exchange_points = this.validateExchangePoints();\n
                if (!validate_exchange_points.success)\n
                    return this.$message.error(\n
                        validate_exchange_points.message\n
                    );\n
            }\n
\n
            if (this.config.enabled_guarantee_fund) {\n
                let fund_obj = 0 || {}\n
\n
                if(parseFloat(fund_obj.guarantee_fund) > this.form.total_pending_payment) {\n
                    return this.$message.error('El fondo de garantía no puede ser mayor al monto pendiente')\n
                }\n
            }\n
\n
            // validacion sistema por puntos\n
\n
            if (this.isGeneratedFromExternal) {\n
                // validacion restriccion de productos\n
                const validate_restrict_sale_items_cpe = this.fnValidateRestrictSaleItemsCpe(\n
                    this.form\n
                );\n
                if (!validate_restrict_sale_items_cpe.success)\n
                    return this.$message.error(\n
                        validate_restrict_sale_items_cpe.message\n
                    );\n
            }\n
\n
            // Asegurar IdLoteSelected a nivel de fila e ítem antes del POST\n
            // (la UI puede resolverlo desde item.IdLoteSelected / lots_group, pero el backend lee row.IdLoteSelected)\n
            this.ensureItemsLotsForSubmit();\n
\n
            // Capturar el cliente antes del submit, ya que resetForm() limpia el customer\n
            this.customerCurrent = this.getCustomer;\n
\n
            if (!await this.ensureFiscalPaymentsReady(this.documentSubmission().payments)) return\n
\n
            this.loading_submit = true;\n
            this.is_consumption_charge = false;\n
            let path = `/${this.resource}`;\n
            if (this.isUpdate) {\n
                path = `/${this.resource}/${this.form.id}/update`;\n
            }\n
            this.$http\n
                .post(path, this.documentSubmission())\n
                .then(async (response) => {\n
                    if (response.data.success) {\n
                        this.documentNewId = response.data.data.id;\n
                        this.printTicketUrl = response.data?.links?.print_ticket ?? null;\n
\n
                        this.$eventHub.$emit("reloadDataItems", null);\n
                        this.resetForm();\n
                        this.showOptionsDialog(response);\n
\n
                        this.form_cash_document.document_id =\n
                            response.data.data.id;\n
\n
                        // this.savePaymentMethod();\n
                        if (!this.isUpdateDocument) this.saveCashDocument();\n
\n
                        this.autoPrintDocument();\n
                        await this.autoSendPdfMail();\n
                    } else {\n
                        this.$message.error(response.data.message);\n
                    }\n
                })\n
                .catch(error => {\n
                    if (error.response && error.response.status === 422) {\n
                        const data = error.response.data || {};\n
                        this.errors = data.errors || (data.message && typeof data.message === 'object' ? data.message : data);\n
                        const firstLotError = this.firstValidationError(\n
                            this.errors,\n
                            "IdLoteSelected"\n
                        );\n
                        if (this.errors.quoted_tax_amount) {\n
