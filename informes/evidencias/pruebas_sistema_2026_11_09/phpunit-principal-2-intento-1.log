    public function reStore($document_id)\n
    {\n
        $fact = DB::connection('tenant')->transaction(function () use ($document_id) {\n
            $document = Document::find($document_id);\n
\n
            $type = 'invoice';\n
            if ($document->document_type_id === '07') {\n
                $type = 'credit';\n
            }\n
            if ($document->document_type_id === '08') {\n
                $type = 'debit';\n
            }\n
\n
            $facturalo = new Facturalo();\n
            $facturalo->setDocument($document);\n
            $facturalo->setType($type);\n
            $facturalo->updateState('01');\n
            $facturalo->createPdf($document, $type, 'ticket');\n
        });\n
\n
//        $document = $fact->getDocument();\n
//        $response = $fact->getResponse();\n
\n
        return [\n
            'success' => true,\n
            'message' => 'El documento se volvio a generar.',\n
        ];\n
    }\n
