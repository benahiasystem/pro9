                ].item.original_affectation_igv_type_id;\n
                this.form.items[index].affectation_igv_type = await _.find(\n
                    this.affectation_igv_types,\n
                    { id: this.form.items[index].affectation_igv_type_id }\n
                );\n
            }\n
\n
            this.form.items[index] = await calculateRowItem(\n
                row,\n
                this.form.currency_type_id,\n
