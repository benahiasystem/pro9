    functional: true,\n
    props: {\n
        source: { type: Object, default: null },\n
        slotName: { type: String, required: true },\n
        slotScopeData: { type: Object, default: () => ({}) },\n
    },\n
    render(h, ctx) {\n
        const src = ctx.props.source;\n
        const slot = src && src.$scopedSlots ? src.$scopedSlots[ctx.props.slotName] : null;\n
        const content = typeof slot === 'function' ? slot(ctx.props.slotScopeData) : slot;\n
        return h('div', { class: 'relocated-field-slot' }, content || []);\n
    },\n
};\n
