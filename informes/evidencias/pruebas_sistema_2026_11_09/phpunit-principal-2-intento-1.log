        ...mapActions(["loadConfiguration"]),\n
        /**\n
         * Cargar opciones de precio desde la API de price_labels activos\n
         */\n
        async loadPriceOptions() {\n
            try {\n
                const response = await this.$http.get('/price-labels/active');\n
                const labels = response.data.data || [];\n
\n
\n
                const mainLabel = (this.config && this.config.price1_label) ? this.config.price1_label : 'Precio principal';\n
                this.price_options = [\n
                    {\n
                        id: 1,\n
                        description: mainLabel,\n
                        price_label_id: null\n
                    }\n
                ];\n
\n
                // Agregar las etiquetas de precio desde la API\n
                labels.forEach(label => {\n
                    this.price_options.push({\n
                        id: `price_label_${label.id}`,\n
                        description: label.label,\n
                        price_label_id: label.id\n
                    });\n
                });\n
\n
                // Seleccionar el label marcado como default, o el primero como fallback\n
                const defaultLabel = labels.find(l => l.is_default);\n
                if (defaultLabel) {\n
                    this.selected_option_price = `price_label_${defaultLabel.id}`;\n
                } else if (this.price_options.length > 0) {\n
                    this.selected_option_price = this.price_options[0].id;\n
                }\n
            } catch (error) {\n
                console.error('Error al cargar price_options:', error);\n
                // Fallback a precio principal si falla la carga\n
                this.price_options = [\n
                    {\n
                        id: 1,\n
                        description: "Precio principal",\n
                        price_label_id: null\n
                    }\n
                ];\n
                this.selected_option_price = 1;\n
            }\n
        },\n
