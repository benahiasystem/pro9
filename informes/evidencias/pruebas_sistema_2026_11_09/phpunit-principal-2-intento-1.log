        if (auth()->user()->type == 'integrator') {\n
            return redirect('/documents');\n
        }\n
        $configuration = Configuration::first();\n
        $is_contingency = 0;\n
        $isUpdate = true;\n
        return view('tenant.documents.form', compact('is_contingency', 'configuration', 'documentId', 'isUpdate'));\n
    }\n
