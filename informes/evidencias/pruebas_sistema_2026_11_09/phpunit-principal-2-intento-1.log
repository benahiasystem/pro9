    public function searchThirdParties(Request $request)\n
    {\n
        $request->validate(['input' => 'nullable|string|max:100']);\n
        if (!\App\Services\ExportInvoicePolicy::available(Company::firstOrFail())) {\n
            \App\Services\Fiscal\FiscalAmounts::error('third_party_id', 'La facturación por terceros requiere Medios digitales y DEMO.');\n
