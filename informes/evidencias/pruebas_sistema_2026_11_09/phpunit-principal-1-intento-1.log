    public function ReturnItem(&$item)\n
    {\n
        $configuration = Configuration::first();\n
        $establishment_id = auth()->user()->establishment_id;\n
        $warehouse = \Modules\Inventory\Models\Warehouse::where('establishment_id', $establishment_id)->first();\n
\n
        $item->transform(function ($row) use ($configuration, $warehouse) {\n
            /** @var \App\Models\Tenant\Item $row */\n
            return $row->getDataToItemModal($warehouse, false, true);\n
            /** Se ha movido al modelo*/\n
            $full_description = $this->getFullDescription($row);\n
            return [\n
                'id' => $row->id,\n
                'full_description' => $full_description,\n
                'description' => $row->description,\n
                'currency_type_id' => $row->currency_type_id,\n
                'model' => $row->model,\n
                'brand' => $row->brand,\n
                'currency_type_symbol' => $row->currency_type->symbol,\n
                'sale_unit_price' => $row->sale_unit_price,\n
                'purchase_unit_price' => $row->purchase_unit_price,\n
                'unit_type_id' => $row->unit_type_id,\n
                'sale_affectation_igv_type_id' => $row->sale_affectation_igv_type_id,\n
                'purchase_affectation_igv_type_id' => $row->purchase_affectation_igv_type_id,\n
                'is_set' => (bool)$row->is_set,\n
                'has_igv' => (bool)$row->has_igv,\n
                'calculate_quantity' => (bool)$row->calculate_quantity,\n
                'item_unit_types' => collect($row->item_unit_types)->transform(function ($row) {\n
                    return [\n
                        'id' => $row->id,\n
                        'description' => "{$row->description}",\n
                        'item_id' => $row->item_id,\n
                        'unit_type_id' => $row->unit_type_id,\n
                        'quantity_unit' => $row->quantity_unit,\n
                        'price1' => $row->price1,\n
                        'price2' => $row->price2,\n
                        'price3' => $row->price3,\n
                        'price_default' => $row->price_default,\n
                    ];\n
                }),\n
                'warehouses' => collect($row->warehouses)->transform(function ($row) {\n
                    return [\n
                        'warehouse_id' => $row->warehouse->id,\n
                        'warehouse_description' => $row->warehouse->description,\n
                        'stock' => $row->stock,\n
\n
