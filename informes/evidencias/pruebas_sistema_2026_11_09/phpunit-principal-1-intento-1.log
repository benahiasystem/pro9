    public function getFullDescription($row)\n
    {\n
\n
        $desc = ($row->internal_id) ? $row->internal_id . ' - ' . $row->description : $row->description;\n
        $category = ($row->category) ? " - {$row->category->name}" : "";\n
        $brand = ($row->brand) ? " - {$row->brand->name}" : "";\n
