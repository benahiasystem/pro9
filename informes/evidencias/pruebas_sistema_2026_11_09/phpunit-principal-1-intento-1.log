    public function store(QuotationRequest $request)\n
    {\n
        DB::connection('tenant')->transaction(function () use ($request) {\n
\n
            $data = $this->mergeData($request);\n
            $data['terms_condition'] = $this->getTermsCondition();\n
\n
            $this->quotation = Quotation::create($data);\n
\n
            // ######## INICIO MONEDA DEL MEDIO DE COBRO ########\n
            if ($data['items']) {\n
                \App\Support\Exact\CommercialCalculation::defer($this->quotation, function () use ($data) {\n
                    foreach ($data['items'] as $row) $this->quotation->items()->create($row);\n
                });\n
            }\n
            // ######## FIN MONEDA DEL MEDIO DE COBRO ########\n
\n
            $this->savePayments($this->quotation, $data['payments']);\n
\n
            $this->setFilename();\n
            $this->createPdf($this->quotation, "a4", $this->quotation->filename);\n
\n
        });\n
\n
        return [\n
            'success' => true,\n
            'data' => [\n
                'id' => $this->quotation->id,\n
                'number_full' => $this->quotation->number_full,\n
            ],\n
        ];\n
    }\n
\n
    public function update(QuotationRequest $request)\n
    {\n
\n
        DB::connection('tenant')->transaction(function () use ($request) {\n
            // $data = $this->mergeData($request);\n
            // return $request['id'];\n
            $configuration = Configuration::select('terms_condition')->first();\n
            $request['terms_condition'] = $this->getTermsCondition();\n
\n
            // ######## INICIO MONEDA DEL MEDIO DE COBRO ########\n
            $this->quotation = Quotation::withoutEagerLoads()->lockForUpdate()->findOrFail($request['id']);\n
            $previousCurrency = $this->quotation->currency_type_id;\n
            // ######## FIN MONEDA DEL MEDIO DE COBRO ########\n
            $this->quotation->fill($request->all());\n
            $this->quotation->customer = PersonInput::set($request['customer_id'], isset($request['customer_address_id']) ? $request['customer_address_id'] : null);\n
            $this->syncExistingPayments($this->quotation, $request['payments'], $previousCurrency, $request['items']);\n
\n
            $this->setFilename();\n
        });\n
\n
        return [\n
            'success' => true,\n
            'data' => [\n
                'id' => $this->quotation->id,\n
            ],\n
        ];\n
\n
    }\n
\n
    public function getTermsCondition()\n
    {\n
\n
        $configuration = Configuration::select('terms_condition')->first();\n
\n
        if ($configuration) {\n
            return $configuration->terms_condition;\n
        }\n
\n
        return null;\n
\n
    }\n
